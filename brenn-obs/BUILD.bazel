load("//bazel/features:defs.bzl", "TESTUTILS_FEATURES")
load("//bazel/policy:defs.bzl", "policy_srcs")
load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")

policy_srcs()

exports_files(["Cargo.toml"])

# `testutils` gates the test-only alerters downstream test targets assert
# against; the release configs clear the flag, keeping the shipped binary free
# of test scaffolding.
rust_library(
    name = "brenn-obs",
    srcs = glob(["src/**/*.rs"]),
    crate_features = TESTUTILS_FEATURES,
    edition = "2024",
    visibility = ["//visibility:public"],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True) + ["//brenn-common"],
)

# 60 tests. Several drive the rate limiter and the alert dispatcher through
# real `tokio::time` sleeps, so this is not the sub-second suite the sinks
# beside it are, but it is nowhere near the 300s `medium` default either.
#
# One test reads the deployed fail2ban filter through
# `env!("CARGO_MANIFEST_DIR")`, so the constant has to name this package and
# the file has to be a runfile. The workspace-relative form resolves from the
# runfiles root, which is where a Bazel test starts.
rust_test(
    name = "brenn-obs_test",
    size = "medium",
    crate = ":brenn-obs",
    crate_features = ["testutils"],
    data = ["//deploy/fail2ban:brenn.conf"],
    edition = "2024",
    rustc_env = {"CARGO_MANIFEST_DIR": "brenn-obs"},
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
)

rust_doc_test(
    name = "brenn-obs_doc_test",
    crate = ":brenn-obs",
)
