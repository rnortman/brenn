load("//bazel/policy:defs.bzl", "policy_srcs")
load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary")

policy_srcs()

exports_files(["Cargo.toml"])

# `build_info.rs` reads BRENN_BUILD_ID with `env!`, so the value is a compile
# input and therefore a cache key. Release lanes pass --stamp and the value
# comes from the workspace status command; unstamped builds get the literal
# below, so the dev loop never invalidates on it.
rust_binary(
    name = "brenn",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    rustc_env = {"BRENN_BUILD_ID": "{STABLE_BRENN_BUILD_ID}"},
    stamp = -1,
    visibility = ["//visibility:public"],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True) + [
        "//brenn-bootstrap",
        "//brenn-lib",
    ],
)
