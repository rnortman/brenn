"""The brenn bus attachment: attach to a brenn server's remote route, publish,
subscribe and read, and move blobs.

Every blocking call releases the GIL. On the main thread it runs the
interpreter's signal handlers at least every 100 ms, so Ctrl-C interrupts the
wait; `close` is not interrupted. Timeouts are seconds.
"""

import datetime
import os
from collections.abc import Mapping
from types import TracebackType
from typing import ClassVar, final

def attach(
    url: str,
    *,
    ident: str,
    timeout: float,
    token: str | None = None,
    token_file: str | os.PathLike[str] | None = None,
    ca_file: str | os.PathLike[str] | None = None,
) -> Client: ...
@final
class Client:
    def facts(self) -> AttachmentFacts: ...
    def status(self) -> Attached | Detached: ...
    def publish(
        self,
        channel: str,
        body: Body,
        *,
        timeout: float,
        urgency: Urgency = ...,
        attachments: Mapping[str, Blob] | None = None,
    ) -> PublishOutcome: ...
    def upload(self, data: bytes, *, content_type: str, timeout: float) -> Blob: ...
    def upload_file(
        self, path: str | os.PathLike[str], *, content_type: str, timeout: float
    ) -> Blob: ...
    def open_attachment(
        self, channel: str, message_id: str, name: str, *, timeout: float
    ) -> Blob: ...
    def read_blob(self, blob: Blob, offset: int, length: int, *, timeout: float) -> bytes: ...
    def download_blob(
        self, blob: Blob, path: str | os.PathLike[str], *, timeout: float
    ) -> None: ...
    def subscribe(
        self,
        channel: str,
        *,
        push_depth: int,
        retain_depth: int,
        timeout: float,
        cursorless: bool = False,
    ) -> Subscribed | Unavailable: ...
    def unsubscribe(self, channel: str) -> None: ...
    def recv(self, *, timeout: float | None) -> Event | None: ...
    def close(self) -> None: ...
    def __enter__(self) -> Client: ...
    def __exit__(
        self,
        exc_type: type[BaseException] | None,
        exc: BaseException | None,
        tb: TracebackType | None,
    ) -> bool: ...

@final
class Blob:
    @property
    def size(self) -> int: ...
    @property
    def content_type(self) -> str: ...
    def close(self) -> None: ...
    def __enter__(self) -> Blob: ...
    def __exit__(
        self,
        exc_type: type[BaseException] | None,
        exc: BaseException | None,
        tb: TracebackType | None,
    ) -> bool: ...

@final
class AttachmentFacts:
    __match_args__ = (
        "protocol_version",
        "participant_id",
        "session_id",
        "max_body_bytes",
        "blobs",
    )
    @property
    def protocol_version(self) -> int: ...
    @property
    def participant_id(self) -> str: ...
    @property
    def session_id(self) -> str: ...
    @property
    def max_body_bytes(self) -> int: ...
    @property
    def blobs(self) -> BlobFacts | None: ...

@final
class BlobFacts:
    __match_args__ = (
        "max_blob_bytes",
        "max_chunk_bytes",
        "max_handles",
        "max_bytes_held",
        "max_inflight_reads",
        "upload",
    )
    @property
    def max_blob_bytes(self) -> int: ...
    @property
    def max_chunk_bytes(self) -> int: ...
    @property
    def max_handles(self) -> int: ...
    @property
    def max_bytes_held(self) -> int: ...
    @property
    def max_inflight_reads(self) -> int: ...
    @property
    def upload(self) -> bool: ...

@final
class Attachment:
    __match_args__ = ("name", "size", "content_type")
    @property
    def name(self) -> str: ...
    @property
    def size(self) -> int: ...
    @property
    def content_type(self) -> str: ...

@final
class UploadRefusal:
    BLOB_TOO_LARGE: ClassVar[UploadRefusal] = ...
    BUDGET_EXHAUSTED: ClassVar[UploadRefusal] = ...
    HANDLE_LIMIT: ClassVar[UploadRefusal] = ...
    BYTES_HELD_LIMIT: ClassVar[UploadRefusal] = ...
    STORAGE_FAILED: ClassVar[UploadRefusal] = ...
    INCOMPLETE: ClassVar[UploadRefusal] = ...

@final
class OpenRefusal:
    NOT_RETAINED: ClassVar[OpenRefusal] = ...
    NO_SUCH_ATTACHMENT: ClassVar[OpenRefusal] = ...
    TOOL_CHANNEL: ClassVar[OpenRefusal] = ...
    HANDLE_LIMIT: ClassVar[OpenRefusal] = ...
    BYTES_HELD_LIMIT: ClassVar[OpenRefusal] = ...

@final
class ReadRefusal:
    OUT_OF_RANGE: ClassVar[ReadRefusal] = ...
    UNKNOWN_HANDLE: ClassVar[ReadRefusal] = ...
    NOT_SEALED: ClassVar[ReadRefusal] = ...
    TOO_MANY_READS: ClassVar[ReadRefusal] = ...
    STORAGE_FAILED: ClassVar[ReadRefusal] = ...
    CLOSED: ClassVar[ReadRefusal] = ...

@final
class Urgency:
    VERY_LOW: ClassVar[Urgency] = ...
    LOW: ClassVar[Urgency] = ...
    NORMAL: ClassVar[Urgency] = ...
    HIGH: ClassVar[Urgency] = ...

@final
class Body:
    def __new__(cls, data: bytes, content_type: str | None = None) -> Body: ...
    @staticmethod
    def text(text: str) -> Body: ...
    @property
    def data(self) -> bytes: ...
    @property
    def content_type(self) -> str | None: ...
    @property
    def is_text(self) -> bool: ...
    def as_text(self) -> str | None: ...

@final
class Gap:
    EPOCH_CHANGED: ClassVar[Gap] = ...
    BEYOND_RETAINED: ClassVar[Gap] = ...

@final
class LossKind:
    LIVENESS_TIMEOUT: ClassVar[LossKind] = ...
    TRANSPORT_CLOSED: ClassVar[LossKind] = ...

@final
class Loss:
    __match_args__ = ("kind", "code", "reason")
    @property
    def kind(self) -> LossKind: ...
    @property
    def code(self) -> int | None: ...
    @property
    def reason(self) -> str: ...

@final
class DialFailureKind:
    IO: ClassVar[DialFailureKind] = ...
    TLS: ClassVar[DialFailureKind] = ...
    UPGRADE_REJECTED: ClassVar[DialFailureKind] = ...
    HANDSHAKE: ClassVar[DialFailureKind] = ...
    TIMED_OUT: ClassVar[DialFailureKind] = ...

@final
class DialFailure:
    __match_args__ = ("kind", "status", "detail")
    @property
    def kind(self) -> DialFailureKind: ...
    @property
    def status(self) -> int | None: ...
    @property
    def detail(self) -> str | None: ...

class PublishOutcome: ...

@final
class Ok(PublishOutcome): ...

@final
class Failed(PublishOutcome): ...

@final
class RateLimited(PublishOutcome): ...

@final
class BodyTooLarge(PublishOutcome):
    __match_args__ = ("len", "max")
    @property
    def len(self) -> int: ...
    @property
    def max(self) -> int: ...

@final
class TextOnlyChannel(PublishOutcome): ...

@final
class AttachmentNotHeld(PublishOutcome): ...

@final
class Subscribed:
    __match_args__ = ("replay_count", "gap")
    @property
    def replay_count(self) -> int: ...
    @property
    def gap(self) -> Gap | None: ...

@final
class Unavailable: ...

class Event: ...

@final
class Delivery(Event):
    __match_args__ = (
        "channel",
        "message_id",
        "sender",
        "publish_ts",
        "reply_to",
        "urgency",
        "body",
        "seq",
        "dropped",
        "attachments",
    )
    @property
    def channel(self) -> str: ...
    @property
    def message_id(self) -> str: ...
    @property
    def sender(self) -> str: ...
    @property
    def publish_ts(self) -> datetime.datetime: ...
    @property
    def reply_to(self) -> str | None: ...
    @property
    def urgency(self) -> Urgency: ...
    @property
    def body(self) -> Body: ...
    @property
    def seq(self) -> int: ...
    @property
    def dropped(self) -> int: ...
    @property
    def attachments(self) -> tuple[Attachment, ...]: ...

@final
class Resubscribed(Event):
    __match_args__ = ("channel", "replay_count", "gap")
    @property
    def channel(self) -> str: ...
    @property
    def replay_count(self) -> int: ...
    @property
    def gap(self) -> Gap | None: ...

@final
class SubscriptionDropped(Event):
    __match_args__ = ("channel",)
    @property
    def channel(self) -> str: ...

@final
class Attached(Event):
    __match_args__ = ("facts",)
    @property
    def facts(self) -> AttachmentFacts: ...

@final
class Detached(Event):
    __match_args__ = ("loss", "last_dial_failure")
    @property
    def loss(self) -> Loss: ...
    @property
    def last_dial_failure(self) -> DialFailure | None: ...

class BusError(Exception): ...

class AttachTimeout(BusError):
    last_failure: DialFailure | None

class NotAttached(BusError): ...

class ConnectionLost(BusError):
    loss: Loss

class AnswerTimeout(BusError): ...
class AttachmentEnded(BusError): ...

class CredentialRejected(AttachmentEnded):
    status: int

class IncompatibleVersions(AttachmentEnded):
    ours: tuple[int, int]
    theirs: tuple[int, int]

class ProtocolError(AttachmentEnded):
    detail: str

class Futile(AttachmentEnded):
    attachments: int

class ClientClosed(AttachmentEnded): ...

class SupervisorPanicked(AttachmentEnded):
    message: str

class BlobsUnavailable(BusError): ...
class UploadNotGranted(BusError): ...

class UploadRefused(BusError):
    reason: UploadRefusal
    size: int | None
    max: int | None
    offset: int | None
    len: int | None

class OpenRefused(BusError):
    reason: OpenRefusal
    size: int | None

class ReadRefused(BusError):
    reason: ReadRefusal
    size: int | None

class BlobGone(BusError): ...
class AlreadySubscribed(BusError, ValueError): ...
class NotSubscribed(BusError, ValueError): ...
