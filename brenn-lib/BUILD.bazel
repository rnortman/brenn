load("//bazel/features:defs.bzl", "TESTUTILS_FEATURES")
load("//bazel/policy:defs.bzl", "policy_srcs")
load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")

policy_srcs()

exports_files(["Cargo.toml"])

FIRST_PARTY_DEPS = [
    "//brenn-approval-rules",
    "//brenn-budget",
    "//brenn-common",
    "//brenn-db",
    "//brenn-dsl",
    "//brenn-envelope",
    "//brenn-obs",
    "//brenn-queue",
    "//brenn-usage-db",
    "//brenn-ws-types",
    "//surface/schema",
]

# `testutils` gates shared test helpers downstream test targets link against;
# the release configs clear the flag, keeping the shipped binary free of test
# scaffolding.
rust_library(
    name = "brenn-lib",
    srcs = glob(["src/**/*.rs"]),
    crate_features = TESTUTILS_FEATURES,
    edition = "2024",
    visibility = ["//visibility:public"],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True) + FIRST_PARTY_DEPS,
)

# Several unit tests read the shipped configs, and one of them also reads the DSL
# prose doc, through `env!("CARGO_MANIFEST_DIR")`, so the constant has to name
# this package and the files have to be runfiles.
# The workspace-relative form resolves from the runfiles root, which is where a
# Bazel test starts.
#
# `small` (60s): 967 tests, almost all pure config resolution and in-memory
# sqlite, finishing in 0.05s locally. Against the repo's one measured local→CD
# factor (~21x) that is about a second on a cold 4-vCPU runner, three orders
# under the budget.
#
# TODO(build-test-count-guard): the test counts stated in this and every sibling
# size rationale are hand-maintained and match nothing mechanical.
#
# TODO(crate-split): what is left here is the config aggregate, `access`, the
# per-subsystem config halves and the small leaf modules. Tranche 1,
# `automation`, the data layer, `webhook`, `pwa_push`, the `mqtt` runtime, the
# usage accounting and the messaging runtime have all left.
rust_test(
    name = "brenn-lib_test",
    size = "small",
    crate = ":brenn-lib",
    crate_features = ["testutils"],
    data = [
        "//:brenn_configs",
        "//docs:config-dsl.md",
    ],
    edition = "2024",
    rustc_env = {"CARGO_MANIFEST_DIR": "brenn-lib"},
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
)

# `panic_util`'s hook behaviour is only observable to a test that owns the
# process: the delegating hook is installed once behind a `OnceLock`, so the
# recorder it delegates to has to be set before any other test's first
# `catch_quietly`. Its own binary is the only way to guarantee that.
rust_test(
    name = "panic_util_test",
    size = "small",
    srcs = ["tests/panic_util.rs"],
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True) + [":brenn-lib"],
)

rust_doc_test(
    name = "brenn-lib_doc_test",
    crate = ":brenn-lib",
)
