load("@crates//:defs.bzl", "all_crate_deps")
load("@fltk//:rust.bzl", "generate_rust_parser")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_doc_test", "rust_library", "rust_test")
load("//bazel/platforms:defs.bzl", "WASM32_ONLY")
load("//bazel/policy:defs.bzl", "policy_srcs")
load("//bazel/wasm:defs.bzl", "wasm32_build")
load(":defs.bzl", "dsl_test", "format_goldens", "scaffold_goldens")

policy_srcs()

exports_files(["Cargo.toml"])

# The serde instance this crate links, under a name another module can spell.
#
# fltk-serde-core takes its serde through a label flag, and the flag has to
# name the same instance the generated `de.rs` derives against, or the crate
# fails to compile with mismatched-instance errors. `@crates` is this module's
# apparent name for its hub and is invisible from a downstream module, so the
# flag points here instead — `.bazelrc` in this tree, and
# `--@fltk//crates/fltk-serde-core:serde=@brenn//brenn-dsl:fltk_serde` in a
# consumer's.
alias(
    name = "fltk_serde",
    actual = "@crates//:serde",
    visibility = ["//visibility:public"],
)

# The parser, CST, unparser and serde front end, generated from the grammar and
# its two sidecars. Nothing here is tracked: Bazel's dependency tracking is what
# a checked-in copy would need a drift gate for, and editing the format spec is
# an ordinary edit that rebuilds the formatter and every golden below it.
#
# `out_dir = "src"` declares the outputs beside the hand-written sources, which
# is what lets them address each other as `super::` siblings. The basenames are
# load-bearing — `de.rs` must not be `serde.rs`, or every `use serde::…` in the
# crate becomes ambiguous.
generate_rust_parser(
    name = "dsl_gen",
    src = "grammar/brenn.fltkg",
    ast_config = "grammar/brenn.fltkast",
    format_config = "grammar/brenn.fltkfmt",
    goal = "file",
    out_dir = "src",
    serde = True,
    unparser = True,
)

rust_library(
    name = "brenn-dsl",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**"],
    ) + [":dsl_gen"],
    crate_root = "src/lib.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True) + [
        "//brenn-envelope",
        "@fltk//crates/fltk-cst-core:no_python",
        "@fltk//crates/fltk-parser-core:no_python",
        "@fltk//crates/fltk-serde-core:no_python",
        "@fltk//crates/fltk-unparser-core",
    ],
)

rust_test(
    name = "brenn-dsl_test",
    crate = ":brenn-dsl",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
)

dsl_test(name = "corpus")

dsl_test(name = "statements")

dsl_test(name = "sections")

dsl_test(name = "entities")

dsl_test(name = "config_sections")

dsl_test(name = "layout_coverage")

dsl_test(name = "rule_coverage")

dsl_test(name = "resolve")

dsl_test(name = "derive")

dsl_test(name = "authority")

dsl_test(name = "expand")

dsl_test(name = "multifile")

dsl_test(name = "scaffold")

# The CLI suite is not a `dsl_test`: it runs the binary rather than the library,
# so the tool is a declared runfile and the fixtures come along with it.
rust_test(
    name = "cli",
    srcs = [
        "tests/cli.rs",
        "tests/support.rs",
    ],
    crate_root = "tests/cli.rs",
    data = glob(["tests/corpus/**"]) + [":dsl_cli"],
    edition = "2024",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    rustc_env = {"CARGO_MANIFEST_DIR": "brenn-dsl"},
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + [
        ":brenn-dsl",
        "@fltk//crates/fltk-cst-core:no_python",
        "@fltk//crates/fltk-serde-core:no_python",
    ],
)

# The scheme-classification invariant is a property of the sources themselves,
# so this suite reads them rather than the fixtures: the crate's hand-written
# files are its declared runfiles. Not a `dsl_test` for that reason, and it
# needs no dependency beyond std.
rust_test(
    name = "scheme_invariant",
    srcs = ["tests/scheme_invariant.rs"],
    crate_root = "tests/scheme_invariant.rs",
    data = glob(["src/**/*.rs"]),
    edition = "2024",
    rustc_env = {"CARGO_MANIFEST_DIR": package_name()},
)

rust_doc_test(
    name = "brenn-dsl_doc_test",
    crate = ":brenn-dsl",
)

# Dev tools, run with `bazel run`. Neither joins the deployed-binaries list.
#
# `brennfmt` takes explicit deps rather than `all_crate_deps`: fltk-fmt-cli
# links clap from fltk's own hub, and keeping this workspace's clap transitive
# here means neither is ever a direct extern of the binary. No clap type crosses
# the crate boundary, so the two builds coexisting in one linkage is fine.
rust_binary(
    name = "brennfmt",
    srcs = ["src/bin/brennfmt.rs"],
    crate_root = "src/bin/brennfmt.rs",
    edition = "2024",
    # The root package's format gate needs this binary.
    visibility = ["//:__pkg__"],
    deps = [
        ":brenn-dsl",
        "//brenn-envelope",
        "@fltk//crates/fltk-fmt-cli",
    ],
)

rust_binary(
    name = "dsl_cli",
    srcs = ["src/bin/dsl_cli.rs"],
    crate_root = "src/bin/dsl_cli.rs",
    edition = "2024",
    # `guest_spec_scaffold` runs this from every specification-bearing
    # component's package, and `grant_parity_test` from every packaged
    # processor component.
    visibility = ["//visibility:public"],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True) + [
        ":brenn-dsl",
        "//brenn-envelope",
    ],
)

format_goldens(name = "lexical")

format_goldens(name = "statements")

format_goldens(name = "sections")

format_goldens(name = "entities")

format_goldens(name = "config")

scaffold_goldens(name = "processor-full")

scaffold_goldens(name = "no-inbound")

scaffold_goldens(name = "no-outbound")

scaffold_goldens(name = "no-ports")

# The goldens, compiled the only way they can be: against the guest SDK, for
# wasm32. A golden is otherwise only ever diffed, so nothing asks rustc or clippy
# whether the emitter's output is valid Rust. The in-tree components cover the
# shapes they happen to have, and none has zero inbound ports or no ports at all
# — so the uninhabited enum with its `match self {}` name function and its
# always-`None` `from_name` would otherwise be diffed and never built, and the
# first component of either shape would be where the emitter's mistake surfaced.
rust_library(
    name = "scaffold_processor_goldens",
    srcs = [
        "tests/corpus/scaffold/no-inbound.rs",
        "tests/corpus/scaffold/no-outbound.rs",
        "tests/corpus/scaffold/no-ports.rs",
        "tests/corpus/scaffold/processor-full.rs",
        "tests/scaffold_processor_goldens.rs",
    ],
    crate_root = "tests/scaffold_processor_goldens.rs",
    edition = "2024",
    target_compatible_with = WASM32_ONLY,
    deps = ["//brenn-wasm/components/guest:brenn-guest"],
)

# What reaches the library above from a host-configured build; without it the
# wasm32-only target is skipped rather than compiled.
wasm32_build(
    name = "scaffold_processor_goldens_wasm32",
    target = ":scaffold_processor_goldens",
)
