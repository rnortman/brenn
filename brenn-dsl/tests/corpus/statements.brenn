// Every statement form the language has, once.

use wiring::alice::Deskbar;

// Every statement below whose terminator is followed by a blank line or a
// comment is a layout fixture as much as a syntax one: the terminator belongs
// to its statement, and the trivia belongs to the gap it was written in.
uuid_pins {
    "brenn:alice-desk.in.p1.messages" = "bced053b-841b-4551-9868-bfe9c47cc974";

    // A pin, a blank line, and a comment, inside a braced body.
    "brenn:bob-pad.in.p1.messages" = "7d1f6c02-3a44-4c1b-9b0e-2f8f4d5a6b7c";
}

// The doctype here is an expectation with no doctyped port bound to it: legal
// and inert, which is the state an operator writes it in ahead of the component.
/// Utterances from the pod host.
channel utterance at "brenn:alice-pod.out.utterance" {
    description = "What the pod host heard.";
    push_depth = 8;
    retain_depth = 128;
    doctype = "brenn.pod.utterance@1";
}

// Depth tuning for a system-minted family: no handle, nothing to bind.
channel at prefix "mqtt:broker:alice/" {
    push_depth = 4;
    retain_depth = 16;
}

// An anonymous channel: no address, no body, and no `channel` block anywhere.
// Which ring it lands on and what it is called are decided at boot from the
// ports bound to it.
/// Frames the echo stub hands the reserved-port demo.
link relay;

// A `link` is the shortest statement the language has, and the one that used
// to strand its `;` under the blank line above.
component Protobar {
    abi = processor;
    requires = [ports, log];
    in messages: "brenn.panel.message@1";
}

// `optional` reads as an attr key and as a port marker in one body: the attr
// alternative is tried first and fails whole at the port, so the marker gets
// the input.
component EchoStub {
    abi = processor;
    requires = [ports];
    optional = [takeover];
    in inbound: "brenn.panel.message@1";
    out outbound;

    // A port declaration with no doctype ends on the terminator itself.
    optional io acks;
}

// Port names are the component's own and nothing reserves the binding or
// declaration keywords, so a port literally named `in` reads as `in in <- …`
// and one named `optional` can itself be optional.
component Reserved {
    abi = processor;
    requires = [ports];
    in in;
    out out;
    optional io optional;
}

agent PersonalAssistant(slug: String, user: String, ws: Repo, skin: String = "bench") {
    slug = slug;
    name = "Personal Assistant";
    grants = [subscribe, publish];
    container = sandbox;

    mount ws { working_dir = true; }
    mount life;

    // The blank line below this block is deleted by the formatter, and the
    // canonical records that deletion — the defect TODO(dsl-fmt-tail-block-blank-line)
    // names, not the intended layout. When that TODO closes, the blank comes back
    // and the canonical hunk is expected.
    mount notes { working_dir = false; // A tail statement keeps its `;` too.
    }

    mcp_server graf;
    mcp_server pfin {
        command = "pf";
        args = ["mcp"];
    }

    start_hooks {
        container = ["pf rebuild"];
    }

    subscribe alice_cmd { push_depth = 1000; }
    subscribe f"webhook:push-{user}" { push_depth = 10; }

    acl subscribe [prefix "brenn:surface.", exact "brenn:surface-errors"];
}

mcp_server graf {
    command = "graf";
    args = ["mcp"];
}

assembly Deskbar(slug: String, driver: Agent) {
    /// A doc comment separated from the declaration it attaches to by a blank
    /// line. The gap goes the way the gaps between doc lines go.

    channel messages_p1 at f"brenn:{slug}.in.p1.messages" { push_depth = 64; retain_depth = 64; doctype = "brenn.panel.message@1"; }
    /// A multi-line doc comment on an indented declaration: every line after
    /// the first carries the body's indentation, and the lines stay one comment.
    ///
    /// A paragraph break inside one is an empty `///` line.
    channel acks at f"brenn:{slug}.out.meeting.acks" { push_depth = 8; retain_depth = 32; }

    surface panel {
        slug = f"{slug}-panel";
        grants = [subscribe, publish, takeover];
        acl subscribe [prefix f"brenn:{slug}."];

        new p1: Protobar {
            grants = [ports, log];
            acl subscribe [prefix f"brenn:{slug}."];
            in messages <- messages_p1;
            io tick { push_depth = 1; retain_depth = 2; }
        }

        new echo: EchoStub {
            grants = [ports, takeover];
            io acks <-> acks;
            out outbound -> "local:brenn/takeover";
            in inbound <- "local:brenn/theme" { push_depth = 8; }
        }
    }

    // A surface and a top-level instantiation in one body: placement is the
    // `new`'s position and nothing else, so one assembly can stamp a page and
    // the backend instance it talks to.
    /// A doc comment written with a blank line between two of its lines.

    /// The blank line is not text and does not survive formatting.
    new counter: Reserved {
        slug = f"{slug}-counter";
        grants = [ports];

        in in <- acks { push_depth = 8; }
        out out -> relay;
    }

    grant driver subscribe prefix f"brenn:{slug}.";
}

new alice_pa: PersonalAssistant(slug = "alice-pa", user = "alice", ws = ws_alice);

new alice_desk: Deskbar(slug = "alice-desk", driver = alice_pa);

// The `client` entry that authorizes egress is what mints the sink, so the
// sink's budget rides the entry's tail rather than a block of its own.
new consume_demo: EchoStub {
    slug = "consume-demo";
    grants = [ports, mqtt];

    in inbound <- "webhook:push-alice" { push_depth = 50; noise = alarm; }
    out outbound -> relay;
    acl publish [client "mqtt:broker" { publish_per_activation = 2.0, publish_capacity = 4.0 }];
}

new reserved_demo: Reserved {
    slug = "reserved-demo";
    grants = [ports];

    in in <- relay { push_depth = 4; retain_depth = 8; }
    out out -> wasm_demo_out;
}

remote reachy00 {
    token_file = f"{secrets}/remote-reachy00.token";
    grants = [subscribe, publish];
    acl publish [prefix "brenn:reachy00.out."];
}

webhook push_alice {
    description = "Pushes from alice's phone.";
    mount = "/webhooks/push-alice";
    signature {
        scheme = hmac-timestamped-body;
        max_skew_secs = 300;
    }
    key primary {
        secret_file = f"{secrets}/push-alice.secret";
    }
    replay_protection {
        component = "replay-generic";
        store_path = f"{state}/replay-push-alice.db";
    }
}

repo life {
    remote = "forgejo@example.com:alice/life.git";
}

mqtt_client broker {
    url = "mqtts://broker.example.com:8883";
}

acl subscribe [prefix "brenn:alice-desk."];

grant alice_pa publish exact wasm_demo_out;

// A matcher with an inline-table tail ends on an absent optional, which is the
// shape whose trivia used to drift past the terminator by a different route.
grant alice_pa publish prefix "brenn:alice-desk.out." { publish_per_activation = 2.0, publish_capacity = 4.0 };


/// Everything the arrangements this deployment stamps may ever hold.
principal ui {
    grants = [dom, log, page-dom, ports, publish, subscribe];
    acl subscribe [prefix "brenn:alice-desk."];
}

/// Fewer words, the same reach.
principal ui_readonly under ui {
    grants = [dom, log, page-dom, ports];

    // A list-valued attr, last in its body: its value ends on a suppressed `]`.
}

/// Exactly what `ui_readonly` holds, and no ceiling of its own.
new alice_bench: Deskbar(slug = "alice-bench", driver = alice_pa) under ui_readonly;

/// The same arrangement, narrowed again where it is stamped.
new alice_slab: Deskbar(slug = "alice-slab", driver = alice_pa) under ui {
    grants = [dom, log, page-dom, ports];
    acl subscribe [prefix "brenn:alice-desk.slab."];
}
