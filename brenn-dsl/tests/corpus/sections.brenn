// Generic sections: one grammar shape, typed after the parse by its kindword.
const secrets = "/home/alice/.secrets";

/// An HMAC endpoint: signature, one key, and a replay guard.
webhook push_alice {
    slug = "push-alice";
    mount = "/webhooks/push-alice";
    content_type = "text/plain";
    signature {
        scheme = hmac-timestamped-body;
        sig_header = "x-brenn-push-signature";
        sig_format = "v1-hex";
        timestamp_header = "x-brenn-push-timestamp";
        template = "{t}.{body}";
        max_skew_secs = 300;
    }
    /// The only key in rotation.
    key primary { secret_file = f"{secrets}/push-alice.secret"; }
    replay_protection {
        component_path = "/home/alice/lib/brenn_replay_generic.wasm";
        store_path = "/home/alice/state/replay-push-alice.db";
        store_size_limit = "128MiB";
    }
}

// The bearer counterpart: a token where the HMAC endpoint has a key.
webhook push_bob {
    signature {
        scheme = bearer-token;
        header = "authorization";
        token_id_header = "x-brenn-token-id";
    }
    token primary { secret_file = "/home/alice/.secrets/push-bob.token"; }
}

agent PersonalAssistant(slug: String) {
    model = "sonnet";
    start_hooks { host = ["echo ready"]; container = ["echo container ready"]; }
    post_pull_hooks { host = ["echo pulled"]; }
    startup_hooks { container = ["echo started"]; }
    /// The upload affordance the app offers, and what runs on it.
    attachment_target import {
        label = "Import a statement";
        accept = [".ofx", ".csv"];
        multi = true;
        handler {
            type = command;
            program = "pf";
            args = ["--json", "import", "{ofx}", "--csv", "{csv}"];
            timeout_secs = 90;
            cc_instructions = "Reconcile the import against the ledger.";
            file_roles = { ofx = [".ofx"], csv = [".csv"] };
        }
    }
    /// What this app hands the ledger integration, on top of the global block.
    integration_config ledger {
        env = { LEDGER_DATA = f"{secrets}/ledger-alice", LEDGER_STRICT = "1" };
    }
    // A second name is a second map key: an open body claims every key it
    // wrote, so a scalar sits beside a table without a vocabulary to check it
    // against.
    integration_config calendar {
        env = { CALENDAR_HOME = "/home/alice/calendar" };
        timeout_secs = 30;
    }
    /// The one registry tool this app reaches, and the repos it may pull.
    tool git-repo-pull {
        allow { repo = "ws"; }
    }
}

// An instance body admits sections too. A `tool` grant is one named registry
// tool this component may invoke: the `allow` blocks are ORed clauses narrowing
// which invocations it reaches, and the bucket throttles what is left.
new pull_bot: Syncer {
    slug = "pull-bot";
    component_path = "/home/alice/lib/brenn_syncer.wasm";
    grants = [ports, tools];

    tool git-repo-pull {
        allow { repo = "ws"; }
        allow { repo = "notes"; }
        rate_limit { burst = 2; sustained_per_minute = 10; }
    }
}
