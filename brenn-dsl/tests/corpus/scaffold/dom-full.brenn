/// A dom specification with every direction and an optional grant: the lighter
/// emission, with no window classifier, no publish handles and no capability
/// re-exports.
component ScaffoldDom {
  abi = dom;
  requires = [ports, log];
  optional = [takeover];
  in theme: "brenn.scaffold.theme@1";
  optional in overlay;
  out overlay-state: "brenn.scaffold.overlay-state@1";
  io self-tick;
}
