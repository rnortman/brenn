load("//bazel/policy:defs.bzl", "policy_srcs")
load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")

policy_srcs()

exports_files(["Cargo.toml"])

rust_library(
    name = "brenn-approval-rules",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    visibility = ["//visibility:public"],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True),
)

# 150 tests, all in-process pattern matching against literal strings; the
# default `medium` (300s) is orders of magnitude more than they need.
rust_test(
    name = "brenn-approval-rules_test",
    size = "small",
    crate = ":brenn-approval-rules",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True),
)

rust_doc_test(
    name = "brenn-approval-rules_doc_test",
    crate = ":brenn-approval-rules",
)
