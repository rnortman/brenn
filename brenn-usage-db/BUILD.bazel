load("//bazel/policy:defs.bzl", "policy_srcs")
load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")

policy_srcs()

exports_files(["Cargo.toml"])

rust_library(
    name = "brenn-usage-db",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    visibility = ["//visibility:public"],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True) + [
        "//brenn-db",
    ],
)

# 32 tests, all in-memory sqlite over a handful of rows; the whole binary
# finishes well inside a second locally, so `small` (60s) keeps a wide margin
# even on a cold 4-vCPU runner.
rust_test(
    name = "brenn-usage-db_test",
    size = "small",
    crate = ":brenn-usage-db",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True) + [
        "//brenn-db",
    ],
)

rust_doc_test(
    name = "brenn-usage-db_doc_test",
    crate = ":brenn-usage-db",
)
