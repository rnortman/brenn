"""Workspace root — exports, and the repo-wide policy file set."""

load("@rules_python//python:defs.bzl", "py_test")
load("//bazel/policy:defs.bzl", "policy_srcs", "source_manifest")
load("//brenn-dsl:defs.bzl", "format_check")

exports_files([
    "Cargo.toml",
    "Cargo.lock",
    "rust-toolchain.toml",
    "MODULE.bazel",
    # Read by scrub's rule-semantics suite.
    ".gitleaks.toml",
    # Shipped in the release tarball's lib/.
    "noop_mcp.py",
])

# The shipped root configs and the shared modules they import, globbed rather
# than listed: a new module joins the config-file tests and the format gate
# below by existing, so neither can be silently skipped.
BRENN_CONFIGS = glob([
    "*.brenn",
    "config/*.brenn",
])

# Roots and every module they import, so test consumers get a complete config
# tree in one runfiles group.
filegroup(
    name = "brenn_configs",
    srcs = BRENN_CONFIGS,
    visibility = ["//visibility:public"],
)

# The format gate lives beside the documents so BRENN_CONFIGS is the single
# source of truth for which files are checked.
[
    format_check(
        name = config[:-len(".brenn")].replace("/", "_").replace(".", "_"),
        src = config,
    )
    for config in BRENN_CONFIGS
]

policy_srcs()

# The MCP stub's unittest suite. Both files are srcs of the one target rather
# than a library and a test over it: the suite imports the module by name from
# the same directory, which is how it runs under `python3 -m unittest` too.
py_test(
    name = "noop_mcp_test",
    srcs = [
        "noop_mcp.py",
        "noop_mcp_test.py",
    ],
    main = "noop_mcp_test.py",
    size = "small",
)

# Every package's contribution, in one place: one entry per BUILD.bazel in the
# tree, the root's own included above. Their union is the whole tracked tree
# except the two git-tracked, `.bazelignore`d `host-crates/` symlinks, which
# Bazel does not see and which have no content to scan.
#
# `make bazel-policy-parity` is what holds that true, in both directions: a
# package added without an entry here drops its whole directory out of the scan,
# a tracked file matching one of `POLICY_SRC_EXCLUDE`'s patterns leaves it the
# same way, and an untracked file joins this set alone. Symlinks are normalized
# out of both sides. It runs outside the sandbox — it needs git — so it is a CI
# step rather than a test target.
filegroup(
    name = "all_policy_srcs",
    srcs = [
        ":policy_srcs",
        "//attach/client:policy_srcs",
        "//attach/conformance:policy_srcs",
        "//attach/proto:policy_srcs",
