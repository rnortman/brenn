load("//bazel/policy:defs.bzl", "policy_srcs")
load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")

policy_srcs()

exports_files(["Cargo.toml"])

FIRST_PARTY_DEPS = [
    "//brenn-db",
    "//brenn-lib",
    "//brenn-messaging",
    "//brenn-tool-registry",
]

rust_library(
    name = "brenn-device-location",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    visibility = ["//visibility:public"],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True) + FIRST_PARTY_DEPS,
)

# The validator's bounds, the channel reads and consent section and the tool,
# over an in-memory SQLite database and a messenger holding the seeded users'
# channels. Sub-second locally; `small` (60s) holds with margin
# on a cold 4-vCPU runner.
rust_test(
    name = "brenn-device-location_test",
    size = "small",
    crate = ":brenn-device-location",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True) + FIRST_PARTY_DEPS,
)

rust_doc_test(
    name = "brenn-device-location_doc_test",
    crate = ":brenn-device-location",
)
