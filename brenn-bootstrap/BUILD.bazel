    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    visibility = ["//visibility:public"],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True) + [
        "//attach/server",
        "//brenn-automation",
        "//brenn-common",
        "//brenn-db",
        "//brenn-git",
        "//brenn-graf",
        "//brenn-hooks",
        "//brenn-envelope",
        "//brenn-lib",
        "//brenn-cc-profile",
        "//brenn-messaging",
        "//brenn-messaging-store",
        "//brenn-messaging-boot",
        "//brenn-mqtt",
        "//brenn-obs",
        "//brenn-pfin",
        "//brenn-pwa-push",
        "//brenn-remote-server",
        "//brenn-render",
        "//brenn-server",
        "//brenn-tool-registry",
        "//brenn-wasm",
        "//brenn-wasm-dispatch",
        "//brenn-usage-db",
        "//brenn-webhook",
