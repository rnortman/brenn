// The hermetic deployment the Playwright harness drives (`make e2e`): a
// non-dev port, all state under `target/e2e` so `rm -rf target/e2e` gives a
// fresh database, and nothing shared with a developer's own instance.
//
// `bind_address` must match `E2E_BASE_URL` in the Makefile's `e2e` target,
// which polls this port.
//
// Authoring conventions for this tree: `docs/config-dsl.md`.
use config::bar::*;
use config::specs::chrome::*;
use config::specs::echo-stub::*;
use config::specs::meeting::*;
use config::specs::mode-clock::*;
use config::specs::processor-demo::*;
use config::specs::protobar::*;
use config::surfaces::*;

/// Where the server listens and what it believes about the proxy in front. The
/// two asset trees are build outputs, reached through bazel's convenience
/// symlinks.
server {
  bind_address = "127.0.0.1:3100";
  static_dir = ".bazel-bin/frontend/dist";
  surface_dist_dir = ".bazel-bin/surface/dist";
  secure_cookies = false;
  public_url = "http://127.0.0.1:3100";
}

database {
  path = "target/e2e/brenn.db";
}

logging {
  log_dir = "target/e2e/logs";
  console_level = debug;
  file_level = debug;
}

claude_defaults {
  mcp_script_path = "noop_mcp.py";
  model = "sonnet";
}

/// Where surface error reports land. This harness runs the noop alerter, so the
/// alert leg is covered by the native integration tests rather than from the
/// browser here.
observability {
  surface_error_channel = "brenn:surface-errors";
}

// Every durable uuid is carried rather than derived. An unused pin is a compile
// error, which keeps this block honest against the declarations — including the
// ones the assemblies below stamp.
uuid_pins {
  "brenn:surface-errors" = "a6e15b49-0885-4971-a036-b8d5a9ba693a";
  "brenn:surface.index" = "4f8c915e-c61f-497e-940d-554a9aa8a266";
  "brenn:surface.surface.bar.help" = "8298c316-1e30-4865-ba92-037937f7f4dc";
  "brenn:surface.surface.bar.geometry" = "d8f95b22-17f4-4fbe-98b0-022daf14d5a8";
  "brenn:surface.surface.bar.status" = "a6a79c4b-03c7-437c-acfd-876eefa92d19";
  "brenn:surface.surface.bar-pixel.help" = "d071170c-5804-41d7-9a5f-4c424a471ebe";
  "brenn:surface.surface.bar-pixel.geometry" = "5efc6991-39fe-4d31-af3a-9b550ed6a362";
  "brenn:surface.surface.bar-pixel.status" = "b0fb39cd-c6b0-4cc4-8ee5-8622cb0c3178";
  "brenn:surface.surface.bar-feeder.help" = "9d6d95c2-5763-4a5e-a203-5b187d830d99";
  "brenn:surface.surface.bar-feeder.geometry" = "befb1315-1bbf-4bbf-b380-196d95161c0a";
  "brenn:surface.surface.bar-feeder.status" = "ad89bcfa-9004-47c7-892f-9b51291a78ae";
  "brenn:surface.kind.protobar.help" = "e01edb29-0c73-475f-bc57-a2ff204d99a1";
  "brenn:surface.kind.protobar.schema" = "d557bf65-99ce-404e-b834-d232548045ba";
  "brenn:surface.kind.echo-stub.help" = "f95e0ce1-363d-4c6b-89bf-63148106fe73";
  "brenn:surface.kind.echo-stub.schema" = "8c0d76ee-abac-422d-a9d4-de3b44bf9857";
  "brenn:surface.kind.chrome.help" = "5e544eb5-4f75-4835-ae17-2cae2801e660";
  "brenn:surface.kind.chrome.schema" = "4490b610-206c-4041-87e1-83d611d3a603";
  "brenn:bar-layout" = "3c1142e7-5a7f-4781-939a-dfaa0cc8c7a0";
  "brenn:bar-a" = "3b2ef031-f286-42e8-a9ac-c66aade0ce0a";
  "brenn:bar-b" = "2ccd9df1-08b1-4554-9745-fc3ade11ed98";
  "brenn:bar-c" = "0d0f95db-13aa-4214-a461-aa1fbf788351";
}

new bar_desc: SurfaceDescription(slug = "bar");
new bar_pixel_desc: SurfaceDescription(slug = "bar-pixel");
new bar_feeder_desc: SurfaceDescription(slug = "bar-feeder");

new protobar_desc: KindDescription(kind = "protobar");
new echo_stub_desc: KindDescription(kind = "echo-stub");
new chrome_desc: KindDescription(kind = "chrome");

/// At least one app is mandatory. This one exists only to satisfy config
/// validation: no conversation is ever started against it, and it holds no
/// grants.
agent E2eFloor {
  name = "E2E";
  description = "e2e validation floor";
  icon = "🧪";
  working_dir = ".";
}

new e2e: E2eFloor;

/// One read-only bar: three panel instances on the shared content channels,
/// layout driven from `brenn:bar-layout`, under the named skin. `bar.spec.ts`
/// drives the layout, content, and reload flows against these.
///
/// A binding on a latest-wins port takes `push_depth = 1` — a layout or content
/// document is complete, never a delta — rather than inheriting the channel's
/// burst rung, which stays 8 to bound the parked deferred-publish backlog and
/// clamps these statements from above. The `local:` planes follow the same rule:
/// 1 on latest-wins, 8 on the toast event stream. An unbound `io tick` /
/// `io toast-tick` resolves to an anonymous page-local ring, where a wake
/// subsumes its predecessor and `retain_depth = 2` covers a cancel and its
/// replacement.
///
/// No component here holds `takeover`, so chrome binds no takeover plane.
assembly BarSurface(slug: String, skin: String) {
  surface bar {
    slug = f"{slug}";
    grants = [subscribe];
    skin = skin;
    new p1: Protobar {
      grants = [ports, log];
      in messages <- bar_a;
      io tick { push_depth = 1; retain_depth = 2; }

    }
    new p2: Protobar {
      grants = [ports, log];
      in messages <- bar_b;
      io tick { push_depth = 1; retain_depth = 2; }

    }
    new p3: Protobar {
      grants = [ports, log];
      in messages <- bar_c;
      io tick { push_depth = 1; retain_depth = 2; }

    }
    new chrome: Chrome {
      grants = [ports, log];
      chrome = true;
      in layout <- bar_layout { push_depth = 1; }
      in theme <- "local:brenn/theme" { push_depth = 1; }
      in link-state <- "local:brenn/link-state" { push_depth = 1; }
      in surface-state <- "local:brenn/surface-state" { push_depth = 1; }
      in toast <- "local:brenn/toast" { push_depth = 8; }
      io toast-tick { push_depth = 1; retain_depth = 2; }

    }

  }
}

new bar: BarSurface(slug = "bar", skin = "bench");
new bar_pixel: BarSurface(slug = "bar-pixel", skin = "foundry");

/// Browser-driven publisher for the bar: one echo-stub per bar channel plus the
/// layout channel. The specs type bodies and layout JSON and click send, driving
/// the bar end to end.
///
/// `grants = [publish]` plus the `out` bindings are the durable-publish pair;
/// publish authority is derived from the bindings. No `allowed_users`, so any
/// authenticated user may publish durably — harmless on this hermetic loopback
/// harness, but a multi-user config copying this surface must add it. Chrome
/// binds no layout channel here, so it renders the default layout.
surface bar-feeder {
  grants = [publish];
  new feed-a: EchoStub {
    grants = [ports, log];
    out out -> bar_a;
  }
  new feed-b: EchoStub {
    grants = [ports, log];
    out out -> bar_b;
  }
  new feed-c: EchoStub {
    grants = [ports, log];
    out out -> bar_c;
  }
  new feed-layout: EchoStub {
    grants = [ports, log];
    out out -> bar_layout;
  }
  new chrome: Chrome {
    grants = [ports, log];
    chrome = true;
    in theme <- "local:brenn/theme" { push_depth = 1; }
    in link-state <- "local:brenn/link-state" { push_depth = 1; }
    in surface-state <- "local:brenn/surface-state" { push_depth = 1; }
    in toast <- "local:brenn/toast" { push_depth = 8; }
    io toast-tick { push_depth = 1; retain_depth = 2; }

  }

}
