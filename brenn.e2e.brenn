// The hermetic deployment the Playwright harness drives (`make e2e`): a
// non-dev port, all state under `target/e2e` so `rm -rf target/e2e` gives a
// fresh database, and nothing shared with a developer's own instance.
//
// `bind_address` must match `E2E_BASE_URL` in the Makefile's `e2e` target,
// which polls this port.
//
// Authoring conventions for this tree: `docs/config-dsl.md`.
use config::bar::*;
use @chrome::*;
use @config-reload::*;
use @echo-stub::*;
use @git-forge-parser::*;
use @git-sync-consumer::*;
use @meeting::*;
use @mode-clock::*;
use @processor-demo::*;
use @processor-page-bytes-test::*;
use @processor-transplant::*;
use @protobar::*;
use @surface-description::*;

/// Where the server listens and what it believes about the proxy in front. The
/// two asset trees are build outputs, reached through bazel's convenience
/// symlinks.
server {
  bind_address = "127.0.0.1:3100";
  static_dir = ".bazel-bin/frontend/dist";
  secure_cookies = false;
  public_url = "http://127.0.0.1:3100";
}

database {
  path = "target/e2e/brenn.db";
}

logging {
  log_dir = "target/e2e/logs";
  console_level = debug;
  file_level = debug;
}

claude_defaults {
  mcp_script_path = "noop_mcp.py";
  model = "sonnet";
}

/// Where surface error reports land. This harness runs the noop alerter, so the
/// alert leg is covered by the native integration tests rather than from the
/// browser here.
observability {
  surface_error_channel = "brenn:surface-errors";
}

/// Raised from the 64 KiB default so the `bytes` surface's fixture can publish
/// the measured body sizes (49 149, 1 048 576 and 3 000 000 bytes) on the page
/// and over its wire.
messaging {
  max_body_bytes = 4194304;
}

// Every durable uuid is carried rather than derived. An unused pin is a compile
// error, which keeps this block honest against the declarations — including the
// ones the assemblies below stamp.
uuid_pins {
  "brenn:surface-errors" = "a6e15b49-0885-4971-a036-b8d5a9ba693a";
  "brenn:surface.index" = "4f8c915e-c61f-497e-940d-554a9aa8a266";
  "brenn:surface.surface.bar.help" = "8298c316-1e30-4865-ba92-037937f7f4dc";
  "brenn:surface.surface.bar.geometry" = "d8f95b22-17f4-4fbe-98b0-022daf14d5a8";
  "brenn:surface.surface.bar.status" = "a6a79c4b-03c7-437c-acfd-876eefa92d19";
  "brenn:surface.surface.bar-pixel.help" = "d071170c-5804-41d7-9a5f-4c424a471ebe";
  "brenn:surface.surface.bar-pixel.geometry" = "5efc6991-39fe-4d31-af3a-9b550ed6a362";
  "brenn:surface.surface.bar-pixel.status" = "b0fb39cd-c6b0-4cc4-8ee5-8622cb0c3178";
  "brenn:surface.surface.bar-feeder.help" = "9d6d95c2-5763-4a5e-a203-5b187d830d99";
  "brenn:surface.surface.bar-feeder.geometry" = "befb1315-1bbf-4bbf-b380-196d95161c0a";
  "brenn:surface.surface.bar-feeder.status" = "ad89bcfa-9004-47c7-892f-9b51291a78ae";
  "brenn:surface.surface.loopback.help" = "e887add3-567f-4c78-a689-e4c942b4aca8";
  "brenn:surface.surface.loopback.geometry" = "88785ea0-383c-41b1-a46c-a86c5b7d5ac2";
  "brenn:surface.surface.loopback.status" = "501eaf58-6e8f-4fb9-bf10-f916a0673ecb";
  "brenn:surface.surface.bytes.help" = "fa040201-db95-4b36-ac67-63505f645d25";
  "brenn:surface.surface.bytes.geometry" = "a4f66fad-35d2-4160-91f1-851c48eea1c7";
  "brenn:surface.surface.bytes.status" = "4a24a7d4-d4fe-4331-bc57-ddefc46f6862";
  "brenn:surface.kind.protobar.help" = "e01edb29-0c73-475f-bc57-a2ff204d99a1";
  "brenn:surface.kind.protobar.schema" = "d557bf65-99ce-404e-b834-d232548045ba";
  "brenn:surface.kind.echo-stub.help" = "f95e0ce1-363d-4c6b-89bf-63148106fe73";
  "brenn:surface.kind.echo-stub.schema" = "8c0d76ee-abac-422d-a9d4-de3b44bf9857";
  "brenn:surface.kind.chrome.help" = "5e544eb5-4f75-4835-ae17-2cae2801e660";
  "brenn:surface.kind.chrome.schema" = "4490b610-206c-4041-87e1-83d611d3a603";
  "brenn:surface.kind.processor-page-bytes-test.help" = "163b44ee-b095-489a-9ef9-f19af0bff72b";
  "brenn:surface.kind.processor-page-bytes-test.schema" = "e23d3209-1c2d-413c-8379-9970471f3b8c";
  "brenn:bar-layout" = "3c1142e7-5a7f-4781-939a-dfaa0cc8c7a0";
  "brenn:bar-a" = "3b2ef031-f286-42e8-a9ac-c66aade0ce0a";
  "brenn:bar-b" = "2ccd9df1-08b1-4554-9745-fc3ade11ed98";
  "brenn:bar-c" = "0d0f95db-13aa-4214-a461-aa1fbf788351";
}

new config_reload: ConfigReload();

new surface_commons: SurfaceCommons;
new bar_desc: SurfaceDescription(slug = "bar");
new bar_pixel_desc: SurfaceDescription(slug = "bar-pixel");
new bar_feeder_desc: SurfaceDescription(slug = "bar-feeder");
new loopback_desc: SurfaceDescription(slug = "loopback");
new bytes_desc: SurfaceDescription(slug = "bytes");

new protobar_desc: KindDescription(kind = "protobar");
new echo_stub_desc: KindDescription(kind = "echo-stub");
new chrome_desc: KindDescription(kind = "chrome");
new page_bytes_test_desc: KindDescription(kind = "processor-page-bytes-test");

/// At least one app is mandatory. This one exists only to satisfy config
/// validation: no conversation is ever started against it, and it holds no
/// grants.
agent E2eFloor {
  name = "E2E";
  description = "e2e validation floor";
  icon = "🧪";
  working_dir = ".";
}

new e2e: E2eFloor;

/// One read-only bar: three panel instances on the shared content channels,
/// layout driven from `brenn:bar-layout`, under the named skin. `bar.spec.ts`
/// drives the layout, content, and reload flows against these.
///
/// A binding on a latest-wins port takes `push_depth = 1` — a layout or content
/// document is complete, never a delta — rather than inheriting the channel's
/// burst rung, which stays 8 to bound the parked deferred-publish backlog and
/// clamps these statements from above. The `local:` planes follow the same rule:
/// 1 on latest-wins, 8 on the toast event stream. An unbound `io tick` /
/// `io toast-tick` resolves to an anonymous page-local ring, where a wake
/// subsumes its predecessor and `retain_depth = 2` covers a cancel and its
/// replacement.
///
assembly BarSurface(slug: String, skin: String) {
  surface bar {
    slug = f"{slug}";
    grants = [subscribe];
    skin = skin;
    new p1: Protobar {
      grants = [ports, log, dom];
      in messages <- bar_a;
      io tick { push_depth = 1; retain_depth = 2; }
      io state { push_depth = 0; retain_depth = 1; }
    }
    new p2: Protobar {
      grants = [ports, log, dom];
      in messages <- bar_b;
      io tick { push_depth = 1; retain_depth = 2; }
      io state { push_depth = 0; retain_depth = 1; }
    }
    new p3: Protobar {
      grants = [ports, log, dom];
      in messages <- bar_c;
      io tick { push_depth = 1; retain_depth = 2; }
      io state { push_depth = 0; retain_depth = 1; }
    }
  }
  new chrome_stamp: StandardChrome(slug = f"{slug}", layout = bar_layout) {
    grants = [dom, log, page-dom, ports, takeover];
    surfaces = [f"{slug}"];
  }
}

/// The backend half: the demo consumer's author ships the arrangement, this
/// deployment stamps it. Whatever the browser feeds to `brenn:bar-a` is
/// republished on the assembly's own ephemeral channel, so the flag, the
/// packaged module, the assembly expansion and the boot-time package binding
/// are all on the path of a plain `make e2e`.
new demo: DemoLoop(slug = "e2e-demo", source = bar_a) {
  grants = [ports];
}
new bar: BarSurface(slug = "bar", skin = "bench");
new bar_pixel: BarSurface(slug = "bar-pixel", skin = "foundry");

// `e2e/tests/surface-reload.spec.ts` deletes everything between these two
// markers, markers included, and reloads the server: that is how a surface is
// retired out from under an open page. Keep the pair together.
// e2e:retire-block:begin
/// Placeholder layout channel for the feeder page: nothing publishes, so the
/// chrome renders its default layout. `bar_layout` is not reusable here, since
/// its documents name `bar`'s instances. The declaration exists because
/// `StandardChrome`'s `layout` is an entity parameter and a literal address is
/// not one.
///
/// `ephemeral:` and not `local:`, though nothing publishes here: a `local:`
/// address on a surface binding names a *page* ring, while a `local:` channel
/// declaration names a *server* ring, and the two exchange no message. A handle
/// joining them would read as a channel an operator could later publish a
/// layout onto, and that publish would land where the page cannot see it. The
/// cost of the honest spelling is the `subscribe` grant the surface below
/// states.
channel bar_feeder_layout at "ephemeral:bar-feeder.in.chrome.layout" {
  description = "Layout documents for the bar-feeder page (latest-wins)";
  push_depth = 1;
  retain_depth = 1;
}
/// Browser-driven publisher for the bar: one echo-stub per bar channel plus the
/// layout channel. The specs type bodies and layout JSON and click send, driving
/// the bar end to end.
///
/// `publish` plus the `out` bindings are the durable-publish pair; publish
/// authority is derived from the bindings. `subscribe` is the chrome stamp's
/// doing: `StandardChrome`'s `in layout` binding is a transportable subscribe,
/// and a surface grants the transport its bindings reach or the derived entry
/// is refused. No `allowed_users`, so any
/// authenticated user may publish
/// durably — harmless on this hermetic loopback harness, but a multi-user
/// config copying this surface must add it.
surface bar-feeder {
  grants = [subscribe, publish];
  new feed-a: EchoStub {
    grants = [ports, log, dom];
    out out -> bar_a;
    io state { push_depth = 0; retain_depth = 1; }
  }
  new feed-b: EchoStub {
    grants = [ports, log, dom];
    out out -> bar_b;
    io state { push_depth = 0; retain_depth = 1; }
  }
  new feed-c: EchoStub {
    grants = [ports, log, dom];
    out out -> bar_c;
    io state { push_depth = 0; retain_depth = 1; }
  }
  new feed-layout: EchoStub {
    grants = [ports, log, dom];
    out out -> bar_layout;
    io state { push_depth = 0; retain_depth = 1; }
  }
}

new bar_feeder_chrome: StandardChrome(slug = "bar-feeder",
  layout = bar_feeder_layout) {
  grants = [dom, log, page-dom, ports, takeover];
  surfaces = ["bar-feeder"];
}
// e2e:retire-block:end

/// The echo-loop fixture channel. `retain_depth = 8` covers the depth-8 surface
/// binding below: on a non-durable channel the retained window *is* the standing
/// buffer, and no binding depth may exceed it.
channel loopback_echo at "ephemeral:loopback.echo" {
  push_depth = 1;
  retain_depth = 8;
}
/// Placeholder layout channel for the loopback page: nothing publishes, so the
/// chrome renders its default layout. `ephemeral:` rather than `local:` for the
/// reason `bar_feeder_layout` gives.
channel loopback_layout at "ephemeral:loopback.in.chrome.layout" {
  description = "Layout documents for the loopback page (latest-wins)";
  push_depth = 1;
  retain_depth = 1;
}
/// One echo-stub reading its own output back, so what it sends renders in its
/// scrollback where a real pointer can click an entry; `bar.spec.ts` drives the
/// scrollback pick here. A lone instance is what the default `single` layout
/// places.
///
/// `publish` covers the `out` binding; `subscribe` the `in` binding and the
/// chrome's layout binding, as on `bar-feeder`.
surface loopback {
  grants = [subscribe, publish];
  new echo-stub: EchoStub {
    grants = [ports, log, dom];
    in messages <- loopback_echo { push_depth = 8; }
    out out -> loopback_echo;
    io state { push_depth = 0; retain_depth = 1; }
  }
}

new loopback_chrome: StandardChrome(slug = "loopback", layout = loopback_layout) {
  grants = [dom, log, page-dom, ports, takeover];
  surfaces = ["loopback"];
}

/// The wire channel the `bytes` page's `keeper` publishes non-text bodies on
/// and is fed back from: each body leaves over the page's websocket and comes
/// back over it.
channel bytes_wire at "ephemeral:bytes.wire" {
  non_text = true;
  push_depth = 1;
  retain_depth = 1;
}
/// The wire channel the `bytes` page's `streamer` emits its workload on and
/// reads back as its `stream` window, reported by checksum.
channel bytes_stream at "ephemeral:bytes.stream" {
  non_text = true;
  push_depth = 1;
  retain_depth = 1;
}
/// Placeholder layout channel for the bytes page: nothing publishes, so the
/// chrome renders its default layout. `ephemeral:` rather than `local:` for the
/// reason `bar_feeder_layout` gives.
channel bytes_layout at "ephemeral:bytes.in.chrome.layout" {
  description = "Layout documents for the bytes page (latest-wins)";
  push_depth = 1;
  retain_depth = 1;
}
// Each fixture instance's command and report links, both ends on the `bytes`
// page, so every command and report is a page-local text channel.
link bytes_keeper_cmd;
link bytes_keeper_report;
link bytes_stater_cmd;
link bytes_stater_report;
link bytes_streamer_cmd;
link bytes_streamer_report;
/// The byte path in Chromium, driven by `e2e/tests/bytes.spec.ts` and timed by
/// `e2e/tests/bytes-measure.spec.ts`. Three `processor-page-bytes-test`
/// instances on `brenn:processor@0.2.0`: `keeper` keeps a non-text body on a
/// page-local `io` port and sends one over the page's websocket and back;
/// `stater` runs the binary state workload; `streamer` emits the workload over
/// the websocket and reads it back by checksum. Each is driven by an `EchoStub`
/// whose sent text is the fixture's command and whose scrollback shows the
/// fixture's reports.
///
/// Every channel a non-text body rests on or crosses is `non_text`; the drivers
/// touch only the text links. The fixture kind is served from the harness's
/// second mount, so only `make e2e` can boot this surface.
surface bytes {
  grants = [subscribe, publish];
  new keeper: ProcessorPageBytesTest {
    grants = [ports, calls];
    in in <- bytes_keeper_cmd { push_depth = 1; retain_depth = 1; }
    out report -> bytes_keeper_report;
    io memo { push_depth = 0; retain_depth = 1; non_text = true; }
    out out -> bytes_wire;
    in feed <- bytes_wire { push_depth = 1; retain_depth = 1; }
  }
  new stater: ProcessorPageBytesTest {
    grants = [ports, calls];
    in in <- bytes_stater_cmd { push_depth = 1; retain_depth = 1; }
    out report -> bytes_stater_report;
    io state { push_depth = 0; retain_depth = 1; non_text = true; }
  }
  new streamer: ProcessorPageBytesTest {
    grants = [ports, calls];
    in in <- bytes_streamer_cmd { push_depth = 1; retain_depth = 1; }
    out report -> bytes_streamer_report;
    out out -> bytes_stream;
    in stream <- bytes_stream { push_depth = 1; retain_depth = 1; }
  }
  new drive-keeper: EchoStub {
    grants = [ports, log, dom];
    out out -> bytes_keeper_cmd;
    in messages <- bytes_keeper_report { push_depth = 8; retain_depth = 8; }
    io state { push_depth = 0; retain_depth = 1; }
  }
  new drive-stater: EchoStub {
    grants = [ports, log, dom];
    out out -> bytes_stater_cmd;
    in messages <- bytes_stater_report { push_depth = 8; retain_depth = 8; }
    io state { push_depth = 0; retain_depth = 1; }
  }
  new drive-streamer: EchoStub {
    grants = [ports, log, dom];
    out out -> bytes_streamer_cmd;
    in messages <- bytes_streamer_report { push_depth = 8; retain_depth = 8; }
    io state { push_depth = 0; retain_depth = 1; }
  }
}

new bytes_chrome: StandardChrome(slug = "bytes", layout = bytes_layout) {
  grants = [dom, log, page-dom, ports, takeover];
  surfaces = ["bytes"];
}
