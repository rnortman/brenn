"""The surface asset tree: the npm toolchain, and `dist` itself."""

load("@bazel_skylib//rules:native_binary.bzl", "native_test")
load("@surface_npm//:defs.bzl", "npm_link_all_packages")
load("@surface_npm//surface:@bytecodealliance/jco/package_json.bzl", jco_bin = "bin")
load("//bazel/platforms:defs.bzl", "HOST_ONLY")
load("//bazel/policy:defs.bzl", "policy_srcs")
load("//bazel/surface:dist.bzl", "surface_dist", "surface_processor_assets")
load("//bazel/wasm:defs.bzl", "component_bundle")

policy_srcs()

exports_files([
    # Also read by the release package's own copy of this tree.
    "dist-paths.txt",
    "emit-processor-manifest.sh",
    "pnpm-lock.yaml",
])

npm_link_all_packages(name = "node_modules")

# The transpiler, from the lockfile: no `npx`, no `node_modules` on anyone's
# disk, and no preflight comparing an installed version against a pin, because
# the pin is what runs.
jco_bin.jco_binary(
    name = "jco",
    target_compatible_with = HOST_ONLY,
    visibility = ["//visibility:public"],
)

# The version each manifest records. Derived from the same `package.json` pin
# both lockfiles resolve, so a manifest cannot claim a version nothing ran.
#
# A regex over JSON matches any line carrying the needle, and this file already
# carries comment keys, so the match count is checked: a second line would
# otherwise put two versions in every processor manifest, past a non-empty test.
# Public because `surface_processor_assets` names it itself, from whatever
# module calls it: the version in a manifest is the version of the binary that
# transpiled it, out of tree as in tree.
genrule(
    name = "jco_version",
    srcs = ["package.json"],
    outs = ["jco_version.txt"],
    target_compatible_with = HOST_ONLY,
    visibility = ["//visibility:public"],
    cmd = """set -eu
matched=$$(sed -n 's/.*"@bytecodealliance\\/jco": "\\(.*\\)".*/\\1/p' $<)
count=$$(printf '%s' "$$matched" | grep -c '' || true)
if [ "$$count" -ne 1 ]; then
    echo "expected exactly one @bytecodealliance/jco pin in $<, matched $$count line(s)" >&2
    exit 1
fi
printf '%s' "$$matched" > $@
""",
)

# Kinds whose component artifacts are transpiled for browser hosting. An
# explicit list, not a wildcard and not a read of server config: making a
# processor surface-hostable is a deliberate addition. A kind's crate lives in
# its own package under `components/`, which stages its documentation; the
# artifact, the transpiled tree and the manifest that binds them to the authored
# specification are staged here, because the transpiler and the jco version pin
# are this package's.
#
# One list, driving both the asset targets and the stages they are served
# through. Two lists could disagree, and the way they would disagree is silent:
# a kind whose assets build and never reach the served tree.
_PROCESSOR_KINDS = [
    ("processor-transplant", "//brenn-wasm/components/processor-transplant:component"),
    ("echo-stub", "//surface/components/echo-stub:echo-stub_component"),
    ("mode-clock", "//surface/components/mode-clock:mode-clock_component"),
    ("protobar", "//surface/components/protobar:protobar_component"),
    ("meeting", "//surface/components/meeting:meeting_component"),
    ("chrome", "//surface/chrome:chrome_component"),
]

# `<kind>_assets`, never `<kind>`: a staging target's output directory is its
# name, and the chrome kind's crate is the sibling package `surface/chrome`,
# whose own output paths a target named `chrome` here would sit inside.
[
    surface_processor_assets(
        name = kind + "_assets",
        component = component,
        kind = kind,
        spec = "//:config/specs/{kind}.brenn".format(kind = kind),
    )
    for (kind, component) in _PROCESSOR_KINDS
]

# The bundle rule's surface arm, over real staging targets. `examples/component`
# builds a `component_bundle` of packages alone, so without this the wiring that
# hands a stage over as one directory — and the module harvest off the staged
# `<kind>.spec.brenn` — would first run in a consumer's repository. Not a
# release artifact: nothing installs it, and its whole output is the contract
# test beside it.
component_bundle(
    name = "bundle_fixture",
    # brenn's `config/specs` is not one bundle's root; list the two files this
    # fixture releases rather than globbing the directory.
    spec_root = [
        "//:config/specs/echo-stub.brenn",
        "//:config/specs/mode-clock.brenn",
    ],
    surface_kinds = [
        ":echo-stub_assets",
        ":mode-clock_assets",
    ],
)

# Derived, not retyped. `surface_processor_component()` mints `<kind>_dist` in every
# component package, and a hand-written list here is a second edit a mechanical
# component addition would not know to make — the component would build, lint
# and test green while its `.js`, `.wasm` and `help.md` never reached the served
# tree. Enumerating the subpackages makes that unreachable: a new component
# package is staged by existing.
_COMPONENT_STAGES = [
    "//surface/{pkg}:{kind}_dist".format(pkg = pkg, kind = pkg.rpartition("/")[2])
    for pkg in subpackages(include = ["components/*"])
]

# The two crates that are not under `components/`: the in-tree default chrome,
# whose documentation sidecars stage like any other kind's, and the shell, which
# is not a component at all.
_FIXED_STAGES = [
    "//surface/chrome:chrome_dist",
    "//surface/kernel:kernel_dist",
]

surface_dist(
    name = "dist",
    dirname = "dist",
    target_compatible_with = HOST_ONLY,
    stages = [":" + kind + "_assets" for (kind, _) in _PROCESSOR_KINDS] + _FIXED_STAGES + _COMPONENT_STAGES,
    visibility = ["//visibility:public"],
)

# Nothing else reads this tree's top-level file set. The transplant parity pin
# reads one processor directory and the vitest transplant suite reads the
# transpiled modules; a bundle, a sidecar or a whole component could vanish from
# `dist` with every other target green.
native_test(
    name = "dist_paths",
    size = "small",
    src = "//bazel/dist:path_set_check.sh",
    args = [
        "$(rootpath :dist)",
        "$(rootpath dist-paths.txt)",
        "surface/dist",
    ],
    data = [
        "dist-paths.txt",
        ":dist",
    ],
    out = "dist_paths.run",
    target_compatible_with = HOST_ONLY,
)
