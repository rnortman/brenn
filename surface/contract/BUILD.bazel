load("//bazel/platforms:defs.bzl", "HOST_ONLY")
load("//bazel/policy:defs.bzl", "policy_srcs")
load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")

policy_srcs()

exports_files(["Cargo.toml"])

rust_library(
    name = "contract",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "brenn_surface_contract",
    edition = "2024",
    visibility = ["//visibility:public"],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True) + [
        "//brenn-activation",
        "//brenn-envelope",
        "//surface/schema",
    ],
)

rust_test(
    name = "contract_test",
    compile_data = [
        "//:config/specs/chrome.brenn",
        "//:config/specs/echo-stub.brenn",
        "//:config/specs/meeting.brenn",
        "//:config/specs/mode-clock.brenn",
        "//:config/specs/processor-transplant.brenn",
        "//:config/specs/protobar.brenn",
        "//brenn-wasm:wit/processor.wit",
        "//brenn-wasm/components/processor-transplant:src/lib.rs",
        "//brenn-wasm/components/guest:src/lib.rs",
        "//surface:dist-paths.txt",
        "//surface/chrome:src/component.rs",
        "//surface/components/echo-stub:src/component.rs",
        "//surface/components/meeting:src/component.rs",
        "//surface/components/mode-clock:src/component.rs",
        "//surface/components/protobar:src/component.rs",
    ],
    crate = ":contract",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    target_compatible_with = HOST_ONLY,
    deps = all_crate_deps(normal_dev = True),
)

rust_doc_test(
    name = "contract_doc_test",
    crate = ":contract",
    target_compatible_with = HOST_ONLY,
)
