load("//bazel/platforms:defs.bzl", "HOST_ONLY")
load("//bazel/policy:defs.bzl", "policy_srcs")
load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")

policy_srcs()

exports_files(["Cargo.toml"])

# One target for both configurations: the DOM-free helpers are host-testable,
# and the browser half is behind `cfg(target_arch = "wasm32")`, so its
# first-party deps are selected the same way its third-party ones are.
rust_library(
    name = "component-support",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "brenn_surface_component_support",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = {
        "CARGO_PKG_NAME": "brenn-surface-component-support",
        "CARGO_PKG_VERSION": "0.1.0",
    },
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True) + ["//brenn-envelope"] + select({
        "//bazel/platforms:is_wasm32": [
            "//surface/contract",
            "//surface/schema",
        ],
        "//conditions:default": [],
    }),
)

# `tests/prebind_panic.rs` gets no target: the whole file is behind
# `#![cfg(target_arch = "wasm32")]` and it runs under wasm-bindgen-test in a
# real browser, which nothing here drives.
# TODO(surface-wasm-test-in-ci): the browser suites have no runner at all —
# a rule that drives wasm-bindgen-test-runner is what would give them one.
rust_test(
    name = "component-support_test",
    crate = ":component-support",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    target_compatible_with = HOST_ONLY,
    deps = all_crate_deps(normal_dev = True) + ["//surface/test-fixtures"],
)

rust_doc_test(
    name = "component-support_doc_test",
    crate = ":component-support",
    target_compatible_with = HOST_ONLY,
)
