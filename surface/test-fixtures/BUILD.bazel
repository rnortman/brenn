load("//bazel/platforms:defs.bzl", "HOST_ONLY")
load("//bazel/policy:defs.bzl", "policy_srcs")
load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")

policy_srcs()

exports_files([
    "Cargo.toml",
    # The golden activation, read by the kernel's serialization pin through
    # `include_str!` and by the frontend lift test as a staged file.
    "activation.json",
])

# Shared by every surface suite on both sides.
rust_library(
    name = "test-fixtures",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["activation.json"],
    crate_name = "brenn_surface_test_fixtures",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True) + [
        "//brenn-envelope",
        "//surface/contract",
    ],
)

rust_test(
    name = "test-fixtures_test",
    crate = ":test-fixtures",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    target_compatible_with = HOST_ONLY,
    deps = all_crate_deps(normal_dev = True),
)

rust_doc_test(
    name = "test-fixtures_doc_test",
    crate = ":test-fixtures",
    target_compatible_with = HOST_ONLY,
)
