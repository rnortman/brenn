load("//bazel/policy:defs.bzl", "policy_srcs")
load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")

policy_srcs()

exports_files(["Cargo.toml"])

rust_library(
    name = "brenn-mqtt",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    visibility = ["//visibility:public"],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True) + [
        "//brenn-db",
        "//brenn-lib",
        "//brenn-messaging-store",
    ],
)

# 69 tests, all in-process: payload classification, session bookkeeping under
# tokio's test runtime, and egress enforcement over an in-memory sqlite. No
# broker is spawned here — that is `:mqtt_integration`. 0.05s locally against a
# 60s budget, so `small` holds with room on a cold 4-vCPU runner.
#
# The test binary links brenn-lib with `testutils` for the resolved-client-config
# fixture and the grant-set builders; the release configs clear the flag.
rust_test(
    name = "brenn-mqtt_test",
    size = "small",
    crate = ":brenn-mqtt",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True) + [
        "//brenn-db",
        "//brenn-lib",
        "//brenn-messaging-store",
    ],
)

# The MQTT suite spawns a real mosquitto per test and talks to it over
# loopback. mosquitto stays a system binary — it is the one non-hermetic
# dependency left — and the env gate is set here so a missing broker fails the
# test instead of skipping it. Dropping the gate does not quietly restore the
# skip: the suite panics when the gate is unset under Bazel's test runner.
#
# PATH is pinned because a test action's default is a fixed
# `/bin:/usr/bin:/usr/local/bin`, not the invoking shell's, and Debian-family
# packaging installs the daemon at /usr/sbin/mosquitto — off that list, so the
# harness's PATH lookup misses on a host where the install succeeded. The two
# sbin directories are appended to Bazel's own default rather than replacing it.
# A static string, so the action key stays machine-independent; the operator's
# BRENN_MOSQUITTO_BIN override reaches the test through .bazelrc's --test_env.
#
# `medium` (300s): 15 tests, each spawning its own broker and waiting for it to
# bind a TLS port, finish in 1.3s locally. The budget is sized for the readiness
# wait, not the assertions — a loaded runner pays seconds per spawn, not minutes.
rust_test(
    name = "mqtt_integration",
    size = "medium",
    srcs = ["tests/mqtt_integration.rs"] + glob(["tests/common/*.rs"]),
    crate_root = "tests/mqtt_integration.rs",
    data = glob(["tests/mqtt_assets/**"]),
    edition = "2024",
    env = {
        "BRENN_MQTT_INTEGRATION": "1",
        "PATH": "/bin:/usr/bin:/usr/local/bin:/usr/sbin:/usr/local/sbin",
    },
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    rustc_env = {"CARGO_MANIFEST_DIR": "brenn-mqtt"},
    tags = ["requires-network"],
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + [
        ":brenn-mqtt",
        "//brenn-db",
        "//brenn-lib",
        "//brenn-messaging-store",
    ],
)

rust_doc_test(
    name = "brenn-mqtt_doc_test",
    crate = ":brenn-mqtt",
)
