load("//bazel/features:defs.bzl", "TESTUTILS_FEATURES")
load("//bazel/policy:defs.bzl", "policy_srcs")
load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")

policy_srcs()

exports_files(["Cargo.toml"])

# `testutils` exposes `test_support` — the mosquitto harness — to the crates
# above; the release configurations clear the flag.
rust_library(
    name = "brenn-mqtt",
    srcs = glob(["src/**/*.rs"]),
    crate_features = TESTUTILS_FEATURES,
    edition = "2024",
    visibility = ["//visibility:public"],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True) + [
        "//brenn-db",
        "//brenn-envelope",
        "//brenn-lib",
        "//brenn-messaging-store",
    ],
)

# 94 tests, all in-process: payload classification, session bookkeeping under
# tokio's test runtime, and egress enforcement over an in-memory sqlite. No
# broker is spawned here — that is `:mqtt_integration`. 0.08s locally against a
# 60s budget, so `small` holds with room on a cold 4-vCPU runner. The count is
# `.bazel-bin/brenn-mqtt/brenn-mqtt_test --list`'s own total, which is what to
# re-read rather than increment; the timing is the load-bearing half.
#
# The test binary links brenn-lib with `testutils` for the resolved-client-config
# fixture and the grant-set builders; the release configs clear the flag.
rust_test(
    name = "brenn-mqtt_test",
    size = "small",
    crate = ":brenn-mqtt",
    crate_features = ["testutils"],
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True) + [
        "//brenn-db",
        "//brenn-envelope",
        "//brenn-lib",
        "//brenn-messaging-store",
    ],
)

# The MQTT suite spawns a real mosquitto per test and talks to it over
# loopback. The broker is //bazel/tools:mosquitto, built from the source
# tarball MODULE.bazel pins and handed over as a declared input:
# BRENN_MOSQUITTO_BIN is its runfile path. Dropping the `data` entry or the
# `env` entry fails every case at spawn with a message naming this target.
# `requires-network` lets the sandbox reach loopback.
#
# `medium` (300s): each test spawns its own broker and waits for it to bind a
# TLS port; the suite finishes in seconds locally. The budget is sized for the readiness
# wait, not the assertions — a loaded runner pays seconds per spawn, not minutes.
rust_test(
    name = "mqtt_integration",
    size = "medium",
    srcs = ["tests/mqtt_integration.rs"] + glob(["tests/common/*.rs"]),
    crate_root = "tests/mqtt_integration.rs",
    data = glob(["tests/mqtt_assets/**"]) + ["//bazel/tools:mosquitto"],
    edition = "2024",
    # BRENN_MQTT_INTEGRATION is brenn_mqtt::test_support::BROKER_GATE, read by
    # broker_available(); dropping it here turns every broker case into a panic
    # rather than a silent skip.
    env = {
        "BRENN_MOSQUITTO_BIN": "$(rootpath //bazel/tools:mosquitto)",
        "BRENN_MQTT_INTEGRATION": "1",
    },
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    rustc_env = {"CARGO_MANIFEST_DIR": "brenn-mqtt"},
    tags = ["requires-network"],
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + [
        ":brenn-mqtt",
        "//brenn-db",
        "//brenn-envelope",
        "//brenn-lib",
        "//brenn-messaging-store",
    ],
)

rust_doc_test(
    name = "brenn-mqtt_doc_test",
    crate = ":brenn-mqtt",
)
