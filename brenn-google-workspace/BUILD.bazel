load("//bazel/features:defs.bzl", "TESTUTILS_FEATURES")
load("//bazel/policy:defs.bzl", "policy_srcs")
load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("@wasm_crates//:defs.bzl", wasm_crate_deps = "all_crate_deps")

policy_srcs()

exports_files(["Cargo.toml"])

# Where the guest cargo workspace reaches these sources from. Its hub keys this
# crate's dependency entry under that path.
GUEST_WORKSPACE_PATH = "brenn-wasm/components/host-crates/brenn-google-workspace"

# The host graph's build. Nothing links it; it exists for the crate's own
# tests, whose kit fixtures come from the host kit's `testutils`. Its own
# `testutils` carries `testutil`; the release configs clear the flag.
rust_library(
    name = "brenn-google-workspace",
    srcs = glob(["src/**/*.rs"]),
    # `testutil`'s Calendar event fixture.
    compile_data = ["src/fixtures/event.json"],
    crate_features = TESTUTILS_FEATURES,
    edition = "2024",
    deps = all_crate_deps(normal = True) + [
        "//brenn-cal",
        "//brenn-provider-kit",
    ],
)

rust_test(
    name = "brenn-google-workspace_test",
    crate = ":brenn-google-workspace",
    crate_features = ["testutils"],
    # The guide's config-map test reads the guide from the repository root.
    data = ["//docs:google-workspace.md"],
    edition = "2024",
    rustc_env = {"CARGO_MANIFEST_DIR": package_name()},
    deps = all_crate_deps(normal_dev = True),
)

# The guest graph's build of the same sources, against the guest hub's serde
# and the guest kit. It carries no platform constraint: the component cdylibs
# link it under wasm32, and the components' host `logic_test`s link it on the
# host, where their kit and serde are the guest hub's too. `testutils` gives
# those tests `testutil`.
rust_library(
    name = "brenn-google-workspace_guest",
    srcs = glob(["src/**/*.rs"]),
    # `testutil`'s Calendar event fixture.
    compile_data = ["src/fixtures/event.json"],
    crate_features = TESTUTILS_FEATURES,
    crate_name = "brenn_google_workspace",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = wasm_crate_deps(
        normal = True,
        package_name = GUEST_WORKSPACE_PATH,
    ) + [
        "//brenn-cal",
        "//brenn-provider-kit:brenn-provider-kit_guest",
    ],
)
