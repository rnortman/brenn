/// The `blobs` interface's test fixture. Every new text message on `in` is a
/// script of commands, separated by newlines or `;`, run in order against the
/// blob calls; the result of each is reported in one untyped JSON message on
/// `report`, published after every other publish of the activation. `a` and
/// `b` are the ports its publishes name. `feed`, when bound, is a window a
/// script opens attachments in (`feed:<index>`); only `in` runs a script.
component ProcessorBlobsTest {
  abi = processor;
  requires = [ports, log, blobs];
  in in;
  optional in feed;
  out report;
  out a;
  out b;
}
