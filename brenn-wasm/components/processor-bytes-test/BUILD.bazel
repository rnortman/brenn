load("@wasm_crates//:defs.bzl", "all_crate_deps")
load("//bazel/policy:defs.bzl", "policy_srcs")
load("//bazel/wasm:defs.bzl", "grant_parity_test", "wasm_component", "wasm_guest_cdylib")

policy_srcs()

# Bindings come from `wit_bindgen::generate!` over the 0.2.0 world, which reads
# both WIT files at macro-expansion time.
wasm_guest_cdylib(
    name = "brenn-processor-bytes-test",
    compile_data = ["//brenn-wasm:wit"],
    visibility = ["//visibility:public"],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True),
)

wasm_component(
    name = "component",
    module = ":brenn-processor-bytes-test",
    visibility = ["//visibility:public"],
)

# The fixture is test-only and never packaged, so its specification is held to
# its imports here.
grant_parity_test(
    name = "grant_parity",
    component = ":component",
    spec = "spec/processor-bytes-test.brenn",
)
