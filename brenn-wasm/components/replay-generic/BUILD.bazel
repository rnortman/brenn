load("@wasm_crates//:defs.bzl", "all_crate_deps")
load("//bazel/policy:defs.bzl", "policy_srcs")
load(
    "//bazel/wasm:defs.bzl",
    "wasm_component",
    "wasm_guest_cdylib",
)

policy_srcs()

# TODO(wasm-guest-tests-unrun): the 5 `#[test]` functions in src/lib.rs have no
# runner — this package declares no Rust test target and no rule runs a wasm32
# test binary. Done = they run under a gate, or they are deleted.
wasm_guest_cdylib(
    name = "brenn-replay-generic",
    shared_bindings = "//brenn-wasm:replay_bindings",
    edition = "2021",
    visibility = ["//visibility:public"],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True),
)

wasm_component(
    name = "component",
    module = ":brenn-replay-generic",
    visibility = ["//visibility:public"],
)
