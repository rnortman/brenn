load("@wasm_crates//:defs.bzl", "all_crate_deps")
load("//bazel/policy:defs.bzl", "policy_srcs")
load("//bazel/wasm:defs.bzl", "guest_spec_scaffold", "wasm_component", "wasm_guest_cdylib")

policy_srcs()

# The canonical transcript script, read by the host suite and by the surface
# half so both drive the component from one source.
exports_files(["transplant.json"])

# The probe's source, for `//surface/contract`'s test that every port a staged
# kind listens on is declared `sync` in its specification. The probe listens on
# none; the test reads every staged kind so that the one that starts listening
# is read without a build edit.
exports_files(["src/lib.rs"])

# Bindings come from the brenn-guest SDK's `generate!`; this crate names no
# WIT of its own.
# The port surface, generated from the authored specification this
# component ships with. Untracked: the specification is the source, and
# editing it stops this crate compiling until the guest keeps up.
guest_spec_scaffold(
    name = "spec",
    spec = "//:config/specs/processor-transplant.brenn",
)

wasm_guest_cdylib(
    name = "brenn-processor-transplant",
    generated_srcs = {"src/spec.rs": ":spec"},
    visibility = ["//visibility:public"],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True) + [
        "//brenn-wasm/components/guest:brenn-guest",
    ],
)

wasm_component(
    name = "component",
    module = ":brenn-processor-transplant",
    visibility = ["//visibility:public"],
)
