      "publishes": [
        "{\"ports\":[{\"port\":\"in\",\"ids\":[\"00000000-0000-0000-0000-000000000007\"],\"new_from\":0,\"dropped\":0},{\"port\":\"ctx\",\"ids\":[],\"new_from\":0,\"dropped\":0}],\"deferred\":[{\"port\":\"out\",\"entries\":[{\"index\":0,\"payload\":\"parked:60000\",\"deliver_after\":1767225660000},{\"index\":1,\"payload\":\"parked:900000\",\"deliver_after\":1767226500000}]}],\"now\":1767225660000,\"greeting\":\"hello, transplant\",\"absent\":null}"
      ],
