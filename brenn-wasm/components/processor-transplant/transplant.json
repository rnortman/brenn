        "{\"ports\":[{\"port\":\"in\",\"ids\":[\"00000000-0000-0000-0000-000000000008\"],\"new_from\":0,\"dropped\":0},{\"port\":\"ctx\",\"ids\":[],\"new_from\":0,\"dropped\":0}],\"deferred\":[{\"port\":\"out\",\"entries\":[{\"index\":0,\"payload\":\"edited@0\",\"deliver_after\":1767225780000},{\"index\":1,\"payload\":\"parked:900000\",\"deliver_after\":1767226500000}]}],\"now\":1767225700000,\"greeting\":\"hello, transplant\",\"absent\":null}"
      ],
