load("@wasm_crates//:defs.bzl", "all_crate_deps")
load("//bazel/policy:defs.bzl", "policy_srcs")
load("//bazel/wasm:defs.bzl", "wasm_guest_library")

policy_srcs()

# The SDK source, for the gesture-seam pin in `//surface/contract`. That crate
# spells the kernel's half of the gesture body and this one spells the guest's;
# a wasm32 crate with no test target cannot assert the pair itself, so the
# contract's test reads this file.
exports_files(["src/lib.rs"])

# The guest-side SDK. Every Family B component links this rlib, which owns the
# `brenn:processor` bindings; `wit_bindgen::generate!` reads the WIT world at
# macro-expansion time, so it is compile_data rather than a generated source.
wasm_guest_library(
    name = "brenn-guest",
    compile_data = ["//brenn-wasm:wit"],
    visibility = ["//visibility:public"],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True) + ["//brenn-envelope:brenn-envelope_wasm"],
)

# The guest graph's serde instance, for crates outside this repository.
#
# brenn-guest's public API is expressed in serde types: `push_events::<T:
# Serialize>` and the spec-generated `PushEventsPayload` marker. A derive
# written against a serde from another module's hub produces impls for a
# different crate instance and satisfies none of those bounds — the same
# reason `//brenn-envelope` is built once per graph. A downstream component
# names these two targets in place of a serde of its own; the alias set is
# exactly the third-party crates that appear in brenn-guest's public API.
alias(
    name = "serde",
    actual = "@wasm_crates//:serde",
    visibility = ["//visibility:public"],
)

alias(
    name = "serde_json",
    actual = "@wasm_crates//:serde_json",
    visibility = ["//visibility:public"],
)
