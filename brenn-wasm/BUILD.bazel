load("//bazel/policy:defs.bzl", "policy_srcs")
load("//bazel/wasm:defs.bzl", "component_fixtures", "component_install_tree", "component_package", "deployed_components_test", "grant_parity_test", "module_file_name", "wit_bindgen_rust")
load("@bazel_skylib//rules:native_binary.bzl", "native_test")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")

policy_srcs()

# Every component the tree builds, deployed or test-only. Adding a component
# crate means adding it here, which is what gives it a fixture target for the
# suites that load it directly.
COMPONENT_NAMES = [
    "git-forge-parser",
    "git-sync-consumer",
    "processor-config",
    "processor-demo",
    "processor-dual",
    "processor-exhaust",
    "processor-log",
    "processor-mem-exhaust",
    "processor-mqtt-test",
    "processor-multiport",
    "processor-store-rt",
    "processor-tool-test",
    "processor-transplant",
    "replay",
    "replay-fault-test",
    "replay-generic",
]

# The package every shipped component installs as: a directory named for the
# component, holding the artifact, its binding record, and — for a
# processor-world component — the specification its author wrote, copied
# verbatim. The dict key is the package name, which is both the directory's
# basename and the `@<name>` a configuration imports the class from. One entry
# per manifest entry and no more: a test-only component is never installed, so
# it has nothing to bind.
#
# The world is declared here rather than inferred, and the emitter refuses a
# declaration the artifact's own imports contradict.
COMPONENT_PACKAGES = {
    "git-forge-parser": ("brenn:processor", "//:config/specs/git-forge-parser.brenn"),
    "git-sync-consumer": ("brenn:processor", "//:config/specs/git-sync-consumer.brenn"),
    "processor-demo": ("brenn:processor", "//:config/specs/processor-demo.brenn"),
    # Replay components have no component class, no ports and no grants, so
    # their packages are artifact plus record and nothing else.
    "replay": ("brenn:replay", None),
    "replay-generic": ("brenn:replay", None),
}

# The specifications the packages above ship, as names. `config/specs/` is a
# mixed directory — what a consumer compiles against is the glob `//:modules`,
# what a release stages is harvested off packages and kinds plus the listed
# library modules — and `//bazel/release/tests:config_specs_accounted_test`
# holds the two equal by reading this list and its two siblings.
write_file(
    name = "package_spec_names",
    out = "package-spec-names.txt",
    content = sorted([
        module_file_name(spec)
        for (_world, spec) in COMPONENT_PACKAGES.values()
        if spec
    ]),
    visibility = ["//visibility:public"],
)

[
    component_package(
        name = "package_" + name.replace("-", "_"),
        component = "//brenn-wasm/components/{}:component".format(name),
        package = name,
        spec = spec,
        visibility = ["//visibility:public"],
        world = world,
    )
    for name, (world, spec) in COMPONENT_PACKAGES.items()
]

PACKAGES = [
    ":package_" + name.replace("-", "_")
    for name in COMPONENT_PACKAGES
]

# The third edge of the grant triangle, one target per packaged component that
# has a specification to be held to. Generated from the same dict the packages
# are, so a component cannot be packaged without acquiring the gate.
#
# Replay-world packages declare no specification and are skipped here as they
# are everywhere: they have no class, no ports and no grants, so there is no
# `requires` list to compare an import profile against.
[
    grant_parity_test(
        name = "grant_parity_" + name.replace("-", "_"),
        component = "//brenn-wasm/components/{}:component".format(name),
        spec = spec,
    )
    for name, (_, spec) in COMPONENT_PACKAGES.items()
    if spec
]

# The same components root a deployment installs, staged in one directory so a
# server run from the workspace — `make launchdev`, `make e2e` — can pass it as
# `--components` and resolve a component through the real package verification.
component_install_tree(
    name = "install_tree",
    packages = PACKAGES,
    visibility = ["//visibility:public"],
)

# What the release tree stages, one directory per package the manifest names.
filegroup(
    name = "packages",
    srcs = PACKAGES,
    visibility = ["//visibility:public"],
)

deployed_components_test(
    name = "deployed_components_test",
    manifest = "deployed-components.txt",
    packages = PACKAGES,
)

# One fixture target per component, never a bundle. Runfiles are part of a test
# action's key, so a group is an edge from every component to every test target
# that names it: editing one guest crate would re-run suites that never load it,
# and on `//brenn-server:brenn-server_test` that is ~2,500 tests. Singletons let
# each consumer name exactly what it opens.
#
# Singletons are also the only shape the rule admits. It declares its outputs at
# a fixed package-relative path (`target/components/<basename>`), so two
# instances listing the same component would declare the same artifact — an
# analysis-time conflict. Disjoint by construction is what one component per
# instance buys.
#
# A misspelling in a consumer's fixture list fails at load time.
[
    component_fixtures(
        name = "fixture_" + name.replace("-", "_"),
        components = ["//brenn-wasm/components/{}:component".format(name)],
        visibility = ["//visibility:public"],
    )
    for name in COMPONENT_NAMES
]

# The fixtures that are not guest crates of this tree: the page-hosted surface
# kinds, staged here because the wasmtime-driven transcript suite that drives
# their DOM behaviour lives beside the other wasmtime suites. Named on their own
# rather than folded into `COMPONENT_NAMES`, which is the list of components
# *this* directory builds.
_SURFACE_FIXTURES = {
    "echo-stub": "//surface/components/echo-stub:echo-stub_component",
    "meeting": "//surface/components/meeting:meeting_component",
    "chrome": "//surface/chrome:chrome_component",
}

[
    component_fixtures(
        name = "fixture_" + kind.replace("-", "_"),
        components = [component],
        visibility = ["//visibility:public"],
    )
    for kind, component in _SURFACE_FIXTURES.items()
]

FIXTURES = {
    name: "//brenn-wasm:fixture_" + name.replace("-", "_")
    for name in COMPONENT_NAMES + _SURFACE_FIXTURES.keys()
}

exports_files([
    "Cargo.toml",
    # The deploy manifest: read by the packaging rule and shipped beside the
    # packages it names.
    "deployed-components.txt",
])

# The WIT gates over every built component: the artifact imports nothing from
# `wasi:`, and the world it carries is still the world its WIT source declares.
#
# The second is the one no build-system soundness replaces. Both families'
# bindings are generated, so comparing generated bytes against generated bytes
# sees nothing when the generator or the encoder moves the guest-visible world;
# the source side here is the hand-written WIT.
#
# The runner starts in its runfiles tree, so `--root .` names a staged root
# holding exactly three things: the fixtures at the artifact path, the guest
# workspace's manifests (which say who the members are and which WIT each raw
# crate generates from), and the WIT worlds themselves.
native_test(
    name = "wit_gates",
    size = "small",
    src = "//xtask",
    args = [
        "check-wit",
        "--root",
        ".",
    ],
    data = [
        ":wit",
        "//brenn-wasm/components:Cargo.toml",
    ] + [
        FIXTURES[name]
        for name in COMPONENT_NAMES
    ] + [
        "//brenn-wasm/components/{}:policy_srcs".format(name)
        for name in COMPONENT_NAMES + ["guest"]
    ],
    out = "wit_gates.run",
)

# Individually addressable so a raw-WIT crate can name the one world it
# generates from; the filegroup below is what the action reads.
exports_files(glob(["wit/**/*.wit"]))

# The WIT worlds, read at macro-expansion time by both sides of the boundary:
# wasmtime's `bindgen!` here, `wit_bindgen::generate!` in the guest SDK.
filegroup(
    name = "wit",
    srcs = glob(["wit/**/*.wit"]),
    visibility = ["//visibility:public"],
)

# Generated once and copied into each crate that compiles the `brenn:processor`
# world directly, without the guest SDK: processor-exhaust,
# processor-mem-exhaust, processor-mqtt-test, processor-tool-test.
wit_bindgen_rust(
    name = "processor_bindings",
    out = "processor_bindings.rs",
    visibility = ["//brenn-wasm/components:__subpackages__"],
    wit = "wit/processor.wit",
    wit_srcs = ":wit",
)

# Generated once and copied into each crate that compiles the `brenn:replay`
# world directly, without the guest SDK: replay, replay-generic,
# replay-fault-test.
wit_bindgen_rust(
    name = "replay_bindings",
    out = "replay_bindings.rs",
    visibility = ["//brenn-wasm/components:__subpackages__"],
    wit = "wit/replay.wit",
    wit_srcs = ":wit",
)

# The wasmtime host. The guest components it loads are a separate cargo
# workspace under this directory, built for wasm32.
rust_library(
    name = "brenn-wasm",
    srcs = glob(["src/**/*.rs"]),
    compile_data = [":wit"],
    edition = "2024",
    visibility = ["//visibility:public"],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True) + [
        "//brenn-activation",
        "//brenn-budget",
        "//brenn-common",
        "//brenn-envelope",
    ],
)

# `size = "large"` for the same reason as the suites below: 12.1s locally under
# the same concurrent run, ~250s at the same ~21x factor — inside `medium`, but
# by less than the factor's own uncertainty. It has not timed out on the runner.
#
# No fixtures: the in-crate unit tests build engines and stores directly and
# open no component artifact — every `env!("CARGO_MANIFEST_DIR")/target/
# components/` call site is in the `tests/` suites below. A unit test that grows
# one fails here on a missing runfile, which is the direction to be wrong in.
rust_test(
    name = "brenn-wasm_test",
    size = "large",
    crate = ":brenn-wasm",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    rustc_env = {"CARGO_MANIFEST_DIR": "brenn-wasm"},
    deps = all_crate_deps(normal_dev = True) + ["//brenn-cal"],
)

# Each suite's fixture list must match the components its source opens; a guest
# crate's edit then re-runs the suites that load it and no others.
#
# TODO(bazel-fixture-list-guard): the match is hand-held. A suite that stages a
# component it no longer opens keeps the invalidation edge and nothing reports
# it, so these lists drift back toward all-to-all one commit at a time. The
# other direction is loud — a missing fixture is a missing runfile.
#
# `(suite, fixtures, extra_data, extra_deps, extra_compile_data)`: the last two
# carry what one suite needs and the others must not inherit, for the same
# reason `extra_data` does. A suite reading the WIT at macro-expansion time
# names `:wit` itself, so a `processor.wit` edit re-runs that suite alone.
WASM_TEST_SUITES = [
    (
        "surface_dom",
        [
            "chrome",
            "echo-stub",
            "meeting",
            "processor-config",
            "processor-log",
        ],
        [],
        [
            "//surface/chrome",
            "//surface/components/meeting",
            "//surface/page-harness",
        ],
        [],
    ),
    (
        "consume_engine",
        [
            "processor-demo",
            "processor-dual",
            "processor-exhaust",
            "processor-mem-exhaust",
            "processor-multiport",
            "processor-store-rt",
        ],
        [],
        [],
        [],
    ),
    ("feature_envelope", ["processor-demo", "replay"], [], [], []),
    (
        "grants",
        [
            "processor-config",
            "processor-demo",
            "processor-dual",
            "processor-exhaust",
            "processor-log",
            "processor-mem-exhaust",
            "processor-multiport",
            "processor-store-rt",
        ],
        [],
        [],
        [],
    ),
    ("instantiation_fail", ["processor-exhaust"], [], [], []),
    ("processor_config", ["processor-config"], [], [], []),
    ("processor_log", ["processor-log"], [], [], []),
    ("processor_mqtt", ["processor-mqtt-test"], [], [], []),
    (
        "processor_transplant",
        ["processor-transplant"],
        ["//brenn-wasm/components/processor-transplant:transplant.json"],
        [],
        [],
    ),
    ("replay_engine", ["replay"], [], [], []),
    ("replay_engine_bounds", ["replay", "replay-fault-test"], [], [], []),
    ("replay_generic_engine", ["replay-generic"], [], [], []),
    ("store_round_trip", ["replay-fault-test"], [], [], []),
]

# Sized `large` (900s ceiling, ~300MB resource estimate) as a family.
#
# Observed, not assumed: on the CD runner `processor_mqtt` and
# `replay_engine_bounds` were killed at the `medium` 300s ceiling and
# `replay_engine` passed at 172s; no other suite has timed out.
#
# Baselines, all 20 brenn-wasm test targets run concurrently on a developer host
# (`bazel test //brenn-wasm:all --nocache_test_results`, seconds):
#
#     grants                27.8    processor_log        15.6
#     replay_engine         24.9    surface_dom          15.4
#     replay_engine_bounds  22.8    brenn-wasm_test      12.1
#     consume_engine        22.6    processor_mqtt        9.9
#     replay_generic_engine 18.5    store_round_trip      7.0
#     processor_config      17.2    instantiation_fail    3.0
#     processor_transplant  16.8    echo_stub_dom         0.6
#     feature_envelope      16.5
#
# At the one local-to-runner factor this repo has measured (~21x,
# `surface/server/BUILD.bazel`) ten of these clear the `medium` 300s ceiling, so
# the family is not a heavy head with a cheap tail — the median suite is 16s
# locally and does not fit. That factor is also conservative here: `replay_engine`
# at 24.9s locally ran 172s on the runner, a factor of ~7.
#
# Sized as a family for that reason and two more: the factor is a single
# measurement on one runner, a suite here is dominated by compiling guest
# components inside the test binary so they scale together, and buying the margin
# per suite would put every suite one fixture away from another CI timeout round.
#
# The resource estimate is wanted too, not just the ceiling: these binaries hold
# cranelift-compiled engines, so ~300MB each is honest, and the test parallelism
# it costs on a small runner is the intended trade — that is why this is `size`
# and not `timeout`, which raises the ceiling while still claiming a `medium`
# appetite. Hang-detection latency for these suites is 900s as a consequence.
#
# A suite that starts taking far longer than the numbers above is a regression,
# not an expected cost of this sizing — and nothing here can tell: every suite has
# the same 900s ceiling, so a 10x slowdown (a replay fuel/epoch regression, a
# fixture rebuilt per test) passes silently until it crosses it.
#
# TODO(wasm-test-wall-time-baselines): make the table above data a check reads,
# failing when a suite exceeds its baseline by a chosen factor, instead of prose
# nobody diffs. Not a per-suite `timeout` split: at the ~21x factor the median
# suite does not fit `moderate` either, so that would trade the missing signal
# for CI flakes.
[
    rust_test(
        name = suite,
        size = "large",
        srcs = ["tests/{}.rs".format(suite)] + glob(["tests/common/*.rs"]),
        compile_data = extra_compile_data,
        crate_root = "tests/{}.rs".format(suite),
        data = [FIXTURES[c] for c in fixtures] + extra_data,
        edition = "2024",
        proc_macro_deps = all_crate_deps(
            proc_macro = True,
            proc_macro_dev = True,
        ),
        rustc_env = {"CARGO_MANIFEST_DIR": "brenn-wasm"},
        deps = all_crate_deps(
            normal = True,
            normal_dev = True,
        ) + [
            ":brenn-wasm",
            "//brenn-activation",
            "//brenn-budget",
            "//brenn-cal",
            "//brenn-common",
            "//brenn-envelope",
        ] + extra_deps,
    )
    for suite, fixtures, extra_data, extra_deps, extra_compile_data in WASM_TEST_SUITES
]

rust_doc_test(
    name = "brenn-wasm_doc_test",
    crate = ":brenn-wasm",
)
