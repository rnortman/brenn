load("//bazel/policy:defs.bzl", "policy_srcs")
load("//bazel/wasm:defs.bzl", "component_fixtures", "component_package", "deployed_components_test")
load("@bazel_skylib//rules:native_binary.bzl", "native_test")
load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")

policy_srcs()

# Every component the tree builds, deployed or test-only. Adding a component
# crate means adding it here; the deploy manifest is checked against this list.
COMPONENT_NAMES = [
    "git-forge-parser",
    "git-sync-consumer",
    "processor-config",
    "processor-demo",
    "processor-dual",
    "processor-exhaust",
    "processor-log",
    "processor-mem-exhaust",
    "processor-mqtt-test",
    "processor-multiport",
    "processor-store-rt",
    "processor-tool-test",
    "processor-transplant",
    "replay",
    "replay-fault-test",
    "replay-generic",
]

COMPONENTS = [
    "//brenn-wasm/components/{}:component".format(name)
    for name in COMPONENT_NAMES
]

filegroup(
    name = "components",
    srcs = COMPONENTS,
    visibility = ["//visibility:public"],
)

# The sidecars every shipped component installs with: its binding record, and —
# for a processor-world component — the specification its author wrote, copied
# verbatim under the artifact's stem. One instance per manifest entry and no
# more: a test-only component is never installed, so it has nothing to bind.
#
# The world is declared here rather than inferred, and the emitter refuses a
# declaration the artifact's own imports contradict.
COMPONENT_PACKAGES = {
    "git-forge-parser": ("brenn:processor", "//:config/specs/git-forge-parser.brenn"),
    "git-sync-consumer": ("brenn:processor", "//:config/specs/git-sync-consumer.brenn"),
    "processor-demo": ("brenn:processor", "//:config/specs/processor-demo.brenn"),
    # Replay components have no component class, no ports and no grants, so
    # their packages are artifact plus record and nothing else.
    "replay": ("brenn:replay", None),
    "replay-generic": ("brenn:replay", None),
}

[
    component_package(
        name = "package_" + name.replace("-", "_"),
        component = "//brenn-wasm/components/{}:component".format(name),
        spec = spec,
        visibility = ["//visibility:public"],
        world = world,
    )
    for name, (world, spec) in COMPONENT_PACKAGES.items()
]

PACKAGES = [
    ":package_" + name.replace("-", "_")
    for name in COMPONENT_PACKAGES
]

# What the release tree stages beside the artifacts the manifest names.
filegroup(
    name = "packages",
    srcs = PACKAGES,
    visibility = ["//visibility:public"],
)

deployed_components_test(
    name = "deployed_components_test",
    components = COMPONENTS,
    manifest = "deployed-components.txt",
    packages = PACKAGES,
)

# One fixture target per component, never a bundle. Runfiles are part of a test
# action's key, so a group is an edge from every component to every test target
# that names it: editing one guest crate would re-run suites that never load it,
# and on `//brenn-server:brenn-server_test` that is ~2,500 tests. Singletons let
# each consumer name exactly what it opens.
#
# Singletons are also the only shape the rule admits. It declares its outputs at
# a fixed package-relative path (`target/components/<basename>`), so two
# instances listing the same component would declare the same artifact — an
# analysis-time conflict. Disjoint by construction is what one component per
# instance buys.
#
# A misspelling in a consumer's fixture list fails at load time.
[
    component_fixtures(
        name = "fixture_" + name.replace("-", "_"),
        components = ["//brenn-wasm/components/{}:component".format(name)],
        visibility = ["//visibility:public"],
    )
    for name in COMPONENT_NAMES
]

FIXTURES = {
    name: "//brenn-wasm:fixture_" + name.replace("-", "_")
    for name in COMPONENT_NAMES
}

exports_files([
    "Cargo.toml",
    # The deploy manifest: read by the packaging rule and shipped beside the
    # artifacts it names.
    "deployed-components.txt",
])

# The WIT gates over every built component: the artifact imports nothing from
# `wasi:`, and the world it carries is still the world its WIT source declares.
#
# The second is the one no build-system soundness replaces. Both families'
# bindings are generated, so comparing generated bytes against generated bytes
# sees nothing when the generator or the encoder moves the guest-visible world;
# the source side here is the hand-written WIT.
#
# The runner starts in its runfiles tree, so `--root .` names a staged root
# holding exactly three things: the fixtures at the artifact path, the guest
# workspace's manifests (which say who the members are and which WIT each raw
# crate generates from), and the WIT worlds themselves.
native_test(
    name = "wit_gates",
    size = "small",
    src = "//xtask",
    args = [
        "check-wit",
        "--root",
        ".",
    ],
    data = [
        ":wit",
        "//brenn-wasm/components:Cargo.toml",
    ] + [
        FIXTURES[name]
        for name in COMPONENT_NAMES
    ] + [
        "//brenn-wasm/components/{}:policy_srcs".format(name)
        for name in COMPONENT_NAMES + ["guest"]
    ],
    out = "wit_gates.run",
)

# Individually addressable so a raw-WIT crate can name the one world it
# generates from; the filegroup below is what the action reads.
exports_files(glob(["wit/**/*.wit"]))

# The WIT worlds, read at macro-expansion time by both sides of the boundary:
# wasmtime's `bindgen!` here, `wit_bindgen::generate!` in the guest SDK.
filegroup(
    name = "wit",
    srcs = glob(["wit/**/*.wit"]),
    visibility = ["//visibility:public"],
)

# The wasmtime host. The guest components it loads are a separate cargo
# workspace under this directory, built for wasm32.
rust_library(
    name = "brenn-wasm",
    srcs = glob(["src/**/*.rs"]),
    compile_data = [":wit"],
    edition = "2024",
    visibility = ["//visibility:public"],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True) + [
        "//brenn-activation",
        "//brenn-budget",
        "//brenn-common",
        "//brenn-envelope",
    ],
)

# No fixtures: the in-crate unit tests build engines and stores directly and
# open no component artifact — every `env!("CARGO_MANIFEST_DIR")/target/
# components/` call site is in the `tests/` suites below. A unit test that grows
# one fails here on a missing runfile, which is the direction to be wrong in.
rust_test(
    name = "brenn-wasm_test",
    crate = ":brenn-wasm",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    rustc_env = {"CARGO_MANIFEST_DIR": "brenn-wasm"},
    deps = all_crate_deps(normal_dev = True) + ["//brenn-cal"],
)

# Each suite's fixture list must match the components its source opens; a guest
# crate's edit then re-runs the suites that load it and no others.
#
# TODO(bazel-fixture-list-guard): the match is hand-held. A suite that stages a
# component it no longer opens keeps the invalidation edge and nothing reports
# it, so these lists drift back toward all-to-all one commit at a time. The
# other direction is loud — a missing fixture is a missing runfile.
WASM_TEST_SUITES = [
    (
        "consume_engine",
        [
            "processor-demo",
            "processor-dual",
            "processor-exhaust",
            "processor-mem-exhaust",
            "processor-multiport",
            "processor-store-rt",
        ],
        [],
    ),
    ("feature_envelope", ["processor-demo", "replay"], []),
    (
        "grants",
        [
            "processor-config",
            "processor-demo",
            "processor-dual",
            "processor-exhaust",
            "processor-log",
            "processor-mem-exhaust",
            "processor-multiport",
            "processor-store-rt",
        ],
        [],
    ),
    ("instantiation_fail", ["processor-exhaust"], []),
    ("processor_config", ["processor-config"], []),
    ("processor_log", ["processor-log"], []),
    ("processor_mqtt", ["processor-mqtt-test"], []),
    (
        "processor_transplant",
        ["processor-transplant"],
        ["//brenn-wasm/components/processor-transplant:transplant.json"],
    ),
    ("replay_engine", ["replay"], []),
    ("replay_engine_bounds", ["replay", "replay-fault-test"], []),
    ("replay_generic_engine", ["replay-generic"], []),
    ("store_round_trip", ["replay-fault-test"], []),
]

[
    rust_test(
        name = suite,
        srcs = ["tests/{}.rs".format(suite)] + glob(["tests/common/*.rs"]),
        crate_root = "tests/{}.rs".format(suite),
        data = [FIXTURES[c] for c in fixtures] + extra_data,
        edition = "2024",
        proc_macro_deps = all_crate_deps(
            proc_macro = True,
            proc_macro_dev = True,
        ),
        rustc_env = {"CARGO_MANIFEST_DIR": "brenn-wasm"},
        deps = all_crate_deps(
            normal = True,
            normal_dev = True,
        ) + [
            ":brenn-wasm",
            "//brenn-activation",
            "//brenn-budget",
            "//brenn-cal",
            "//brenn-common",
            "//brenn-envelope",
        ],
    )
    for suite, fixtures, extra_data in WASM_TEST_SUITES
]

rust_doc_test(
    name = "brenn-wasm_doc_test",
    crate = ":brenn-wasm",
)
