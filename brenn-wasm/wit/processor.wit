package brenn:processor@0.1.0;

/// External ABI — out-of-tree components are first-class consumers of this
/// interface.
///
/// Evolution policy, in two regimes. Once an out-of-tree population exists,
/// evolution is additive-import-only: a new capability is a new interface, and
/// no existing shape moves. Until one exists, the world is in-tree vocabulary
/// and a shape change is a hard cut updated everywhere at once, with no compat
/// shim — the project's standing rule for internal contracts. The synchronous
/// channel below (`activation.sync` and `receive`'s reply) landed under the
/// second regime, together with the `dom` and `page-dom` interfaces.
///
/// The invariant this interface serves:
///
///   There is one component model. Any component runs on any host that can
///   satisfy its imports. Hosting eligibility is an import profile, not a
///   component kind.
///
/// A component importing `store`/`mqtt`/`tools` is backend-only; one importing
/// DOM capability is surface-only. Same rule, different import profile — not
/// two kinds of thing. Components see exactly one mechanism: messages on named
/// ports.
///
/// Host linking policy: each interface in `world processor` is linked
/// per-component only when the operator grants it (`grants` field in
/// `[[wasm_consumer]]`). Components should import only the interfaces they
/// actually use (import-GC removes unused imports from built artifacts);
/// importing an ungranted interface causes a named load-time panic. Version
/// matching follows wasmtime's semver-compatibility rule: same major.minor for
/// 0.x, same major for >=1.0.0.

interface types {
    /// One message in the window: the canonical MessageEnvelope serialized as
    /// JSON (UTF-8). The host does not parse `body` and does not pre-classify
    /// `envelope_type`; the guest parses it and fails deserialization if it
    /// does not understand the envelope.
    ///
    /// Envelope-type additivity policy: `envelope_type` is an OPEN string set.
    /// New values (e.g. `"ephemeral"`) are added additively and appear on the
    /// wire only together with the feature that can deliver them to guests —
    /// a guest never observes a value for a delivery class it cannot receive.
    /// Guests fail deserialization on an unrecognized envelope (the posture
    /// stated above), so an additive new value is safe for out-of-tree
    /// consumers by construction.
    type envelope-json = string;

    /// Element handle, minted by the host. The same element is always the same
    /// handle within one instance, and handle tables are per instance: a handle
    /// another instance minted names nothing here.
    ///
    /// A handle lives until its element is destroyed, which `remove` and
    /// `set-text` are the two ways of doing; using a handle after that traps.
    /// See the `dom` interface doc.
    ///
    /// Lives in `types` because both `dom` and `page-dom` speak it.
    type node = u64;

    /// Messages delivered on one logical input port for this activation.
    record port-window {
        /// Logical input port name from host config — never a raw channel address.
        port: string,

        /// Ordered list, oldest→newest, of MessageEnvelope JSON values for the
        /// delivering channel: the most-recent up-to-`max(push_depth,
        /// retain_depth)` messages the channel still retains. Entries from
        /// `new-from` onward are this invocation's new/unprocessed messages (at
        /// most `push_depth` of them); everything before `new-from` is RETAINED
        /// CONTEXT.
        ///
        /// Context is whatever else fits in that window, which is NOT bounded by
        /// `retain_depth` alone: a port with `retain_depth = 0` and a nonzero
        /// `push_depth` still receives context, back-filled with already-seen
        /// messages up to the window size. A port asking for more context than
        /// its push depth gets one window of `retain_depth` entries, not
        /// `retain_depth` context plus `push_depth` new.
        ///
        /// Context entries are channel-wide most-recent messages, NOT a
        /// per-subscriber delivered log — on a component's first window after
        /// (re)subscription the context MAY include channel messages this
        /// component was never individually delivered. Treat `new-from` as "the
        /// most-recent prior channel messages are provided as context here," NOT
        /// as "I have already processed everything before this index." A guest
        /// needing exactly-once-seen semantics must track its own high-water by
        /// `message_id`.
        ///
        /// ATTACH IS A DELIVERY POINT. When a port's queue comes into existence
        /// — the instance's first attach, a re-attach, or a binding added or
        /// rebound by a config change — the channel's retained tail, capped at
        /// `push_depth`, is delivered as NEW, not as context, and it wakes the
        /// component. A message published while the channel had no consumer
        /// therefore still reaches the consumer that attaches afterwards, so a
        /// guest MAY rely on the new set alone to catch up on attach. The
        /// corollary: a re-attach re-delivers as new what the guest already
        /// processed, so a guest whose handling is side-effecting MUST make it
        /// at-most-once by `message_id`.
        envelopes: list<envelope-json>,

        /// Index into `envelopes` of the first new/unprocessed message. Equals
        /// `envelopes` length when the window is pure context with no new messages.
        /// This is normal for sampled ports (`push_depth = 0`) and for triggering
        /// ports that had nothing unprocessed in this activation step.
        new-from: u32,

        /// Count of messages lost to push-overflow (`push_depth` exceeded:
        /// rolled past the push window before the component consumed them)
        /// since the previous successful invocation, so the guest can detect
        /// gaps. A backlog larger than `push_depth` is NOT held back for a
        /// later activation: the window serves the newest `push_depth` and the
        /// remainder is counted here.
        /// This is not a stored counter: it is the distance between the
        /// position the port held and the oldest message this window served,
        /// computed when the port's position advances over the window. How far
        /// back it can reach therefore depends on where that position lives.
        /// DURABLE CHANNELS (`brenn:`): the position is persisted, so a gap
        /// that straddles a host restart IS reflected in the first `dropped`
        /// reported after it. NON-DURABLE CHANNELS (`ephemeral:`, `local:`):
        /// channel and position both die with the host process, so `dropped`
        /// covers the current process lifetime only — there, `dropped == 0` is
        /// not proof of no-gap across a host lifetime.
        /// Always 0 for sampled ports (`push_depth = 0`), which hold no
        /// delivery position and therefore never experience push-overflow.
        dropped: u32,
    }

    /// One of this component's own parked (deferred) messages on an output
    /// port's channel — a message it published via `ports.publish-deferred`
    /// whose `deliver-after` has not yet arrived, so it is not yet observable to
    /// any subscriber, replay, or context read.
    record deferred-entry {
        /// Position of this entry within its `deferred-window.entries` list,
        /// which is ordered by `deliver-after` ascending. This is the index a
        /// future `defer-cancel`/`defer-edit` names; it is snapshot-relative and
        /// only valid against the window it arrived in.
        index: u32,
        /// The message BODY the component published (not an envelope) — the same
        /// opaque string it passed to `publish-deferred`.
        payload: string,
        /// The scheduled release time, epoch milliseconds UTC.
        deliver-after: u64,
    }

    /// The component's own parked messages on one output port's channel, a
    /// snapshot taken at drain, ordered by `deliver-after` ascending. Scoped to
    /// (this component's sender identity, the port's channel): a component sees
    /// only messages it itself parked, never a peer's, even on a shared channel.
    record deferred-window {
        /// Logical output port name from host config — never a raw channel address.
        port: string,
        entries: list<deferred-entry>,
    }

    /// One activation. Contains one `port-window` per bound input port, in
    /// the order declared in the consumer's config (`cfg.inputs` order). Every
    /// bound port appears in every activation; a port with no new messages
    /// arrives as a pure-context window (`new-from == envelopes` length).
    /// Guests must not assume `ports` has length 1.
    ///
    /// `deferred` carries one `deferred-window` per bound output port, in config
    /// (`cfg.outputs`) order — the component's own parked messages, so a guest
    /// can see, and (later) cancel/edit, what it scheduled. Inputs and this
    /// output-deferred view are separate typed lists: a future in/out port
    /// appears in both, additively.
    ///
    /// `now` is the host's wall clock at drain, epoch milliseconds UTC. It lets
    /// a guest compute an absolute `deliver-after` for `ports.publish-deferred`
    /// without holding a clock of its own — clock authority stays with the host.
    /// Both hostings supply it, read once per activation: the backend from the
    /// process clock, the surface page kernel from the device clock. It is `none`
    /// only on a host that exposes no UTC wall clock at all; a guest that needs
    /// deferred publish must handle `none` by declining to schedule rather than
    /// inventing an instant.
    ///
    /// `sync` names the live sync port when this is a **sync-call** activation:
    /// an ordinary activation plus a return obligation. It is `none` on every
    /// asynchronous delivery, which is every activation a message causes, and
    /// on every activation a backend host mints — a headless component has no
    /// cause that could be synchronous. The named port appears in `ports`
    /// carrying exactly one envelope, the live request, so a guest consumes it
    /// through the same window API as everything else. The obligation is
    /// `receive`'s reply: only a sync-call activation may answer.
    record activation {
        ports: list<port-window>,
        deferred: list<deferred-window>,
        now: option<u64>,
        sync: option<string>,
    }

    /// Outcome of processing the batch. A guest trap is a distinct,
    /// host-observed failure (not representable here).
    variant receive-error {
        /// Guest could not parse one of the envelope JSON values it was handed.
        malformed-envelope(string),
        /// Guest-defined processing failure with a diagnostic message.
        processing-failed(string),
    }
}

interface ports {
    variant publish-error {
        /// The publish was refused on authority, not on vocabulary: the
        /// component was not granted this interface, the call is outside an
        /// in-flight activation, or the channel bound to `port` fails the
        /// host's output ACL. The guest cannot target raw channel addresses —
        /// publish is port-name-only.
        ///
        /// A port the component's specification declares but the deployer left
        /// unwired is NOT this error; see `publish`.
        not-permitted,
        /// Payload failed host validation (e.g. oversize). Diagnostic string.
        invalid-payload(string),
        /// Publish budget exhausted: a per-sink token bucket, or a global
        /// per-activation backstop (message count or total bytes).
        quota-exceeded,
    }

    /// Message urgency — identical to RFC 8030 §5.3 ladder. Controls whether
    /// downstream subscribers are eagerly woken or let the message park until
    /// their next natural drain. Sender expresses intent; each subscriber's
    /// `wake_min` policy decides the actual wake behavior.
    enum urgency { very-low, low, normal, high }

    /// Buffer one message for the bus channel bound to `port`. `payload` is
    /// the message BODY only (opaque string) — not an envelope; the host
    /// assigns all envelope fields (message id, sender, publish timestamp,
    /// channel, envelope_type, urgency). Urgency is taken from the per-port
    /// configured default (`[[wasm_consumer]] [[output]] urgency`, default
    /// `normal`). Visibility is deferred: all of an activation's publishes
    /// flush atomically, in call order, iff receive returns ok; err/trap
    /// discards them all.
    ///
    /// `port` is answered against the port vocabulary of the component's
    /// specification — the ports it declares `out` or `io` — in three ways.
    /// A declared port the deployer wired to a channel publishes normally. A
    /// declared port the deployer left unwired returns ok and the message is
    /// dropped: publishing to nowhere is as legal as publishing to a channel
    /// nobody subscribes to, and wiring is the deployer's business, not the
    /// guest's. The drop still runs every check that does not need a channel —
    /// the payload cap and the per-activation budgets answer exactly as they
    /// would on a wired port. A port the specification does not declare at all
    /// is a contract violation: the component contradicts the specification its
    /// artifact is hash-bound to, and the host traps the activation rather than
    /// refuse the call.
    ///
    /// **Provenance / trust note:** Messages emitted via this import appear on
    /// the bus with `sender = "wasm:<slug>"` and `envelope_type = brenn`.
    /// External-origin content forwarded through a component (e.g. a webhook body
    /// republished as a brenn envelope) retains no marker of its external origin.
    /// Downstream subscribers that make trust decisions based on `envelope_type` or
    /// `sender` will treat forwarded external content as internally-originated.
    /// Operators MUST NOT bind a component's output port to a channel whose
    /// subscribers assume internal-only senders, unless the component is known to
    /// publish only internal-origin content. The sender of a republished message
    /// is the component that published it; trust derives from the operator-authored
    /// wiring and the ACLs it was granted, not from any per-message origin marker.
    publish: func(port: string, payload: string) -> result<_, publish-error>;

    /// Like `publish`, but with an explicit urgency override. Use when the
    /// guest has message-specific urgency intent that differs from the port
    /// default. Existing components compiled without this import keep working
    /// (additive WIT ABI — no package version bump).
    publish-with-urgency: func(port: string, payload: string, urgency: urgency)
        -> result<_, publish-error>;

    /// Buffer one message for the port's channel, held until `deliver-after`
    /// (epoch milliseconds UTC) before it becomes observable to any subscriber,
    /// replay, or context read. A `deliver-after` at or before the host's `now`
    /// (see `activation.now`) publishes immediately, exactly like `publish`.
    /// Urgency is the port default; use the sender-intent form via a later
    /// activation if an override is needed.
    ///
    /// This is the timer idiom: a component schedules a message to itself (or a
    /// peer) at a future instant, most commonly to wake itself again. Like
    /// `publish`, the call is BUFFERED and flushed atomically iff receive
    /// returns ok — an err/trap schedules nothing. The parked message is bounded
    /// channel-wide by the channel's retain depth; beyond that the flush drops
    /// the schedule (host-logged), since a post-activation flush has no error
    /// channel back to the guest.
    ///
    /// `port` is answered against the specification's port vocabulary exactly
    /// as in `publish`: wired schedules, declared-but-unwired returns ok and
    /// schedules nothing, undeclared traps the activation.
    ///
    /// Same provenance/trust note as `publish`: the message carries
    /// `sender = "wasm:<slug>"` with no external-origin marker.
    publish-deferred: func(port: string, payload: string, deliver-after: u64)
        -> result<_, publish-error>;

    /// Failure modes for the deferred-message control ops (`defer-cancel` /
    /// `defer-edit`). A drain-vs-release race — the named message released
    /// between the activation's snapshot and the flush — is NOT an error here:
    /// it is a benign lost race the host logs and counts, and the buffered op
    /// returns ok at buffer time (the guest already returned before the race is
    /// resolvable).
    variant defer-error {
        /// The op was refused on authority: the component was not granted
        /// this interface, or the call is outside an in-flight activation.
        not-permitted,
        /// `index` is outside the deferred-window this activation delivered for
        /// `port`. Snapshot-relative: an index valid against a *different*
        /// activation's window is still out of range here. This is a guest bug,
        /// so it fails fail-fast at buffer time.
        ///
        /// A port the specification declares but the deployer left unwired has
        /// no deferred window at all, so every index into it is out of range.
        out-of-range,
        /// A per-activation budget is exhausted: the call budget (shared with
        /// publishes), the buffered-op ceiling, or — for an edit that replaces
        /// the payload — the per-message payload cap or the activation's
        /// aggregate payload bytes, both shared with publishes. An edit payload
        /// is weighed exactly as a published payload is.
        quota-exceeded,
        /// A `defer-edit` `deliver-after` is not a representable timestamp. Like
        /// `publish-deferred`, the host rejects it at buffer time (where the guest
        /// still holds the error channel) rather than let it collapse host-side.
        invalid-deliver-after,
    }

    /// Cancel one of this component's own parked messages, named by its `index`
    /// into the deferred-window this activation delivered for `port`. Like
    /// `publish`, the call is BUFFERED and applied atomically iff receive returns
    /// ok — an err/trap cancels nothing. At flush the host resolves `index` to the
    /// message identity captured in the snapshot, so a message that released
    /// between drain and flush cannot be mis-targeted; that case is a benign
    /// logged no-op, not an error. A cancelled message never becomes observable.
    ///
    /// A `port` the component's specification does not declare traps the
    /// activation, as in `publish`.
    defer-cancel: func(port: string, index: u32) -> result<_, defer-error>;

    /// Edit one of this component's own parked messages, named by its `index` into
    /// the deferred-window this activation delivered for `port`. `payload` and
    /// `deliver-after` are each `some` to change, `none` to leave alone. Same
    /// buffered/atomic/index-resolution semantics as `defer-cancel`: applied at
    /// flush iff receive returns ok, index resolved against the snapshot, a
    /// drain-vs-release race a benign logged no-op. A `deliver-after` at or before
    /// the host's `now` releases the message immediately at flush.
    ///
    /// A `port` the component's specification does not declare traps the
    /// activation, as in `publish`.
    defer-edit: func(port: string, index: u32, payload: option<string>,
        deliver-after: option<u64>) -> result<_, defer-error>;
}

interface store {
    /// Opaque handle to an in-flight transaction. The host owns the resource;
    /// the component receives an index and must commit or rollback before the
    /// instance returns from its export call. A handle dropped without
    /// commit/rollback is a contract violation — the host's HostTransaction::drop
    /// detects the still-active tx via the tx_active flag, attempts a cleanup
    /// rollback, then returns Err(...) (wasmtime treats a destructor-returned Err
    /// as a runtime trap). The trap surfaces to the host as Err(wasmtime::Error)
    /// on the owning receive call, which ProcessorComponent::handle then surfaces
    /// as a contained Trap (not a panic).
    resource transaction {
        /// Read a value for (namespace, key) within this transaction. Returns
        /// none if the key is absent. Errors are storage-layer failures.
        get: func(namespace: string, key: list<u8>) -> result<option<list<u8>>, store-error>;

        /// Write or replace a value. Idempotent w.r.t. value equality.
        put: func(namespace: string, key: list<u8>, value: list<u8>) -> result<_, store-error>;

        /// Delete a key. Absent key is a no-op (not an error).
        delete: func(namespace: string, key: list<u8>) -> result<_, store-error>;

        /// List keys in namespace in ascending key order, between start (inclusive)
        /// and end (exclusive). end = none means to-the-end. limit = 0 means
        /// unlimited. Returns (key, value) pairs.
        scan: func(
            namespace: string,
            start: list<u8>,
            end: option<list<u8>>,
            limit: u32,
        ) -> result<list<tuple<list<u8>, list<u8>>>, store-error>;

        /// Commit the transaction. The handle is consumed (resource dropped).
        /// On COMMIT failure, host attempts ROLLBACK; if that also fails, the
        /// host panics (fail-fast). The component sees only store-error on the
        /// structured failure path.
        commit: func() -> result<_, store-error>;

        /// Abort the transaction. The handle is consumed.
        rollback: func();
    }

    /// Start a new transaction. SQLite BEGIN IMMEDIATE under the hood:
    /// acquires the write lock now. A second begin from the same component
    /// instance before commit/rollback returns backend("nested transaction
    /// not supported"). The contention variant is reserved for later slices.
    begin: func() -> result<transaction, store-error>;

    /// All store failures the component can observe.
    variant store-error {
        /// Another writer holds the lock and the host's wait budget was
        /// exhausted. Transient. Reserved; not produced in this slice (the
        /// process-global path guard precludes cross-instance contention).
        contention,
        /// Storage subsystem failure or contract violation. String is
        /// host-side diagnostic, opaque to the component. Covers nested
        /// begin, SQLite errors, file corruption.
        backend(string),
        /// Host-enforced per-store size cap reached. The write was rejected
        /// atomically; no partial state committed. Distinct from backend(...)
        /// (disk-full / corruption): this is the host's own quota, recoverable
        /// by the guest's prune/delete path.
        quota-exceeded,
    }
}

interface log {
    /// Maps 1:1 onto the host's tracing levels.
    enum level { trace, debug, info, warn, error }

    /// Emit one diagnostic log line through the host's log pipeline.
    ///
    /// Fire-and-forget, best-effort, IMMEDIATE: unlike `ports.publish`, log
    /// emission is NOT buffered and NOT transactional with the activation
    /// outcome — lines emitted before a later trap/err are kept (that is the
    /// point: diagnostics must survive failure). The host attributes every
    /// line to the emitting component; the guest cannot spoof attribution.
    /// The message is truncated (UTF-8-safe) and control-escaped by the host.
    /// Calls beyond the per-activation quota are dropped (host logs the
    /// suppressed count once after the activation).
    log: func(level: level, message: string);
}

interface alert {
    /// Maps 1:1 onto the host's alert severities.
    enum severity { info, warning, critical }

    /// Page the operator through the host's alerting pipeline (e.g. mail).
    ///
    /// Fire-and-forget, best-effort: delivery is subject to the host's
    /// process-wide alert rate limiter and queue; an accepted call is not an
    /// acknowledgment of delivery (which is why there is no result type —
    /// `ok` would lie). Title and body are truncated and control-escaped;
    /// the host prefixes the title with the component identity. Calls beyond
    /// the per-activation quota are dropped (host logs the suppressed count).
    /// Use for conditions a human should act on; use `log.log` for everything
    /// else. There is NO implicit log-level→alert escalation: `log.log(error,
    /// …)` never alerts.
    alert: func(severity: severity, title: string, body: string);
}

interface mqtt {
    /// Failure modes the guest can observe from a synchronous MQTT publish.
    /// Distinct variants so a guest can tell a transient broker outage
    /// (`broker`) from a permanent denial (`not-permitted`): the former MAY be
    /// retried on a later activation, the latter never.
    variant mqtt-publish-error {
        /// Grant/ACL denied for the target client — the consumer's
        /// `mqtt_publish` ACL does not list this client (or the `mqtt` grant is
        /// absent). Permanent for this config; do not retry.
        not-permitted,
        /// The MQTT service is not configured on this server (no `[[mqtt_client]]`
        /// is declared, so no session exists to publish through). Permanent for
        /// this config; do not retry. (Kept as a stable WIT variant; its reachable
        /// meaning narrowed to the service-absent case — a validly-booted server
        /// with a declared client always has a session, since every ACL-authorized
        /// client is validated and registered at boot.)
        no-connector,
        /// Address parse / wildcard / oversize failure. Diagnostic string.
        invalid-payload(string),
        /// Per-activation publish quota hit (shared with `ports.publish`).
        quota-exceeded,
        /// Broker disconnect / submit failure / ack drop. Transient — MAY be
        /// retried on a later activation. The payload is a stable coarse kind
        /// (e.g. `"not connected"` / `"publish failed"`) suitable for logging
        /// and retry classification; it is NOT the full host-side error detail
        /// and MUST NOT be parsed beyond that classification.
        broker(string),
        /// Broker accepted the connection but rejected the publish (PUBACK
        /// reason code != success). Diagnostic string.
        broker-rejected(string),
    }

    /// Publish synchronously to an MQTT broker. Unlike `ports.publish`
    /// (buffered, flushed atomically at activation end), this goes STRAIGHT to
    /// the broker and returns the broker outcome inline — there is no
    /// store-and-forward, no queuing, no retry.
    ///
    /// **Not transactional with the activation outcome.** Because the send is
    /// immediate, a message published here has ALREADY reached the broker by the
    /// time a later trap or err aborts the activation; it is NOT rolled back.
    /// This is a genuine semantic difference from `ports.publish`, which
    /// discards its whole buffer on failure. A guest needing all-or-nothing
    /// semantics across MQTT + bus must NOT mix the two — the MQTT side effect
    /// is not retractable. (Same immediacy as `log` / `alert`.)
    ///
    /// `client` is the `[[mqtt_client]]` slug (mirrors the LLM `MqttSend`
    /// tool's `<client>` address segment); `topic` is the topic under that
    /// client and MUST NOT contain wildcards. The consumer's `mqtt_publish` ACL
    /// gates which clients are reachable. For QoS >= 1 the call awaits the
    /// PUBACK before returning.
    mqtt-publish: func(
        client: string,
        topic: string,
        payload: list<u8>,
        content-type: option<string>,
        qos: u8,
        retain: bool,
    ) -> result<_, mqtt-publish-error>;
}

interface tools {
    /// Failure modes a guest can observe from a tool call. Mirrors the host-side
    /// `ToolError` (the native registry's error type); the fast and async classes
    /// share this variant because from the caller's viewpoint a tool is one object
    /// regardless of class.
    variant tool-error {
        /// Unknown tool OR a tool this component was not granted — deliberately
        /// indistinguishable, so a probing guest learns nothing about what exists
        /// (the same oracle-closure as an out-of-visibility reply target).
        not-granted,
        /// ACL clause miss: the args named a resource outside this component's
        /// grant. Diagnostic string names the offending resource (the caller
        /// already named it, so it is not an information leak).
        denied(string),
        /// Args JSON was malformed, oversize, or failed the tool's own arg
        /// deserialization. Diagnostic string.
        invalid-args(string),
        /// The caller's per-(participant, tool) rate bucket was empty. Fast tools
        /// fail immediately with this; async tools delay rather than return it.
        rate-limited,
        /// `call-fast` on an async tool, or `call-async` on a fast tool. The class
        /// is the tool's, never the caller's.
        wrong-class,
        /// A tool bug the host has already alerted on (e.g. an oversize result, an
        /// internal execution fault, or a per-activation call-count overflow). The
        /// string is a stable coarse token, not host-side detail.
        internal(string),
    }

    /// Invoke a fast-class tool synchronously and return its JSON result.
    ///
    /// Fast tools are bounded, non-blocking host operations (in-memory lookups,
    /// cheap local reads). The host enforces a per-tool time budget; overrun is a
    /// *tool bug* that the host alerts on, not a guest fault. `args-json` is the
    /// tool's argument object serialized as JSON (UTF-8), capped by the host; the
    /// returned string is the tool's result JSON, also capped. Grant + ACL are
    /// checked against `args-json` at call time. Calling a fast tool that is
    /// actually async yields `wrong-class`.
    call-fast: func(tool: string, args-json: string) -> result<string, tool-error>;

    /// Enqueue an async-class tool call. Returns as soon as the request is
    /// validated and buffered — the *result* arrives later as a separate bus
    /// activation on this component's tool-result inbox, correlated by `call-id`.
    ///
    /// Grant + ACL + arg-size are checked synchronously here (so caller mistakes
    /// fail fast with a typed error); on success the request rides the activation's
    /// transactional flush — it reaches the bus iff this activation returns ok, so
    /// a trapped activation fires no tool calls. `call-id` is a caller-chosen
    /// opaque correlation string (echoed verbatim in the result); the caller owns
    /// its uniqueness and keeps in-flight state in its `store` grant keyed by it.
    ///
    /// A result may arrive more than once for the same `call-id`: a request is
    /// retained for its channel's window, and an executor whose position on that
    /// channel is re-created re-runs what the window still holds. Async tools
    /// declare repeat execution harmless, so the caller's side of the contract is
    /// to ignore a `call-id` it no longer awaits.
    call-async: func(tool: string, args-json: string, call-id: string)
        -> result<_, tool-error>;
}

interface config {
    /// Read one operator-supplied config value. Values are opaque strings;
    /// the guest parses. The map is fixed for the process lifetime (seeded
    /// from the host config at startup; changes require a host restart). Keys
    /// under the reserved prefix "brenn." are host-injected facts (e.g.
    /// "brenn.max-skew-secs" on replay components bound to a timestamped
    /// signature scheme); an operator config cannot set them.
    get: func(key: string) -> option<string>;
}

/// Scoped DOM: read and mutate the instance's own element subtree.
///
/// Element *reach* is confined by construction: every handle derives from
/// `root` or from the instance's own `create-element`, and handle tables are
/// per instance, so a handle another instance minted is not a handle here.
///
/// Element *authority* is confined the same way, by construction rather than
/// by inspection: the host creates only the tags listed at the end of this doc
/// and sets only the attribute names listed with them, and everything else
/// traps as flatly as a foreign handle does. Attribute values are never
/// examined, because no name on the list can carry a URL or an event handler.
/// The admission rule for any future entry, in tree or out: on every allowed
/// tag, the entry must cause no script execution, no navigation, no resource
/// fetch, and no effect outside the instance's own subtree. That rule excludes
/// `script`, `iframe`, `object`, `embed`, `template`, `meta`, `base`, `style`,
/// `link`, `form` and `a` without enumerating them, along with every `on*` and
/// URL-bearing attribute name, and along with the element id, which names a
/// thing in the page-global namespace a confined subtree does not reach into.
/// Growing either list is a reviewed, additive change to this doc and to the
/// host constants it mirrors.
///
/// This is containment, not a security boundary — the backend is that, and it
/// is unchanged. It is here because the alternative is a grant word whose
/// documented confinement any holder can step out of in one call, which makes
/// the separate page-DOM authority decoration.
///
/// # Handle lifetime
///
/// A handle lives until the element it names is destroyed, and two operations
/// destroy elements. `remove` destroys the node and its whole subtree, which
/// invalidates that node's handle and every handle naming an element inside it.
/// `set-text` replaces a node's children, which invalidates every handle naming
/// an element strictly inside it; the node itself survives. Nothing else
/// invalidates: `append` and `insert-before` reparent, and a moved node keeps
/// its handle.
///
/// Using an invalidated handle traps, exactly as an unknown handle does. There
/// is no re-appending a removed subtree; detach-to-hide is what the `hidden`
/// attribute is for. Reclamation crosses instances, because it is about what
/// the host still holds: if a `page-dom` holder destroys a subtree containing
/// an element another instance named, that instance's handle is invalidated
/// too, and it traps on next use rather than operating on an orphan.
///
/// A component that creates an element and never appends it, then drops the
/// handle, leaks that one entry for the page's life. That is the component's
/// own bounded self-harm, not a steady state of any rendering pattern.
///
/// Allowed tags, matched as exact ASCII lowercase:
///
/// `blockquote`, `br`, `button`, `code`, `div`, `em`, `h1`, `h2`, `h3`, `h4`,
/// `h5`, `h6`, `header`, `hr`, `input`, `li`, `ol`, `p`, `pre`, `s`,
/// `section`, `span`, `strong`, `ul`.
///
/// Allowed attribute names, by the same match, and the two inert families
/// admitted by prefix:
///
/// `class`, `disabled`, `hidden`, `placeholder`, `role`, `start`, `title`,
/// `type`, `aria-`, `data-`.
interface dom {
    use types.{node};

    /// The instance's own host element: the root of the subtree it owns.
    root: func() -> node;

    /// Create a detached element. `tag` must be one of the allowed tags above;
    /// anything else traps.
    create-element: func(tag: string) -> node;

    /// Set an attribute. `name` must be one of the allowed attribute names
    /// above; anything else traps. The value is never inspected.
    set-attribute: func(n: node, name: string, value: string);
    remove-attribute: func(n: node, name: string);

    /// Replace the node's children with one inert text node. Text only — this
    /// never parses markup.
    ///
    /// The replaced children are destroyed: every handle naming an element
    /// strictly inside `n` is invalidated. `n` itself stays valid.
    set-text: func(n: node, text: string);

    set-style-property: func(n: node, name: string, value: string);
    remove-style-property: func(n: node, name: string);

    append: func(parent: node, child: node);

    /// Insert `child` before `reference`, or append when `reference` is `none`.
    insert-before: func(parent: node, child: node, reference: option<node>);

    /// Destroy the node: detach it from its parent, and invalidate `n`'s
    /// handle along with every handle naming an element inside the removed
    /// subtree. There is no re-appending it.
    remove: func(n: node);

    /// Read a form control's current value; the empty string for a node that
    /// has none.
    value: func(n: node) -> string;
    set-value: func(n: node, value: string);

    /// Attach a host-owned listener for `event` on the node. The host answers
    /// the event with a sync-call activation on `port`, carrying a synthesized
    /// request body naming the event, the listening node and the nearest
    /// handle-mapped ancestor of the event target.
    ///
    /// A listener dies with its element: an element receives no UI events once
    /// detached, and detaching is what destroys it, so a listener inside a
    /// removed or `set-text`-cleared subtree is permanently inert.
    listen: func(n: node, event: string, port: string);

    /// The page environment's UTC offset, in minutes, at the given instant.
    /// Not a DOM operation: it is the one page fact a component cannot compute
    /// from the activation clock, and it rides here rather than earning a grant
    /// word of its own.
    utc-offset-minutes: func(epoch-ms: u64) -> s32;
}

/// Page-DOM authority: the ability to reach outside one's own subtree.
///
/// Separate from `dom` because it is a different capability, not a bigger one.
/// A surface designates exactly one instance — its chrome — to arrange the page;
/// every other instance is confined to what `dom` alone can reach.
interface page-dom {
    use types.{node};

    /// The surface's root element, which holds every instance wrapper.
    page-root: func() -> node;

    /// The page body, where document-level state is stamped.
    page-body: func() -> node;

    /// The wrapper element the host created for another instance, or `none`
    /// when that instance has not registered yet. A `none` is the ordinary
    /// transient of a page still coming up, not an error.
    instance-wrapper: func(instance: string) -> option<node>;

    /// The node's parent, or `none` when it is detached or is the document
    /// root. Handle identity substitutes for node identity: the host mints one
    /// handle per element, so comparing handles compares elements.
    parent: func(n: node) -> option<node>;
}

world processor {
    use types.{activation, receive-error};
    import ports;
    import store;
    import log;
    import alert;
    import config;
    import mqtt;
    import tools;
    import dom;
    import page-dom;

    /// Receive one activation (one or more port-windows of messages). The
    /// component processes the new portions of each port-window using earlier
    /// entries as context, and returns one result for the whole activation.
    /// Published messages (via the ports import) are buffered during execution
    /// and flushed atomically iff this returns ok; err/trap discards the buffer.
    /// A sync-call activation may answer its caller: `ok(some(reply))` is that
    /// answer, and the reply's dialect belongs to whatever raised the call. An
    /// ordinary activation must answer `ok(none)`; a `some` on one is a host
    /// trap, because a component replying to a cause that asked nothing has
    /// lost track of why it was called.
    export receive: func(a: activation) -> result<option<string>, receive-error>;
}
