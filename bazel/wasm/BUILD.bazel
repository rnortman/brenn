"""Rules for the wasm32 guest tree, and the gate scripts they wrap."""

load("//bazel/policy:defs.bzl", "policy_srcs")

policy_srcs()

# The two component gates are checked-in scripts rather than generated text so
# `//bazel/wasm/tests` can drive them over fixtures. The rules only bind
# arguments.
#
# `manifest_names.sh` is the deploy manifest's grammar, exported because the
# release packaging in `//bazel/release` reads the same manifest: one
# implementation, three callers, so a format change cannot reach two of them.
# `record_lib.sh` is the binding record's field scrape, exported for the same
# reason as the two grammars above: the staged-tree gate and the emitter's own
# test both read records, and a scrape that reaches one and not the other goes
# on matching nothing, which reads as a field that is not stated.
#
# `wit_lib.sh` is the artifact-import scrape, exported for the same reason:
# `//surface`'s manifest emitter reads the same `wasm-tools` output, so one
# implementation, two callers, and a wasm-tools format change cannot reach one
# and miss the other.
exports_files([
    "bundle_assemble.sh",
    "config_fit_refusal.sh",
    "deployed_components_check.sh",
    "emit_package.sh",
    "grant_parity_check.sh",
    "manifest_names.sh",
    "record_lib.sh",
    "wasi_import_check.sh",
    "wit_lib.sh",
])
