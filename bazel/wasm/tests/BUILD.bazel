"""Self-tests for the component gate scripts.

A gate that passes over every real input still says nothing about whether it can
fail. These drive the same scripts the rules run, over fixtures built to be
rejected.
"""

load("//bazel/policy:defs.bzl", "policy_srcs")
load("//bazel/wasm:defs.bzl", "config_fit_refusal_test", "config_fit_test", "library_module_test")
load("@bazel_skylib//rules:native_binary.bzl", "native_test")

policy_srcs()

# The gates are host-side; requesting the guest tree under the wasm32 platform
# would otherwise pull them in with no shell toolchain to run them.
HOST_ONLY = select({
    "//bazel/platforms:is_wasm32": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

native_test(
    name = "wasi_import_check_test",
    size = "small",
    src = "wasi_import_check_test.sh",
    args = ["$(rootpath //bazel/wasm:wasi_import_check.sh)"],
    data = ["//bazel/wasm:wasi_import_check.sh"],
    out = "wasi_import_check_test.run",
    target_compatible_with = HOST_ONLY,
)

native_test(
    name = "deployed_components_check_test",
    size = "small",
    src = "deployed_components_check_test.sh",
    args = [
        "$(rootpath //bazel/wasm:manifest_names.sh)",
        "$(rootpath //bazel/wasm:deployed_components_check.sh)",
    ],
    data = [
        "//bazel/wasm:deployed_components_check.sh",
        "//bazel/wasm:manifest_names.sh",
    ],
    out = "deployed_components_check_test.run",
    target_compatible_with = HOST_ONLY,
)

# Driven over the real artifacts, one per world: the emitter's world
# cross-check reads a component's own imports, so a synthetic `.wasm` would
# exercise the arm that finds nothing and none of the arms that matter.
native_test(
    name = "emit_package_test",
    size = "small",
    src = "emit_package_test.sh",
    args = [
        "$(rootpath //bazel/wasm:emit_package.sh)",
        "$(rootpath //brenn-wasm/components/processor-demo:component)",
        "$(rootpath //brenn-wasm/components/replay:component)",
        "$(rootpath //bazel/tools:wasm-tools)",
        "$(rootpath //bazel/wasm:wit_lib.sh)",
        "$(rootpath //bazel/wasm:record_lib.sh)",
    ],
    data = [
        "//bazel/tools:wasm-tools",
        "//bazel/wasm:emit_package.sh",
        "//bazel/wasm:record_lib.sh",
        "//bazel/wasm:wit_lib.sh",
        "//brenn-wasm/components/processor-demo:component",
        "//brenn-wasm/components/replay:component",
    ],
    out = "emit_package_test.run",
    target_compatible_with = HOST_ONLY,
)

# The workspace install tree, over the real staged files: the rule declares its
# outputs, so a half-populated tree is a green build whose only symptom is a
# boot panic in the e2e suite.
native_test(
    name = "install_tree_test",
    size = "small",
    src = "install_tree_test.sh",
    args = [
        "$(rootpath //bazel/wasm:record_lib.sh)",
        "$(rootpaths //brenn-wasm:install_tree)",
    ],
    data = [
        "//bazel/wasm:record_lib.sh",
        "//brenn-wasm:install_tree",
    ],
    out = "install_tree_test.run",
    target_compatible_with = HOST_ONLY,
)

# The staging script, over fixture trees. `component_bundle` runs it once per
# build over inputs that are correct, and the one in-tree call passes packages
# and no surface kinds — so the surface arm and every refusal would otherwise
# first run in a consumer's repository.
native_test(
    name = "bundle_assemble_test",
    size = "small",
    src = "bundle_assemble_test.sh",
    args = [
        "$(rootpath //bazel/wasm:manifest_names.sh)",
        "$(rootpath //bazel/wasm:bundle_assemble.sh)",
        "$(rootpath //bazel/release:stage_lib.sh)",
    ],
    data = [
        "//bazel/release:stage_lib.sh",
        "//bazel/wasm:bundle_assemble.sh",
        "//bazel/wasm:manifest_names.sh",
    ],
    out = "bundle_assemble_test.run",
    target_compatible_with = HOST_ONLY,
)

# The manifest grammar has one implementation and three callers, so its edge
# cases are asserted here rather than in each gate.
native_test(
    name = "manifest_names_test",
    size = "small",
    src = "manifest_names_test.sh",
    args = ["$(rootpath //bazel/wasm:manifest_names.sh)"],
    data = ["//bazel/wasm:manifest_names.sh"],
    out = "manifest_names_test.run",
    target_compatible_with = HOST_ONLY,
)

# The same document set, driven at the refusal, over the same two module roots:
# the fit gate's passing call below and this one build the same command, so a
# gate that went green because the command changed fails here.
config_fit_refusal_test(
    name = "config_fit_refusal_test",
    config = "fit/misfit.brenn",
    expect = "parameter `slug` is a `String`",
    modules = [
        "fit/mods-one/base.brenn",
        "fit/mods-two/widget.brenn",
    ],
)

# The fit gate over a document whose vocabulary arrives from two module roots
# and one sibling. The macro derives a `--modules` per distinct directory, so
# this is also what holds that derivation to two.
config_fit_test(
    name = "config_fit_test",
    config = "fit/root.brenn",
    modules = [
        "fit/mods-one/base.brenn",
        "fit/mods-two/widget.brenn",
    ],
    tree = ["fit/shared.brenn"],
)

# The library-module gate over a module that keeps the packaged discipline. The
# macro writes the one-line root itself, so what this pins is the derivation of
# the import spelling from the basename as much as the module's own legality.
library_module_test(
    name = "library_module_test",
    module = "lib/good-lib.brenn",
)

# The same gate driven at the refusal, over a module that declares a top-level
# channel. `library_module_test` has no way to want a failure, so the negative
# case is a sibling over `dsl_cli check` directly.
native_test(
    name = "library_module_refusal_test",
    size = "small",
    src = "library_module_refusal_test.sh",
    args = [
        "$(rootpath //brenn-dsl:dsl_cli)",
        "$(rootpath lib-refusal-root.brenn)",
        "$(rootpath lib/bad-lib.brenn)",
    ],
    data = [
        "lib-refusal-root.brenn",
        "lib/bad-lib.brenn",
        "//brenn-dsl:dsl_cli",
    ],
    out = "library_module_refusal_test.run",
    target_compatible_with = HOST_ONLY,
)
