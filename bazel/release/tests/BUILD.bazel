"""Self-tests for the release packaging scripts.

Both scripts run once per release over inputs that are correct, so neither run
proves the script can fail. These drive the same two scripts over fixtures
built to be rejected.
"""

load("@bazel_skylib//rules:native_binary.bzl", "native_test")
load("//bazel/platforms:defs.bzl", "HOST_ONLY")
load("//bazel/policy:defs.bzl", "policy_srcs")

policy_srcs()

# Both gates derive a package's sidecar names, so both are handed the one
# script that states them. `package_check` reads the binding records, so its fixtures are written by the
# build's own emitter rather than by hand: a gate proven against a record shape
# nothing holds equal to the emitted one is a gate that can drift green.
# `assemble` only copies the files, so its fixtures stay opaque.
_EXTRA = {
    "assemble": ["//bazel/wasm:package_names.sh"],
    "package_check": [
        "//bazel/wasm:package_names.sh",
        "//bazel/wasm:record_lib.sh",
        "//bazel/wasm:emit_package.sh",
        "//bazel/wasm:wit_lib.sh",
        "//bazel/surface:emit_dom_manifest.sh",
        "//surface:emit-processor-manifest.sh",
        "//bazel/surface:dom_names.sh",
    ],
}

[
    native_test(
        name = script + "_test",
        size = "small",
        src = script + "_test.sh",
        args = [
            "$(rootpath //bazel/wasm:manifest_names.sh)",
            "$(rootpath //bazel/release:%s.sh)" % script,
        ] + ["$(rootpath %s)" % label for label in _EXTRA[script]],
        data = [
            "//bazel/release:%s.sh" % script,
            "//bazel/wasm:manifest_names.sh",
        ] + _EXTRA[script],
        out = script + "_test.run",
        target_compatible_with = HOST_ONLY,
    )
    for script in [
        "assemble",
        "package_check",
    ]
]
