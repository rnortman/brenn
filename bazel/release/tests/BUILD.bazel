"""Self-tests for the release packaging scripts.

Both scripts run once per release over inputs that are correct, so neither run
proves the script can fail. These drive the same two scripts over fixtures
built to be rejected.
"""

load("@bazel_skylib//rules:native_binary.bzl", "native_test")
load("//bazel/platforms:defs.bzl", "HOST_ONLY")
load("//bazel/policy:defs.bzl", "policy_srcs")

policy_srcs()

# Both gates harvest the surface kinds' modules out of the staged tree, so both
# are handed the script that states a record's field shape.
# `bundle_check` and `package_check` read the binding records, so their fixtures
# are written by the build's own emitter rather than by hand: a gate proven
# against a record shape nothing holds equal to the emitted one is a gate that
# can drift green. `assemble` only copies the files, so its fixtures stay
# opaque.
_RECORD_FIXTURES = [
    "//bazel/wasm:record_lib.sh",
    "//bazel/wasm:emit_package.sh",
    "//bazel/wasm:wit_lib.sh",
    "//surface:emit-processor-manifest.sh",
]

_EXTRA = {
    # The staging library last, because it is the script's fourth argument and
    # this list is what the invocation's tail is built from.
    "assemble": [
        "//bazel/wasm:record_lib.sh",
        "//bazel/release:stage_lib.sh",
    ],
    "bundle_check": _RECORD_FIXTURES,
    # The delegate last, because `package_check.sh` takes it as an argument and
    # this list is what the invocation's tail is built from.
    "package_check": _RECORD_FIXTURES + ["//bazel/release:bundle_check.sh"],
}

[
    native_test(
        name = script + "_test",
        size = "small",
        src = script + "_test.sh",
        args = [
            "$(rootpath //bazel/wasm:manifest_names.sh)",
            "$(rootpath //bazel/release:%s.sh)" % script,
        ] + ["$(rootpath %s)" % label for label in _EXTRA[script]],
        data = [
            "//bazel/release:%s.sh" % script,
            "//bazel/wasm:manifest_names.sh",
        ] + _EXTRA[script],
        out = script + "_test.run",
        target_compatible_with = HOST_ONLY,
    )
    for script in [
        "assemble",
        "bundle_check",
        "package_check",
    ]
]
