"""Brenn's Bazel module graph.

Third-party Rust dependencies are not declared here: `crate.from_cargo` reads
`Cargo.toml` + `Cargo.lock`, which stay the single source of truth for
versions and features. What lives here is the toolchain set and the module
deps that cargo has no opinion about.
"""

module(
    name = "brenn",
    version = "0.0.0",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_rust", version = "0.73.0")
bazel_dep(name = "rules_rust_wasm_bindgen", version = "0.73.0")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
# `dev_dependency`: the musl cc toolchain exists for brenn's own static release
# binary, and the module registers its toolchains unconditionally — a
# dependent module would inherit a musl `cc` toolchain matching its plain
# linux platform and link every host tool against musl. Hidden from
# dependents, present for brenn as root.
bazel_dep(name = "toolchains_musl", version = "0.1.27.bcr.1", dev_dependency = True)
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "aspect_rules_js", version = "3.4.0")
bazel_dep(name = "rules_nodejs", version = "6.7.3")
bazel_dep(name = "rules_python", version = "1.7.0")

# ---------------------------------------------------------------------------
# fltk: the parser-generator module behind the config DSL
# ---------------------------------------------------------------------------
# One pin for everything fltk supplies: the hermetic codegen rules
# (`@fltk//:rust.bzl`) and the runtime crates `//brenn-dsl` links. Generated
# parser sources are build outputs, never tracked, so there is no second pin to
# drift against.
#
# fltk's module() declares no version, so `version = ""`; the override decides
# what is fetched.
bazel_dep(name = "fltk", version = "")
git_override(
    module_name = "fltk",
    commit = "72db6ea0b07967339ec0693030a7eafdbb143091",
    remote = "https://github.com/rnortman/fltk.git",
)

# ---------------------------------------------------------------------------
# Rust toolchain
# ---------------------------------------------------------------------------
# Must equal rust-toolchain.toml's channel (the toml survives for
# rustfmt/rust-analyzer; this is what builds).
RUST_VERSION = "1.95.0"

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    extra_target_triples = ["wasm32-unknown-unknown"],
    versions = [RUST_VERSION],
)

# The x86_64 Linux toolchain set, declared here instead of taken from
# rules_rust's defaults. Reusing the default set's name replaces it.
#
# The reason is the libc axis. rules_rust maps `x86_64-unknown-linux-musl` onto
# the same cpu+os constraint pair as the gnu triple, so a musl toolchain added
# through `extra_target_triples` is indistinguishable from the gnu one and the
# musl platform resolves to whichever was registered first — a glibc rustc
# handing objects to a musl linker. Only `repository_set` carries per-triple
# constraints, so both triples are spelled out against
# `//bazel/platforms:libc`, and neither can match the other's platform.
#
# wasm32 rides along because replacing the set means rules_rust no longer adds
# the `rust.toolchain` extra triples for this exec platform.
RUST_LINUX_X86_64 = "rust_linux_x86_64"

rust.repository_set(
    name = RUST_LINUX_X86_64,
    edition = "2024",
    exec_triple = "x86_64-unknown-linux-gnu",
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "//bazel/platforms:libc_glibc",
    ],
    target_triple = "x86_64-unknown-linux-gnu",
    versions = [RUST_VERSION],
)
rust.repository_set(
    name = RUST_LINUX_X86_64,
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "//bazel/platforms:libc_musl",
    ],
    target_triple = "x86_64-unknown-linux-musl",
)
rust.repository_set(
    name = RUST_LINUX_X86_64,
    target_compatible_with = [
        "@platforms//cpu:wasm32",
        "@platforms//os:none",
    ],
    target_triple = "wasm32-unknown-unknown",
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# The musl cc toolchain, for the C that brenn links: rusqlite's bundled SQLite
# and ring both compile C sources, so a static musl binary is a real
# cross-compile and not a linker flag. Constraining it to `:libc_musl` keeps it
# out of every build that is not asking for the musl platform.
#
# `dev_dependency`, like the `bazel_dep` above: the extension's `config` tag may
# only be used from the root module and fails module resolution otherwise.
toolchains_musl = use_extension(
    "@toolchains_musl//:toolchains_musl.bzl",
    "toolchains_musl",
    dev_dependency = True,
)
toolchains_musl.config(
    extra_target_compatible_with = ["//bazel/platforms:libc_musl"],
)

# ---------------------------------------------------------------------------
# Third-party crates: the root workspace hub
# ---------------------------------------------------------------------------
# Only the workspace root manifest is listed: crate_universe walks the
# `members` list itself, so member manifests never have to be enumerated here
# and cannot fall out of sync with Cargo.toml.
#
# Both hubs carry a committed cargo-bazel `lockfile` in addition to the cargo
# one. rules_rust refuses to load a hub from a non-root module without it
# (repinning is not supported across module boundaries), so the lockfiles are
# what lets another Bazel module `bazel_dep` on brenn and build a component
# with brenn's rules. They are generated, not hand-edited; whenever a
# `Cargo.lock` changes, regenerate with
#
#     CARGO_BAZEL_REPIN=1 bazel mod deps
#
# A stale lockfile fails brenn's own build with rules_rust's digest-mismatch
# error, which names that command.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    lockfile = "//:cargo-bazel-lock.json",
    manifests = ["//:Cargo.toml"],
)

# ---------------------------------------------------------------------------
# Third-party crates: the wasm32 guest hub
# ---------------------------------------------------------------------------
# A second hub, from a second cargo workspace, because cargo resolves features
# and versions per workspace: guest crates must not join the host's feature
# unification, and their dependencies resolve for wasm32 alone.
#
# The host triple is listed alongside wasm32 because crate_universe runs
# `cargo tree` on an execution-platform triple to resolve features; a
# wasm32-only list has no host tools and fails before it starts.
crate.from_cargo(
    name = "wasm_crates",
    cargo_lockfile = "//brenn-wasm/components:Cargo.lock",
    lockfile = "//brenn-wasm/components:cargo-bazel-lock.json",
    manifests = ["//brenn-wasm/components:Cargo.toml"],
    supported_platform_triples = [
        "wasm32-unknown-unknown",
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(
    crate,
    "crates",
    "wasm_crates",
)

# ---------------------------------------------------------------------------
# WASM component tooling
# ---------------------------------------------------------------------------
# The component pipeline's two CLIs, as sha256-pinned upstream release
# binaries. Both versions appear exactly once, here; `//bazel/tools` picks the
# archive matching the execution platform.
WIT_BINDGEN_VERSION = "0.60.0"

WASM_TOOLS_VERSION = "1.255.0"

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "wit_bindgen_x86_64_linux",
    build_file = "//bazel/tools:wit_bindgen.BUILD.bazel",
    sha256 = "6dc887e6d66a183d196885ff611e7f0a7db64db189f95c18f2a65fcf65d3651b",
    strip_prefix = "wit-bindgen-" + WIT_BINDGEN_VERSION + "-x86_64-linux",
    url = "https://github.com/bytecodealliance/wit-bindgen/releases/download/v" + WIT_BINDGEN_VERSION +
          "/wit-bindgen-" + WIT_BINDGEN_VERSION + "-x86_64-linux.tar.gz",
)

http_archive(
    name = "wit_bindgen_aarch64_linux",
    build_file = "//bazel/tools:wit_bindgen.BUILD.bazel",
    sha256 = "6018d1cba03d1e1df2e75ad1a3c5d9b9b62dcb3fb0874da6b13c03ff103646a6",
    strip_prefix = "wit-bindgen-" + WIT_BINDGEN_VERSION + "-aarch64-linux",
    url = "https://github.com/bytecodealliance/wit-bindgen/releases/download/v" + WIT_BINDGEN_VERSION +
          "/wit-bindgen-" + WIT_BINDGEN_VERSION + "-aarch64-linux.tar.gz",
)

http_archive(
    name = "wasm_tools_x86_64_linux",
    build_file = "//bazel/tools:wasm_tools.BUILD.bazel",
    sha256 = "a62237f4731c45f665f1115cad39acaeec02963cbc848c9473ab033eed837072",
    strip_prefix = "wasm-tools-" + WASM_TOOLS_VERSION + "-x86_64-linux",
    url = "https://github.com/bytecodealliance/wasm-tools/releases/download/v" + WASM_TOOLS_VERSION +
          "/wasm-tools-" + WASM_TOOLS_VERSION + "-x86_64-linux.tar.gz",
)

http_archive(
    name = "wasm_tools_aarch64_linux",
    build_file = "//bazel/tools:wasm_tools.BUILD.bazel",
    sha256 = "b51adcd4b7e2b85c689af3a1800534e7de192fdf47b1b6b6a8b5bcb0f449c392",
    strip_prefix = "wasm-tools-" + WASM_TOOLS_VERSION + "-aarch64-linux",
    url = "https://github.com/bytecodealliance/wasm-tools/releases/download/v" + WASM_TOOLS_VERSION +
          "/wasm-tools-" + WASM_TOOLS_VERSION + "-aarch64-linux.tar.gz",
)

# ---------------------------------------------------------------------------
# Secret scanning: the gitleaks scrub is validated against
# ---------------------------------------------------------------------------
# scrub wraps one gitleaks release and its integration suites spawn the real
# binary. PATH lookups are invisible to the sandbox; pinning the binary here
# makes it a declared input of the test targets, so the assertions cannot
# silently skip.
#
# The tree-scan job that runs gitleaks over the whole checkout is commit-hook
# machinery and stays outside the build graph. It downloads the same release
# from its own pin, so xtask's sync guard holds this version and this checksum
# equal to the wrapper's pin and to the workflow's.
GITLEAKS_VERSION = "8.30.0"

GITLEAKS_SHA256_X86_64 = "79a3ab579b53f71efd634f3aaf7e04a0fa0cf206b7ed434638d1547a2470a66e"

GITLEAKS_SHA256_AARCH64 = "b4cbbb6ddf7d1b2a603088cd03a4e3f7ce48ee7fd449b51f7de6ee2906f5fa2f"

http_archive(
    name = "gitleaks_x86_64_linux",
    build_file = "//bazel/tools:gitleaks.BUILD.bazel",
    sha256 = GITLEAKS_SHA256_X86_64,
    url = "https://github.com/gitleaks/gitleaks/releases/download/v" + GITLEAKS_VERSION +
          "/gitleaks_" + GITLEAKS_VERSION + "_linux_x64.tar.gz",
)

http_archive(
    name = "gitleaks_aarch64_linux",
    build_file = "//bazel/tools:gitleaks.BUILD.bazel",
    sha256 = GITLEAKS_SHA256_AARCH64,
    url = "https://github.com/gitleaks/gitleaks/releases/download/v" + GITLEAKS_VERSION +
          "/gitleaks_" + GITLEAKS_VERSION + "_linux_arm64.tar.gz",
)

# ---------------------------------------------------------------------------
# Surface browser bundles: the wasm-bindgen CLI
# ---------------------------------------------------------------------------
# The CLI must be the exact version of the `wasm-bindgen` crate the browser
# crates link, so it is pinned here and held equal to the crate pin in
# `[workspace.dependencies]` by xtask's sync guard.
#
# The module ships a fixed CLI version in its own toolchain, but the CLI must
# match our crate pin. A root module's toolchain registrations take precedence,
# so `//bazel/tools:wasm_bindgen_toolchain` (registered below) overrides it
# with the pinned archive above.
WASM_BINDGEN_VERSION = "0.2.125"

http_archive(
    name = "wasm_bindgen_x86_64_linux",
    build_file = "//bazel/tools:wasm_bindgen.BUILD.bazel",
    sha256 = "21d81ef7414a0a585861a60ea4ae2b7970eccaed09d4a4e05f8bc4b159827dea",
    strip_prefix = "wasm-bindgen-" + WASM_BINDGEN_VERSION + "-x86_64-unknown-linux-musl",
    url = "https://github.com/wasm-bindgen/wasm-bindgen/releases/download/" + WASM_BINDGEN_VERSION +
          "/wasm-bindgen-" + WASM_BINDGEN_VERSION + "-x86_64-unknown-linux-musl.tar.gz",
)

http_archive(
    name = "wasm_bindgen_aarch64_linux",
    build_file = "//bazel/tools:wasm_bindgen.BUILD.bazel",
    sha256 = "58844cdc1df8e725d9571cb8bf23f68b5ca0027ff3feaaa8c742fc0d76cf64f9",
    strip_prefix = "wasm-bindgen-" + WASM_BINDGEN_VERSION + "-aarch64-unknown-linux-musl",
    url = "https://github.com/wasm-bindgen/wasm-bindgen/releases/download/" + WASM_BINDGEN_VERSION +
          "/wasm-bindgen-" + WASM_BINDGEN_VERSION + "-aarch64-unknown-linux-musl.tar.gz",
)

register_toolchains("//bazel/tools:wasm_bindgen_toolchain")

# ---------------------------------------------------------------------------
# Python: the MCP stub shipped beside the binaries
# ---------------------------------------------------------------------------
# One interpreter, hermetic, for one stdlib-only script and its unittest suite.
# The deploy tarball carries the script and the target host runs it under
# whatever python3 it has, so this pins what the *tests* run under, not what
# production does.
PYTHON_VERSION = "3.13"

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = PYTHON_VERSION,
)

# ---------------------------------------------------------------------------
# Node and npm: the browser asset trees
# ---------------------------------------------------------------------------
# Node is a hermetic toolchain, not a system binary checked against a floor.
# Nothing else in the tree names this version; this is the only pin.
NODE_VERSION = "22.20.0"

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = NODE_VERSION)

# One npm tree per package.json. `surface` and `frontend` are Bazel's; `e2e`
# drives real browsers and stays outside the build graph.
#
# rules_js consumes a pnpm lockfile, so each tree's `pnpm-lock.yaml` is the
# lockfile the build installs from and the only one that decides what ships.
# `make npm-audit` audits it, and xtask's sync guard holds the pins the build
# records or reruns against it.
npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "surface_npm",
    pnpm_lock = "//surface:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, "surface_npm")

# esbuild is the one package here with an install-time build step, and it runs
# under the sandbox like every other action: rules_js exempts lifecycle hooks by
# default, and the exemption is what would let an install script write outside
# its outputs.
npm.npm_translate_lock(
    name = "frontend_npm",
    lifecycle_hooks_no_sandbox = False,
    pnpm_lock = "//frontend:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, "frontend_npm")

# The pnpm binary rules_js vendors, so regenerating a `pnpm-lock.yaml`
# (`bazel run -- @pnpm//:pnpm --dir <tree> import`) needs nothing installed.
pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
use_repo(pnpm, "pnpm")
