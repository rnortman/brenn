/// Google Maps Platform for an assistant, as native tools, each answered by
/// one or two `api-request` calls against the `api_key_provider` the instance
/// names, compacted to what a model needs. The key never reaches this
/// component; `api-request` attaches it host-side.
///
/// Every capability is load-bearing: `config` names the provider and its
/// hosts, without which no call can be addressed; `store` carries each
/// request's state between the activation that issues its nested call and the
/// one that receives the answer; `tools` is the authority to call
/// `api-request`; `provides` is what makes the tools exist; `log` records each
/// step's tool, status and size — never a body, never a header.
///
/// The instance's `config = { ... };` map is flat: `provider` is the
/// `api_key_provider` name; `weather_host`, `geocoding_host`, `places_host`
/// and `routes_host` are the `host[:port]` values `api-request` matches
/// against that provider's `api_hosts`; `units` is `METRIC` (default) or
/// `IMPERIAL`; `language` is an optional BCP-47 tag passed to Google as
/// `languageCode`. A missing or malformed key fails every activation, naming
/// the key.
///
/// Size the instance's result inbox with a `channel at
/// "brenn:tool-results/<slug>"` block: each live request has at most one
/// nested call outstanding, so the window must hold Σ max_concurrency results,
/// twice over for a re-delivered result. 64 is the documented value: it holds
/// any Σ max_concurrency up to the 32 ceiling twice over, and the family
/// default of 16 is too small for a full window.
component GoogleMapsTools {
  abi = processor;
  requires = [log, store, config, tools, provides];
  in tool-results;
  in tool-requests;
  provide weather {
    mcp_name = "Weather";
    description = "Weather at a place from Google's Weather API. Pass `place` (free text, geocoded first, or \"<lat>,<lng>\") or `lat` and `lng` (decimal degrees), not both, and `kind`: `current` for conditions now; `hourly` for an hourly forecast from the current hour, `hours` (1-240, default 24) being the whole horizon, answered 24 hours a page; `daily` for `days` (1-10, default 5) of day and night forecasts; `alerts` for public weather alerts where Google covers the region. A `next_page` in an hourly or alerts answer is passed back as `page`, with the same location and `hours`, for the next page. Every answer states its `location` (with the resolved `place` when one was geocoded); all but alerts state the `timezone` and `units`. An alert's `source` name and link, when Google gives them, must be shown with it. An empty `alerts` list is Google's answer when no alert is active, and Google gives the same answer when a provider's alert lacked a required field, so it is not proof that none is in force. Maps Platform endpoints this component does not wrap (air quality, time zone, weather history, nearby search, …) are listed with `api-request` examples in `docs/providers/google-maps.md`.";
    input_schema = """{ "type": "object", "properties": { "kind": { "type": "string", "enum": ["current", "hourly", "daily", "alerts"] }, "place": { "type": "string" }, "lat": { "type": "number", "minimum": -90, "maximum": 90 }, "lng": { "type": "number", "minimum": -180, "maximum": 180 }, "hours": { "type": "integer", "minimum": 1, "maximum": 240 }, "days": { "type": "integer", "minimum": 1, "maximum": 10 }, "page": { "type": "string" } }, "required": ["kind"], "additionalProperties": false }""";
    max_concurrency = 4;
  }
  provide geocode {
    mcp_name = "Geocode";
    description = "Turn an address into coordinates, or coordinates into addresses, with Google's Geocoding API. Pass `address` (free text, or \"<lat>,<lng>\" for a reverse lookup) or `lat` and `lng` (decimal degrees), not both; `max` (1-5, default 3) caps the results. Each result has the formatted address, `lat`, `lng`, the Places `place_id`, Google's `granularity` and its `types`; `results_omitted` counts results beyond `max`. Maps Platform endpoints this component does not wrap (air quality, time zone, weather history, nearby search, …) are listed with `api-request` examples in `docs/providers/google-maps.md`.";
    input_schema = """{ "type": "object", "properties": { "address": { "type": "string" }, "lat": { "type": "number", "minimum": -90, "maximum": 90 }, "lng": { "type": "number", "minimum": -180, "maximum": 180 }, "max": { "type": "integer", "minimum": 1, "maximum": 5 } }, "additionalProperties": false }""";
    max_concurrency = 2;
  }
  provide directions {
    mcp_name = "Directions";
    description = "Directions between two places from Google's Routes API. `origin` and `destination` are each \"<lat>,<lng>\", \"place_id:<id>\" (a `place_id` from Geocode) or an address. `mode` is `drive` (default, traffic-aware), `walk`, `bicycle` or `transit`. Pass at most one of `depart_at` and `arrive_by`, each an RFC 3339 time with a zone (2026-10-30T17:00:00Z); `arrive_by` is for `transit` only. `max_steps` (1-200, default 40) caps the steps across the route; `steps_omitted` counts the rest. The answer gives the route's `distance` (in `units`: km or mi), `duration_minutes` (with traffic when driving, unless `fallback` is present: then Google computed the route in another routing mode — `fallback.routing_mode` names it when Google says — and the figure may not include traffic) and `duration_without_traffic_minutes`, Google's `summary`, and each leg's steps with their instruction, distance, minutes and travel mode; a transit step names its line, vehicle, agency and stops, and gives its departure and arrival each as local time (`departs`, `arrives`) with that time's own zone (`departs_timezone`, `arrives_timezone`) and as a UTC instant (`departs_at`, `arrives_at`). `warnings` must be shown with the route: Google requires its walking and cycling beta warning on display. Maps Platform endpoints this component does not wrap (air quality, time zone, weather history, nearby search, …) are listed with `api-request` examples in `docs/providers/google-maps.md`.";
    input_schema = """{ "type": "object", "properties": { "origin": { "type": "string" }, "destination": { "type": "string" }, "mode": { "type": "string", "enum": ["drive", "walk", "bicycle", "transit"] }, "depart_at": { "type": "string", "format": "date-time" }, "arrive_by": { "type": "string", "format": "date-time" }, "max_steps": { "type": "integer", "minimum": 1, "maximum": 200 } }, "required": ["origin", "destination"], "additionalProperties": false }""";
    max_concurrency = 4;
  }
}
