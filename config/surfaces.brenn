/// Where admitted warn/error surface reports are republished by the trusted
/// in-code system publisher.
///
/// Errors are facts, not signals: a report that scrolls out of the window
/// before anyone reads it is the outage the channel exists to describe. The
/// window is sized for a burst of reports, and `push_depth = 1` wakes whoever
/// is watching once, after which it reads the window.
channel surface_errors at "brenn:surface-errors" {
  description = "Surface client error reports (trusted republish)";
  push_depth = 1;
  retain_depth = 100;
  standing_retain_depth = 100;
}
/// The root of the boot-published self-description topology: an app starts here
/// and follows addresses.
channel surface_index at "brenn:surface.index" {
  description = "Surface topology index (system-published, latest-wins)";
  push_depth = 1;
  retain_depth = 1;
  standing_retain_depth = 1;
}
/// The four self-description channels one surface carries: the boot-published
/// help document, the geometry and status the shell reports, and the bindings
/// document the shell replays on every attach.
///
/// The three durable ones are retained latest-wins so a non-subscriber
/// `MessageChannelGet` always returns the current document. The bindings
/// channel is ephemeral because the document is rebuilt from the configuration
/// at every boot — a durable copy could only preserve a stale document that the
/// next boot overwrites.
assembly SurfaceDescription(slug: String) {
  channel help at f"brenn:surface.surface.{slug}.help" {
    description = f"Surface help: {slug}";
    push_depth = 1;
    retain_depth = 1;
    standing_retain_depth = 1;
  }
  channel geometry at f"brenn:surface.surface.{slug}.geometry" {
    description = f"Surface geometry: {slug}";
    push_depth = 1;
    retain_depth = 1;
    standing_retain_depth = 1;
  }
  channel status at f"brenn:surface.surface.{slug}.status" {
    description = f"Surface status: {slug}";
    push_depth = 1;
    retain_depth = 1;
    standing_retain_depth = 1;
  }
  channel bindings at f"ephemeral:surface.surface.{slug}.bindings" {
    description = f"Surface bindings document: {slug}";
    push_depth = 1;
    retain_depth = 1;
  }

}

/// The help and schema documents one component kind carries, both retained
/// latest-wins for the same reason a surface's are.
assembly KindDescription(kind: String) {
  channel help at f"brenn:surface.kind.{kind}.help" {
    description = f"Kind help: {kind}";
    push_depth = 1;
    retain_depth = 1;
    standing_retain_depth = 1;
  }
  channel schema at f"brenn:surface.kind.{kind}.schema" {
    description = f"Kind schema: {kind}";
    push_depth = 1;
    retain_depth = 1;
    standing_retain_depth = 1;
  }

}
