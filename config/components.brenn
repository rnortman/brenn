// Authoring conventions for the modules in this directory:
//
// - A root document is the deployment manifest: settings sections, `uuid_pins`,
//   deployment-specific channels, and the `new` statements that say what runs.
//   Definitions live in modules here.
// - One module per subsystem, not per syntax kind.
// - An assembly earns its place at the second stamping within one document; a
//   single stamping stays longhand.
// - A shape lives here only if it is identical for every root that imports it.
//   A component class unifies as the superset: ports are declarations, bindings
//   are per-instance, and an unbound port is legal. Depths and grants that
//   differ between documents stay in the documents.
// - The rationale for a shape is written once, on the declaration that defines
//   it, and never repeated at a stamping.
//
// The prod document in brenn-ops keeps its own copy of these conventions, and a
// change to a rule has to move both.
// TODO(dsl-idioms-canonical-doc): one canonical home for the rules above.
//
// A class name folds to its kind: `EchoStub` is `echo-stub`, `ModeClock` is
// `mode-clock`.
/// The browser-driven echo fixture: publishes what was typed, renders what
/// arrives. An instance binds whichever half its surface needs.
component EchoStub {
  abi = dom;
  in messages;
  out out;
}

/// A bar panel: renders what arrives on `messages`, wakes itself on `tick`.
component Protobar {
  abi = dom;
  in messages;
  io tick;
}

/// Headless theme driver: no layout slot, so it mounts hidden and its only
/// output is a `ThemeBody` on `theme` that chrome turns into the `data-theme`
/// flip.
component ModeClock {
  abi = dom;
  in config;
  out theme;
  io tick;
}

/// Meeting notice: shows time-to-next-meeting and escalates to a fullscreen
/// takeover. Reads the agenda snapshot, requests takeover, and both publishes
/// and reads dismiss/snooze acks so every device converges — hence `io acks`.
component Meeting {
  abi = dom;
  in agenda;
  io acks;
  out takeover;
  io tick;
}

/// The page chrome: layout, theme, takeover stack, banner, toasts, and
/// overlay-holdership reporting.
component Chrome {
  abi = dom;
  in layout;
  in theme;
  in takeover;
  in link-state;
  in surface-state;
  in toast;
  out overlay-state;
  io toast-tick;
}
