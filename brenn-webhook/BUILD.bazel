load("//bazel/policy:defs.bzl", "policy_srcs")
load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")

policy_srcs()

exports_files(["Cargo.toml"])

rust_library(
    name = "brenn-webhook",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    visibility = ["//visibility:public"],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True) + [
        "//brenn-lib",
    ],
)

# 57 tests, all pure computation over in-memory header maps and key tables —
# HMAC verification, address parsing, endpoint-table lookups. The whole binary
# finishes in 0.1s locally, so `small` (60s) is a wide margin even on a cold
# 4-vCPU runner.
rust_test(
    name = "brenn-webhook_test",
    size = "small",
    crate = ":brenn-webhook",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True) + [
        "//brenn-lib",
    ],
)

rust_doc_test(
    name = "brenn-webhook_doc_test",
    crate = ":brenn-webhook",
)
