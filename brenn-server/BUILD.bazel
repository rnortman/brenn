load("//bazel/policy:defs.bzl", "policy_srcs")
load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")

policy_srcs()

exports_files(["Cargo.toml"])

rust_library(
    name = "brenn-server",
    srcs = glob(["src/**/*.rs"]),
    # Static assets the crate bakes in with include_str!/include_bytes!.
    compile_data = glob(["src/**/*.ico"]) + ["//frontend:embedded_assets"],
    edition = "2024",
    visibility = ["//visibility:public"],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True) + [
        "//attach/proto",
        "//brenn-budget",
        "//brenn-cc",
        "//brenn-common",
        "//brenn-envelope",
        "//brenn-graf",
        "//brenn-lib",
        "//brenn-pfin",
        "//brenn-wasm",
        "//surface/contract",
        "//surface/schema",
    ],
)

# Tests reach guest components as `<manifest dir>/../brenn-wasm/target/
# components/`, so the workspace-relative `CARGO_MANIFEST_DIR` plus the staged
# fixtures put them where the `env!` call sites already look.
# `large` (900s), not the `medium` default (300s): this binary runs ~2,500
# tests, which fits comfortably in 300s on a dev machine and does not on a cold
# 4-vCPU CI runner sharing itself with the rest of the graph. The size is also
# what Bazel schedules the action's local resources against, so the repo's
# biggest test binary declaring itself large is the truthful answer twice over.
#
# `data` is the ten components this crate's tests actually open, one fixture
# target each — not the whole set. Runfiles are inputs to the test action, so
# every component named here is an edge from a guest crate to all ~2,500 tests;
# the six that are not named cost nothing when they change.
#
# TODO(bazel-fixture-list-guard): which ten those are was derived by reading
# this crate's artifact-stem call sites, and nothing holds the list to them. A
# component dropped from the tests keeps its edge here silently; one added
# without its fixture fails loudly on a missing runfile.
#
# TODO(bazel-server-test-split): those ten still couple every component edit to
# the whole binary, because 99 fixture-reading tests share this target with
# ~2,460 that read none. Splitting them out by libtest filter would cut that to
# the 99 — at the price of a second compile of one of the tree's biggest crates
# on every source edit. Which way that trades is a measurement nobody has taken
# yet; take it before splitting.
rust_test(
    name = "brenn-server_test",
    size = "large",
    crate = ":brenn-server",
    data = [
        "//brenn-wasm:fixture_git_forge_parser",
        "//brenn-wasm:fixture_git_sync_consumer",
        "//brenn-wasm:fixture_processor_demo",
        "//brenn-wasm:fixture_processor_dual",
        "//brenn-wasm:fixture_processor_multiport",
        "//brenn-wasm:fixture_processor_store_rt",
        "//brenn-wasm:fixture_processor_tool_test",
        "//brenn-wasm:fixture_replay",
        "//brenn-wasm:fixture_replay_fault_test",
        "//brenn-wasm:fixture_replay_generic",
    ],
    edition = "2024",
    # The repo-sync fetch-classification tests read a bogus remote's ssh
    # failure. Without this, ssh rejects the host's own `/etc/ssh` config
    # inside the sandbox and never reaches name resolution, so the failure
    # classifies as a conflict instead of a transient error.
    env = {"GIT_SSH_COMMAND": "ssh -F /dev/null"},
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
    rustc_env = {"CARGO_MANIFEST_DIR": "brenn-server"},
    tags = ["requires-git"],
    # ts-rs exports from tests, so this binary is also the generator behind
    # `//frontend:generated_types`. Without the override the generated types —
    # and so every bundle built from them — would inherit testonly.
    testonly = False,
    visibility = ["//frontend:__pkg__"],
    deps = all_crate_deps(normal_dev = True) + [
        "//attach/client",
        "//attach/conformance",
        "//brenn-cal",
        "//git-fixture",
    ],
)

# Its own suite because `//surface:dist` is downstream of every surface crate,
# the wasm-bindgen CLI and the transpiler. On the unit-test target above, a
# surface edit would rerun that target's ~2,500 tests; here it reruns one.
rust_test(
    name = "surface_manifest_parity",
    srcs = ["tests/surface_manifest_parity.rs"],
    crate_root = "tests/surface_manifest_parity.rs",
    data = ["//surface:dist"],
    edition = "2024",
    rustc_env = {"CARGO_MANIFEST_DIR": "brenn-server"},
    deps = [
        "//brenn-wasm",
        "@crates//serde_json",
    ],
)

rust_doc_test(
    name = "brenn-server_doc_test",
    crate = ":brenn-server",
)
