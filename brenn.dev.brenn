// ── component classes ────────────────────────────────────────────────────────
//
// The class name folds to the kind: `EchoStub` is `echo-stub`, `ModeClock` is
// `mode-clock`.
/// The browser-driven echo fixture: publishes what was typed, renders what
/// arrives. An instance binds whichever half its surface needs.
component EchoStub {
  abi = dom;
  in messages;
  out out;
}

/// A bar panel: renders what arrives on `messages`, wakes itself on `tick`.
component Protobar {
  abi = dom;
  in messages;
  io tick;
}

/// Headless theme driver: no layout slot, so it mounts hidden and its only
/// output is a `ThemeBody` on `theme` that chrome turns into the `data-theme`
/// flip.
component ModeClock {
  abi = dom;
  in config;
  out theme;
  io tick;
}

/// Meeting notice: shows time-to-next-meeting and escalates to a fullscreen
/// takeover. Reads the agenda snapshot, requests takeover, and both publishes
/// and reads dismiss/snooze acks so every device converges — hence `io acks`.
component Meeting {
  abi = dom;
  in agenda;
  io acks;
  out takeover;
  io tick;
}

/// The page chrome: layout, theme, takeover stack, banner, toasts, and
/// overlay-holdership reporting.
component Chrome {
  abi = dom;
  in layout;
  in theme;
  in takeover;
  in link-state;
  in surface-state;
  in toast;
  out overlay-state;
  io toast-tick;
}

// ── assemblies ───────────────────────────────────────────────────────────────
/// The four self-description channels one surface carries: help, geometry,
/// status, and bindings. The bindings channel is ephemeral because the document
/// is rebuilt from this file at every boot.
assembly SurfaceDescription(slug: String) {
  channel help at f"brenn:surface.surface.{slug}.help" {
    description = f"Surface help: {slug}";
    push_depth = 1;
    retain_depth = 1;
    standing_retain_depth = 1;
  }
  channel geometry at f"brenn:surface.surface.{slug}.geometry" {
    description = f"Surface geometry: {slug}";
    push_depth = 1;
    retain_depth = 1;
    standing_retain_depth = 1;
  }
  channel status at f"brenn:surface.surface.{slug}.status" {
    description = f"Surface status: {slug}";
    push_depth = 1;
    retain_depth = 1;
    standing_retain_depth = 1;
  }
  channel bindings at f"ephemeral:surface.surface.{slug}.bindings" {
    description = f"Surface bindings document: {slug}";
    push_depth = 1;
    retain_depth = 1;
  }

}

/// The help and schema documents one component kind carries, both retained
/// latest-wins.
assembly KindDescription(kind: String) {
  channel help at f"brenn:surface.kind.{kind}.help" {
    description = f"Kind help: {kind}";
    push_depth = 1;
    retain_depth = 1;
    standing_retain_depth = 1;
  }
  channel schema at f"brenn:surface.kind.{kind}.schema" {
    description = f"Kind schema: {kind}";
    push_depth = 1;
    retain_depth = 1;
    standing_retain_depth = 1;
  }

}

// ── channels ─────────────────────────────────────────────────────────────────
// Errors are facts, not signals: a report that scrolls out of the window before
// anyone reads it is the outage the channel exists to describe. The window is
// sized for a burst of reports, and push_depth = 1 because whoever is watching
// is woken once and then reads the window.
channel surface_errors at "brenn:surface-errors" {
  description = "Surface client error reports (trusted republish)";
  push_depth = 1;
  retain_depth = 100;
  standing_retain_depth = 100;
}

// The root of the boot-published self-description topology: an app starts here
// and follows addresses.
channel surface_index at "brenn:surface.index" {
  description = "Surface topology index (system-published, latest-wins)";
  push_depth = 1;
  retain_depth = 1;
  standing_retain_depth = 1;
}

// Latest-wins layout documents for the bar surfaces.
channel bar_layout at "brenn:bar-layout" {
  description = "Bar layout documents (latest-wins)";
  push_depth = 8;
  retain_depth = 1;
  standing_retain_depth = 8;
}

// Bar content channels: one per panel instance.
channel bar_a at "brenn:bar-a" {
  description = "Bar panel content channel (slot a / instance p1)";
  push_depth = 8;
  retain_depth = 1;
  standing_retain_depth = 8;
}
channel bar_b at "brenn:bar-b" {
  description = "Bar panel content channel (slot b / instance p2)";
  push_depth = 8;
  retain_depth = 1;
  standing_retain_depth = 8;
}
channel bar_c at "brenn:bar-c" {
  description = "Bar panel content channel (slot c / instance p3)";
  push_depth = 8;
  retain_depth = 1;
  standing_retain_depth = 8;
}

// Retained mode-clock config. Only `bar` subscribes — `bar-pixel` is
// dark-only, so a mode-clock there would be a no-op.
channel bar_mode at "brenn:bar-mode" {
  description = "Bar mode-clock config (retained, latest-wins)";
  push_depth = 8;
  retain_depth = 1;
  standing_retain_depth = 8;
}

// Retained meeting agenda snapshot (latest-wins). Both bar surfaces subscribe.
channel bar_agenda at "brenn:bar-agenda" {
  description = "Bar meeting agenda snapshot (retained, latest-wins)";
  push_depth = 8;
  retain_depth = 1;
  standing_retain_depth = 8;
}

// Dismiss/snooze acks: each device publishes and subscribes so every device
// converges.
channel bar_acks at "brenn:bar-acks" {
  description = "Bar meeting dismiss/snooze acks (retained)";
  push_depth = 8;
  retain_depth = 8;
  standing_retain_depth = 8;
}

// Ephemeral echo-loop fixture channel. `retain_depth = 8` covers the depth-8
// surface binding below: on a non-durable channel the retained window *is* the
// standing buffer, and no binding depth may exceed it.
channel dev_stub at "ephemeral:dev-stub" {
  push_depth = 1;
  retain_depth = 8;
}
new dev_stub_desc: SurfaceDescription(slug = "dev-stub");
new bar_desc: SurfaceDescription(slug = "bar");
new bar_pixel_desc: SurfaceDescription(slug = "bar-pixel");
new bar_feeder_desc: SurfaceDescription(slug = "bar-feeder");

new echo_stub_desc: KindDescription(kind = "echo-stub");
new protobar_desc: KindDescription(kind = "protobar");
new mode_clock_desc: KindDescription(kind = "mode-clock");
new meeting_desc: KindDescription(kind = "meeting");
new chrome_desc: KindDescription(kind = "chrome");

// ── the apps ─────────────────────────────────────────────────────────────────
/// Development sandbox and the LLM write path into the bar surfaces.
agent Development {
  name = "Development";
  description = "Brenn development sandbox";
  icon = "🔧";
  working_dir = ".";
  grants = [publish];
  acl publish [exact bar_layout, exact bar_a, exact bar_b, exact bar_c];
}

new dev: Development;

/// The singleton personal assistant, with the knowledge base wired in both as
/// an integration and as an MCP server.
agent PersonalAssistant {
  name = "Personal Assistant";
  description = "Your personal assistant";
  icon = "🤖";
  working_dir = ".";
  singleton = true;
  compact_reminder_pct = 60;
  compact_soft_pct = 75;
  compact_red_pct = 80;
  compact_hard_pct = 95;
  integrations = ["graf"];
  mcp_server graf {
    command = "graf";
    args = ["mcp"];
  }
}

new assistant: PersonalAssistant;

/// Personal finance, with the file-drop import path: dropping an OFX/QFX/CSV
/// export on a conversation runs the importer over it and hands the agent the
/// follow-up instructions.
agent Pfin {
  name = "Personal Finance";
  description = "Transaction import, categorization, and reconciliation";
  icon = "💰";
  working_dir = ".";
  integrations = ["pfin"];
  attachment_target import {
    label = "Import bank export";
    accept = [".ofx", ".qfx", ".csv"];
    multi = true;
    handler {
      type = command;
      program = "pf";
      args = ["--json", "import", "{ofx}", "--csv", "{csv}"];
      timeout_secs = 60;
      cc_instructions = "After a successful import, offer to review pending transactions using the `pending` tool.\nIf the import failed due to unmapped accounts, use the map_account tool to create the mapping, then ask the user to retry the import.";
      file_roles = { ofx = [".ofx", ".qfx"], csv = [".csv"] };
    }
  }
}

new pfin: Pfin;

// ── the surfaces ─────────────────────────────────────────────────────────────
// Echo-loop fixture. `alert` grant required because `noise = alarm` below
// demands the alert plane (boot-checked).
surface dev-stub {
  grants = [subscribe, publish, alert];
  acl subscribe [exact dev_stub];
  acl publish [exact dev_stub]

  ;
  new echo-stub: EchoStub {
    in messages <- dev_stub { push_depth = 8; noise = alarm; }
    out out -> dev_stub;
  }

  // Latest-wins ports take `push_depth = 1`; `toast` is a stream, so it
  // keeps burst depth. `toast-tick` is an anonymous page-local ring.
  new chrome: Chrome {
    chrome = true;
    in theme <- "local:brenn/theme" { push_depth = 1; }
    in link-state <- "local:brenn/link-state" { push_depth = 1; }
    in surface-state <- "local:brenn/surface-state" { push_depth = 1; }
    in toast <- "local:brenn/toast" { push_depth = 8; }
    io toast-tick { push_depth = 1; retain_depth = 2; }

  }

}

// Three-panel bar. Skin `bench` (1a Bench Instrument).
surface bar {
  grants = [subscribe, publish, takeover];
  skin = "bench";
  acl subscribe [exact bar_a,
    exact bar_b,
    exact bar_c,
    exact bar_layout,
    exact bar_mode,
    exact bar_agenda,
    exact bar_acks];
  acl publish [exact bar_acks]

  ;
  new p1: Protobar {
    in messages <- bar_a;
    io tick { push_depth = 1; retain_depth = 2; }

  }
  new p2: Protobar {
    in messages <- bar_b;
    io tick { push_depth = 1; retain_depth = 2; }

  }
  new p3: Protobar {
    in messages <- bar_c;
    io tick { push_depth = 1; retain_depth = 2; }

  }

  // `config` is latest-wins, so `push_depth = 1`.
  new mode: ModeClock {
    in config <- bar_mode { push_depth = 1; }
    out theme -> "local:brenn/theme";
    io tick { push_depth = 1; retain_depth = 2; }

  }

  // `agenda` is latest-wins; `acks` accumulates, so it inherits the rung.
  new meeting: Meeting {
    in agenda <- bar_agenda { push_depth = 1; }
    io acks <-> bar_acks;
    out takeover -> "local:brenn/takeover";
    io tick { push_depth = 1; retain_depth = 2; }

  }
  new chrome: Chrome {
    chrome = true;
    in layout <- bar_layout { push_depth = 1; }
    in theme <- "local:brenn/theme" { push_depth = 1; }
    in takeover <- "local:brenn/takeover" { push_depth = 8; }
    in link-state <- "local:brenn/link-state" { push_depth = 1; }
    in surface-state <- "local:brenn/surface-state" { push_depth = 1; }
    in toast <- "local:brenn/toast" { push_depth = 8; }
    out overlay-state -> "local:brenn/overlay-state";
    io toast-tick { push_depth = 1; retain_depth = 2; }

  }

}

// Same channels as `bar`, different skin. Foundry is dark-only, so no
// mode-clock.
surface bar-pixel {
  grants = [subscribe, publish, takeover];
  skin = "foundry";
  acl subscribe [exact bar_a,
    exact bar_b,
    exact bar_c,
    exact bar_layout,
    exact bar_agenda,
    exact bar_acks];
  acl publish [exact bar_acks]

  ;
  new p1: Protobar {
    in messages <- bar_a;
    io tick { push_depth = 1; retain_depth = 2; }

  }
  new p2: Protobar {
    in messages <- bar_b;
    io tick { push_depth = 1; retain_depth = 2; }

  }
  new p3: Protobar {
    in messages <- bar_c;
    io tick { push_depth = 1; retain_depth = 2; }

  }
  new meeting: Meeting {
    in agenda <- bar_agenda { push_depth = 1; }
    io acks <-> bar_acks;
    out takeover -> "local:brenn/takeover";
    io tick { push_depth = 1; retain_depth = 2; }

  }
  new chrome: Chrome {
    chrome = true;
    in layout <- bar_layout { push_depth = 1; }
    in theme <- "local:brenn/theme" { push_depth = 1; }
    in takeover <- "local:brenn/takeover" { push_depth = 8; }
    in link-state <- "local:brenn/link-state" { push_depth = 1; }
    in surface-state <- "local:brenn/surface-state" { push_depth = 1; }
    in toast <- "local:brenn/toast" { push_depth = 8; }
    out overlay-state -> "local:brenn/overlay-state";
    io toast-tick { push_depth = 1; retain_depth = 2; }

  }

}

// Browser-driven publisher for the bar: one echo-stub per bar channel, driving
// the bar end-to-end with no LLM in the path.
//
// No `allowed_users` — fine for single-user dev. A multi-user config copying
// this block should add `allowed_users`.
surface bar-feeder {
  grants = [publish];
  acl publish [exact bar_a,
    exact bar_b,
    exact bar_c,
    exact bar_layout,
    exact bar_mode,
    exact bar_agenda,
    exact bar_acks]

  ;
  new feed-a: EchoStub {
    out out -> bar_a;
  }
  new feed-b: EchoStub {
    out out -> bar_b;
  }
  new feed-c: EchoStub {
    out out -> bar_c;
  }
  new feed-layout: EchoStub {
    out out -> bar_layout;
  }
  new feed-mode: EchoStub {
    out out -> bar_mode;
  }
  new feed-agenda: EchoStub {
    out out -> bar_agenda;
  }
  new feed-acks: EchoStub {
    out out -> bar_acks;
  }
  new chrome: Chrome {
    chrome = true;
    in theme <- "local:brenn/theme" { push_depth = 1; }
    in link-state <- "local:brenn/link-state" { push_depth = 1; }
    in surface-state <- "local:brenn/surface-state" { push_depth = 1; }
    in toast <- "local:brenn/toast" { push_depth = 8; }
    io toast-tick { push_depth = 1; retain_depth = 2; }

  }

}
