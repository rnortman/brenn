  "brenn:surface.kind.echo-stub.schema" = "4d56962a-ae1b-4bc4-9636-e0c83d5da770";
  "brenn:surface.kind.protobar.help" = "8efaf001-7f73-4c84-bd0a-d205e88044ab";
