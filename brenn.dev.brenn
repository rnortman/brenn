// TODO(dsl-config-shared-module): the component classes, both assemblies, the
// bar channels and the bar surfaces below are duplicated verbatim in
// brenn.e2e.brenn; a change to one wants the same change to the other. The
// shared module that would end that is designed with the prod port.
// TODO(dsl-acl-derivation): the explicit acl statements below restate authority
// the bindings could derive; they are kept longhand so the lowered config
// compares element-for-element against the TOML twin. Rewrite them
// derivation-based once that twin retires.
/// Where the server listens and what it believes about the proxy in front.
server {
  bind_address = "127.0.0.1:3000";
  static_dir = ".bazel-bin/frontend/dist";
  surface_dist_dir = ".bazel-bin/surface/dist";
  secure_cookies = false;
  public_url = "http://127.0.0.1:3000";
}

database {
  path = "brenn.db";
}

logging {
  log_dir = "logs";
  console_level = debug;
  file_level = debug;
}

claude_defaults {
  mcp_script_path = "noop_mcp.py";
  model = "sonnet";
}

integration graf {
  command = "graf";
}

integration pfin {
  command = "pf";
}

/// Channel for surface error reports. The dev instance has no alerter.
observability {
  surface_error_channel = "brenn:surface-errors";
}

/// Self-description channel prefix and heartbeat cadence for surfaces.
surface_description {
  prefix = "surface";
  status_interval_secs = 60;
}

// Every durable uuid is carried rather than derived: these were hand-minted v4,
// so no derivation reproduces them. An unused pin is a compile error, which
// keeps this block honest against the declarations.
uuid_pins {
  "brenn:surface-errors" = "0da727fd-d0f7-414e-98e3-f1fef2ae70ca";
  "brenn:surface.index" = "59ec3b6b-7a9d-4ede-b692-638ed3834963";
