  "brenn:surface.kind.echo-stub.schema" = "4d56962a-ae1b-4bc4-9636-e0c83d5da770";
  "brenn:surface.kind.protobar.help" = "8efaf001-7f73-4c84-bd0a-d205e88044ab";
  "brenn:surface.kind.protobar.schema" = "e51fb93c-744d-4c9b-8737-c6541a621761";
  "brenn:surface.kind.mode-clock.help" = "a6d0f882-4c8f-4d5f-91d5-a4ca6fc5f8e5";
