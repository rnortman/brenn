  "brenn:bar-agenda" = "2c349f30-5172-4dc9-a6ae-49b2c70ab30c";
  "brenn:bar-acks" = "2ab4b43f-5adc-4d73-9bd5-c674c70195cf";
  "brenn:surface.surface.dev-stub.help" = "2f36ae2a-fe98-4a89-8299-7c086b94ddec";
  "brenn:surface.surface.dev-stub.geometry" = "c89c02ac-8c6b-40f4-ab75-799b7050cadc";
  "brenn:surface.surface.dev-stub.status" = "3ea19b6b-1946-44de-a3a4-a9526f804773";
