"""The deploy tarball's staged tree.

Which binaries, which asset trees, and which packages ship is decided here,
under gates. `VERSION` and `deploy.sh` are deliberately absent — the consumer
adds them before archiving.

Build with `--config=release-package` (or `make bazel-release`): release
semantics plus the musl transition on the binaries.
"""

load("@bazel_skylib//rules:native_binary.bzl", "native_test")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("//bazel/platforms:defs.bzl", "HOST_ONLY")
load("//bazel/policy:defs.bzl", "policy_srcs")
load("//bazel/release:defs.bzl", "release_package")
load("//bazel/wasm:defs.bzl", "config_fit_refusal_test", "config_fit_test", "module_file_name")

policy_srcs()

# brenn's own vocabulary, shipped for a deployment to import rather than to
# copy. Listed rather than globbed: a library module is vocabulary this
# release promises, and the promise is a line someone wrote. The glob that
# *offers* the same directory is `//:modules`, and the two are held equal by
# `//bazel/release/tests:config_specs_accounted_test`, which reads the names
# below.
BRENN_LIBRARY_MODULES = [
    "//:config/specs/config-reload.brenn",
    "//:config/specs/surface-description.brenn",
]

# What this release promises, as names, for that gate.
write_file(
    name = "library_module_names",
    out = "library-module-names.txt",
    content = sorted([module_file_name(label) for label in BRENN_LIBRARY_MODULES]),
    visibility = ["//visibility:public"],
)

# The reload facility, stamped. `release_package`'s `library_module_test` per
# library module compiles the module and stamps nothing, so an assembly body is
# otherwise first resolved at a deployment's boot — and this pair's body is the
# whole of it.
config_fit_test(
    name = "config_reload_fit_test",
    config = "fit/config-reload.brenn",
    modules = ["//:config/specs/config-reload.brenn"],
)

# One process, one document, one facility: the addresses are fixed, so a second
# stamp is two channels at one address. The refusal is the compiler's own, which
# is why the facility needs no rule of its own to say the pair is unique.
config_fit_refusal_test(
    name = "config_reload_twice_refusal_test",
    config = "fit/config-reload-twice.brenn",
    expect = "two channels declare the address `brenn:config.reload`",
    modules = ["//:config/specs/config-reload.brenn"],
)

release_package(
    name = "release_package",
    binaries = [
        "//brenn",
        "//brenn-cli",
    ],
    frontend = "//frontend:dist",
    lib_files = ["//:noop_mcp.py"],
    library_modules = BRENN_LIBRARY_MODULES,
    manifest = "//brenn-wasm:deployed-components.txt",
    # Every package in the tree is offered; `deployed-components.txt` decides
    # which of them ship. Passing the deployed subset here instead would make
    # the manifest a second list to keep in step with this one, and the drift
    # would ship a component nobody listed or drop one everybody expects. An
    # entry whose package is missing fails assembly. The module root under
    # `modules/` is derived from the shipped ones — a package carries its
    # authored specification — so there is no second list of the same files.
    packages = ["//brenn-wasm:packages"],
    surface = "//surface:dist",
    visibility = ["//visibility:public"],
)

# The two served trees, again, against the same lists their own `dist_paths`
# tests use. `//frontend:dist_paths` says the tree is right; this says the
# tarball carries all of it. A `root_paths` mistake or a truncated copy sits
# between the two and shows up on neither without this.
[
    native_test(
        name = "release_package_" + tree + "_paths",
        size = "small",
        src = "//bazel/dist:path_set_check.sh",
        args = [
            "$(rootpath :release_package)/" + tree,
            "$(rootpath %s)" % expected,
            "release_package/" + tree,
        ],
        data = [
            expected,
            ":release_package",
        ],
        out = "release_package_{}_paths.run".format(tree),
        target_compatible_with = HOST_ONLY,
    )
    for tree, expected in [
        ("frontend", "//frontend:dist-paths.txt"),
        ("surface", "//surface:dist-paths.txt"),
    ]
]
